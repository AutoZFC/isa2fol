# ⚠ §3a, SUPERSEDED. T1-T4 are what FOUNDATION §3's widening law REPLACES.
# This is kept as the record of the position-indexed construction, NOT as a
# template. Do not build on it; see §3a's own warning.
# Tier 3 -- the Tuple Lemma T1-T4, and the T4-route discrepancy resolved.
# Tuples are left-nested: (u,v,w) := <<u,v>,w>.  Membership abbreviations:
#   pmem(u,v,X) := exists p. (kpair(u,v,p) & p in X)          -- <u,v> in X
#   tmem(u,v,w,X) := exists p. (kpair(u,v,p) & pmem(p,w,X))   -- <<u,v>,w> in X
axiom members_are_sets: forall x. forall y. (elem(x,y) -> set(x))
axiom elem_first_subst: forall x. forall y. forall s. (eq(x,y) -> (elem(x,s) -> elem(y,s)))
axiom extensionality: forall A. forall B. (eq(A,B) <-> (forall u. (elem(u,A) <-> elem(u,B))))
axiom pairing: forall a. forall b. (set(a) -> (set(b) -> (exists z. (set(z) & (forall u. (elem(u,z) <-> (eq(u,a) | eq(u,b))))))))
axiom empty: exists e. set(e)

@def(upair) axiom upair_def: forall x. forall y. forall w. (upair(x,y,w) <-> (forall u. (elem(u,w) <-> (eq(u,x) | eq(u,y)))))
@def(kpair) axiom kpair_def: forall x. forall y. forall p. (kpair(x,y,p) <-> (exists a. (exists b. (upair(x,x,a) & (upair(x,y,b) & upair(a,b,p))))))
@def(pmem)  axiom pmem_def: forall u. forall v. forall X. (pmem(u,v,X) <-> (exists p. (kpair(u,v,p) & elem(p,X))))
@def(tmem)  axiom tmem_def: forall u. forall v. forall w. forall X. (tmem(u,v,w,X) <-> (exists p. (kpair(u,v,p) & pmem(p,w,X))))

# Godel closers B4, B5, B6, B7 -- FOUNDATION §1 axioms 7, 8, 9, 10, guarded per S6.
axiom B4: forall A. (exists C. (forall u. (set(u) -> (elem(u,C) <-> (exists v. (set(v) & pmem(u,v,A)))))))
axiom B5: forall A. (exists C. (forall u. (forall v. (set(u) -> (set(v) -> (pmem(u,v,C) <-> elem(u,A)))))))
axiom B6: forall A. (exists C. (forall u. (forall v. (forall w. (set(u) -> (set(v) -> (set(w) -> (tmem(u,v,w,C) <-> tmem(v,w,u,A)))))))))
axiom B7: forall A. (exists C. (forall u. (forall v. (forall w. (set(u) -> (set(v) -> (set(w) -> (tmem(u,v,w,C) <-> tmem(u,w,v,A)))))))))

# Tier 1 / tier 2 prerequisites (proved in pair_flattening.fol.proof; reproved here so the probe stands alone).
claim eq_refl:  forall A. eq(A,A)
claim set_cong: forall A. forall B. (eq(A,B) -> (set(A) -> set(B)))
claim upair_ex:   forall x. forall y. (set(x) -> (set(y) -> (exists w. (set(w) & upair(x,y,w)))))
claim upair_uniq: forall x. forall y. forall w. forall w2. (upair(x,y,w) -> (upair(x,y,w2) -> eq(w,w2)))
claim upair_set:  forall x. forall y. forall w. (set(x) -> (set(y) -> (upair(x,y,w) -> set(w))))
claim pair_set:   forall x. forall y. forall p. (set(x) -> (set(y) -> (kpair(x,y,p) -> set(p))))

# The Tuple Lemma.
claim T3: forall A. (exists C. (forall x. (forall y. (forall z. (set(x) -> (set(y) -> (set(z) -> (tmem(x,y,z,C) <-> pmem(x,y,A)))))))))
claim T2: forall A. (exists C. (forall x. (forall y. (forall z. (set(x) -> (set(y) -> (set(z) -> (tmem(x,z,y,C) <-> pmem(x,y,A)))))))))
claim T1: forall A. (exists C. (forall x. (forall y. (forall z. (set(x) -> (set(y) -> (set(z) -> (tmem(z,x,y,C) <-> pmem(x,y,A)))))))))

# The swapped triple class -- SAME STATEMENT, two routes.
claim swap_triple_short: forall A. (exists D. (forall u. (forall v. (forall w. (set(u) -> (set(v) -> (set(w) -> (tmem(u,v,w,D) <-> pmem(v,u,A)))))))))
claim swap_triple_long:  forall A. (exists D. (forall u. (forall v. (forall w. (set(u) -> (set(v) -> (set(w) -> (tmem(u,v,w,D) <-> pmem(v,u,A)))))))))

claim T4: forall A. (exists C. (forall x. (forall y. (set(x) -> (set(y) -> (pmem(y,x,C) <-> pmem(x,y,A)))))))
