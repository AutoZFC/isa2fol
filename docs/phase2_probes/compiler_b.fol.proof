    _tu = use T3
    _apu = use exp_append3
    fix A
    _tA = forall_elim _tu, A
    _eC1 = exists_elim _tA, C1
    _apC = forall_elim _apu, C1
    _eQ = exists_elim _apC, Q
    fix x1
    fix x2
    fix x3
    fix x4
    _s1 = assume set(x1)
    _s2 = assume set(x2)
    _s3 = assume set(x3)
    _s4 = assume set(x4)
    _a1 = forall_elim _eQ, x1
    _a2 = forall_elim _a1, x2
    _a3 = forall_elim _a2, x3
    _a4 = forall_elim _a3, x4
    _a5 = implies_elim _a4, _s1
    _a6 = implies_elim _a5, _s2
    _a7 = implies_elim _a6, _s3
    _a8 = implies_elim _a7, _s4
    _b1 = forall_elim _eC1, x1
    _b2 = forall_elim _b1, x2
    _b3 = forall_elim _b2, x3
    _b4 = implies_elim _b3, _s1
    _b5 = implies_elim _b4, _s2
    _b6 = implies_elim _b5, _s3
    _f = assume qmem(x1,x2,x3,x4,Q)
    _m = iff_elim_l _a8, _f
    _n = iff_elim_l _b6, _m
    _fwd = implies_intro _n
    _g = assume pmem(x1,x2,A)
    _m2 = iff_elim_r _b6, _g
    _n2 = iff_elim_r _a8, _m2
    _bwd = implies_intro _n2
    _bi = iff_intro _fwd, _bwd
    _i1 = implies_intro _bi
    _i2 = implies_intro _i1
    _i3 = implies_intro _i2
    _i4 = implies_intro _i3
    _q1 = forall_intro _i4
    _q2 = forall_intro _q1
    _q3 = forall_intro _q2
    _q4 = forall_intro _q3
    _cl1 = exists_intro _q4
    _cl2 = exists_intro _cl1
    _gA = forall_intro _cl2
    qed _gA

