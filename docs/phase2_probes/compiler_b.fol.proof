proof exp_34:
    _t1u = use T1
    fix A
    _t1A = forall_elim _t1u, A
    _eB = exists_elim _t1A, B
    fix x1
    fix x2
    fix x3
    fix x4
    _s1 = assume set(x1)
    _s2 = assume set(x2)
    _s3 = assume set(x3)
    _s4 = assume set(x4)
    fix z
    _sz = assume set(z)
    _kz = assume kpair(x1,x2,z)
    _a1 = forall_elim _eB, x3
    _a2 = forall_elim _a1, x4
    _a3 = forall_elim _a2, z
    _a4 = implies_elim _a3, _s3
    _a5 = implies_elim _a4, _s4
    _a6 = implies_elim _a5, _sz
    _h1 = implies_intro _a6
    _h2 = implies_intro _h1
    _hyp = forall_intro _h2
    _fs = schema_inst flatten_slot1 { Phi: pmem(x3,x4,A) }
    _f1 = forall_elim _fs, x1
    _f2 = forall_elim _f1, x2
    _f3 = forall_elim _f2, x3
    _f4 = forall_elim _f3, x4
    _f5 = forall_elim _f4, B
    _f6 = implies_elim _f5, _s1
    _f7 = implies_elim _f6, _s2
    _res = implies_elim _f7, _hyp
    _i1 = implies_intro _res
    _i2 = implies_intro _i1
    _i3 = implies_intro _i2
    _i4 = implies_intro _i3
    _q1 = forall_intro _i4
    _q2 = forall_intro _q1
    _q3 = forall_intro _q2
    _q4 = forall_intro _q3
    _clB = exists_intro _q4
    _gA = forall_intro _clB
    qed _gA
proof eq_symm:
    _e = use extensionality
    fix A
    fix B
    _h = assume eq(A,B)
    _e1 = forall_elim _e, A
    _e2 = forall_elim _e1, B
    _ab = iff_elim_l _e2, _h
    fix u
    _abu = forall_elim _ab, u
    _p = assume elem(u,B)
    _q = iff_elim_r _abu, _p
    _f1 = implies_intro _q
    _p2 = assume elem(u,A)
    _q2 = iff_elim_l _abu, _p2
    _f2 = implies_intro _q2
    _bi = iff_intro _f1, _f2
    _gu = forall_intro _bi
    _e3 = forall_elim _e, B
    _e4 = forall_elim _e3, A
    _ba = iff_elim_r _e4, _gu
    _i = implies_intro _ba
    _gB = forall_intro _i
    _gA = forall_intro _gB
    qed _gA

proof eq_trans:
    _e = use extensionality
    fix A
    fix B
    fix C
    _h1 = assume eq(A,B)
    _h2 = assume eq(B,C)
    _a1 = forall_elim _e, A
    _a2 = forall_elim _a1, B
    _ab = iff_elim_l _a2, _h1
    _b1 = forall_elim _e, B
    _b2 = forall_elim _b1, C
    _bc = iff_elim_l _b2, _h2
    fix u
    _abu = forall_elim _ab, u
    _bcu = forall_elim _bc, u
    _p = assume elem(u,A)
    _q = iff_elim_l _abu, _p
    _r = iff_elim_l _bcu, _q
    _f1 = implies_intro _r
    _p2 = assume elem(u,C)
    _q2 = iff_elim_r _bcu, _p2
    _r2 = iff_elim_r _abu, _q2
    _f2 = implies_intro _r2
    _bi = iff_intro _f1, _f2
    _gu = forall_intro _bi
    _c1 = forall_elim _e, A
    _c2 = forall_elim _c1, C
    _ac = iff_elim_r _c2, _gu
    _i1 = implies_intro _ac
    _i2 = implies_intro _i1
    _gC = forall_intro _i2
    _gB = forall_intro _gC
    _gA = forall_intro _gB
    qed _gA

proof upair_cong:
    _ud = use upair_def
    _e = use extensionality
    _sy = use eq_symm
    _tr = use eq_trans
    fix a
    fix b
    fix a2
    fix b2
    fix p
    fix q
    _hp = assume upair(a,b,p)
    _hq = assume upair(a2,b2,q)
    _ha = assume eq(a,a2)
    _hb = assume eq(b,b2)
    _sa1 = forall_elim _sy, a
    _sa2 = forall_elim _sa1, a2
    _a2a = implies_elim _sa2, _ha
    _sb1 = forall_elim _sy, b
    _sb2 = forall_elim _sb1, b2
    _b2b = implies_elim _sb2, _hb
    _d1 = forall_elim _ud, a
    _d2 = forall_elim _d1, b
    _d3 = forall_elim _d2, p
    _mp = iff_elim_l _d3, _hp
    _f1 = forall_elim _ud, a2
    _f2 = forall_elim _f1, b2
    _f3 = forall_elim _f2, q
    _mq = iff_elim_l _f3, _hq
    fix z
    _mpz = forall_elim _mp, z
    _mqz = forall_elim _mq, z
    _fw = assume elem(z,p)
    _o = iff_elim_l _mpz, _fw
    _c1 = assume eq(z,a)
    _t1 = forall_elim _tr, z
    _t2 = forall_elim _t1, a
    _t3 = forall_elim _t2, a2
    _t4 = implies_elim _t3, _c1
    _za2 = implies_elim _t4, _ha
    _dd1 = let eq(z,b2)
    _or1 = or_intro_l _za2, _dd1
    _cl1 = implies_intro _or1
    _c2 = assume eq(z,b)
    _u1 = forall_elim _tr, z
    _u2 = forall_elim _u1, b
    _u3 = forall_elim _u2, b2
    _u4 = implies_elim _u3, _c2
    _zb2 = implies_elim _u4, _hb
    _dd2 = let eq(z,a2)
    _or2 = or_intro_r _dd2, _zb2
    _cl2 = implies_intro _or2
    _oq = or_elim _o, _cl1, _cl2
    _zq = iff_elim_r _mqz, _oq
    _fwd = implies_intro _zq
    _gw = assume elem(z,q)
    _o2 = iff_elim_l _mqz, _gw
    _c3 = assume eq(z,a2)
    _v1 = forall_elim _tr, z
    _v2 = forall_elim _v1, a2
    _v3 = forall_elim _v2, a
    _v4 = implies_elim _v3, _c3
    _za = implies_elim _v4, _a2a
    _dd3 = let eq(z,b)
    _or3 = or_intro_l _za, _dd3
    _cl3 = implies_intro _or3
    _c4 = assume eq(z,b2)
    _w1 = forall_elim _tr, z
    _w2 = forall_elim _w1, b2
    _w3 = forall_elim _w2, b
    _w4 = implies_elim _w3, _c4
    _zb = implies_elim _w4, _b2b
    _dd4 = let eq(z,a)
    _or4 = or_intro_r _dd4, _zb
    _cl4 = implies_intro _or4
    _op = or_elim _o2, _cl3, _cl4
    _zp = iff_elim_r _mpz, _op
    _bwd = implies_intro _zp
    _bi = iff_intro _fwd, _bwd
    _gz = forall_intro _bi
    _x1 = forall_elim _e, p
    _x2 = forall_elim _x1, q
    _pq = iff_elim_r _x2, _gz
    _i1 = implies_intro _pq
    _i2 = implies_intro _i1
    _i3 = implies_intro _i2
    _i4 = implies_intro _i3
    _g1 = forall_intro _i4
    _g2 = forall_intro _g1
    _g3 = forall_intro _g2
    _g4 = forall_intro _g3
    _g5 = forall_intro _g4
    _g6 = forall_intro _g5
    qed _g6

proof pair_uniq:
    _kd = use kpair_def
    _uq = use upair_uniq
    _uc = use upair_cong
    fix x
    fix y
    fix p
    fix q
    _h1 = assume kpair(x,y,p)
    _h2 = assume kpair(x,y,q)
    _k1 = forall_elim _kd, x
    _k2 = forall_elim _k1, y
    _k3 = forall_elim _k2, p
    _x1 = iff_elim_l _k3, _h1
    _ea = exists_elim _x1, a
    _eb = exists_elim _ea, b
    _uxa = and_elim_l _eb
    _r1 = and_elim_r _eb
    _uxyb = and_elim_l _r1
    _uabp = and_elim_r _r1
    _k4 = forall_elim _k2, q
    _x2 = iff_elim_l _k4, _h2
    _ec = exists_elim _x2, a2
    _ed = exists_elim _ec, b2
    _uxa2 = and_elim_l _ed
    _r2 = and_elim_r _ed
    _uxyb2 = and_elim_l _r2
    _ua2b2q = and_elim_r _r2
    _q1 = forall_elim _uq, x
    _q2 = forall_elim _q1, x
    _q3 = forall_elim _q2, a
    _q4 = forall_elim _q3, a2
    _q5 = implies_elim _q4, _uxa
    _eaa = implies_elim _q5, _uxa2
    _s1 = forall_elim _uq, x
    _s2 = forall_elim _s1, y
    _s3 = forall_elim _s2, b
    _s4 = forall_elim _s3, b2
    _s5 = implies_elim _s4, _uxyb
    _ebb = implies_elim _s5, _uxyb2
    _t1 = forall_elim _uc, a
    _t2 = forall_elim _t1, b
    _t3 = forall_elim _t2, a2
    _t4 = forall_elim _t3, b2
    _t5 = forall_elim _t4, p
    _t6 = forall_elim _t5, q
    _t7 = implies_elim _t6, _uabp
    _t8 = implies_elim _t7, _ua2b2q
    _t9 = implies_elim _t8, _eaa
    _pq = implies_elim _t9, _ebb
    _cl1 = exists_intro _pq
    _cl2 = exists_intro _cl1
    _cl3 = exists_intro _cl2
    _cl4 = exists_intro _cl3
    _i1 = implies_intro _cl4
    _i2 = implies_intro _i1
    _g1 = forall_intro _i2
    _g2 = forall_intro _g1
    _g3 = forall_intro _g2
    _g4 = forall_intro _g3
    qed _g4

proof step_and:
    _b2 = use B2
    _pd = use pmem_def
    _pu = use pair_uniq
    _efs = use elem_first_subst
    _ps = use pair_set
    fix A
    fix B
    _b2A = forall_elim _b2, A
    _b2B = forall_elim _b2A, B
    _eC = exists_elim _b2B, C
    fix x
    fix y
    _sx = assume set(x)
    _sy = assume set(y)
    _q1 = forall_elim _pd, x
    _q2 = forall_elim _q1, y
    _pdefC = forall_elim _q2, C
    _pdefA = forall_elim _q2, A
    _pdefB = forall_elim _q2, B
    _f = assume pmem(x,y,C)
    _fu = iff_elim_l _pdefC, _f
    _ep = exists_elim _fu, p
    _kp = and_elim_l _ep
    _pC = and_elim_r _ep
    _s1 = forall_elim _ps, x
    _s2 = forall_elim _s1, y
    _s3 = forall_elim _s2, p
    _s4 = implies_elim _s3, _sx
    _s5 = implies_elim _s4, _sy
    _sp = implies_elim _s5, _kp
    _c1 = forall_elim _eC, p
    _c2 = implies_elim _c1, _sp
    _conj = iff_elim_l _c2, _pC
    _pA = and_elim_l _conj
    _pB = and_elim_r _conj
    _ka = and_intro _kp, _pA
    _exa = exists_intro _ka, p
    _pmA = iff_elim_r _pdefA, _exa
    _kb = and_intro _kp, _pB
    _exb = exists_intro _kb, p
    _pmB = iff_elim_r _pdefB, _exb
    _res = and_intro _pmA, _pmB
    _cl = exists_intro _res
    _fwd = implies_intro _cl
    _g = assume (pmem(x,y,A) & pmem(x,y,B))
    _gA = and_elim_l _g
    _gB = and_elim_r _g
    _ua = iff_elim_l _pdefA, _gA
    _epa = exists_elim _ua, pa
    _kpa = and_elim_l _epa
    _paA = and_elim_r _epa
    _ub = iff_elim_l _pdefB, _gB
    _epb = exists_elim _ub, pb
    _kpb = and_elim_l _epb
    _pbB = and_elim_r _epb
    _u1 = forall_elim _pu, x
    _u2 = forall_elim _u1, y
    _u3 = forall_elim _u2, pb
    _u4 = forall_elim _u3, pa
    _u5 = implies_elim _u4, _kpb
    _eqba = implies_elim _u5, _kpa
    _e1 = forall_elim _efs, pb
    _e2 = forall_elim _e1, pa
    _e3 = forall_elim _e2, B
    _e4 = implies_elim _e3, _eqba
    _paB = implies_elim _e4, _pbB
    _t1 = forall_elim _ps, x
    _t2 = forall_elim _t1, y
    _t3 = forall_elim _t2, pa
    _t4 = implies_elim _t3, _sx
    _t5 = implies_elim _t4, _sy
    _spa = implies_elim _t5, _kpa
    _d1 = forall_elim _eC, pa
    _d2 = implies_elim _d1, _spa
    _cj = and_intro _paA, _paB
    _paC = iff_elim_r _d2, _cj
    _k = and_intro _kpa, _paC
    _ex = exists_intro _k, pa
    _res2 = iff_elim_r _pdefC, _ex
    _cl1 = exists_intro _res2
    _cl2 = exists_intro _cl1
    _bwd = implies_intro _cl2
    _bi = iff_intro _fwd, _bwd
    _i1 = implies_intro _bi
    _i2 = implies_intro _i1
    _g1 = forall_intro _i2
    _g2 = forall_intro _g1
    _clC = exists_intro _g2
    _gB2 = forall_intro _clC
    _gA2 = forall_intro _gB2
    qed _gA2

proof step_not:
    _b3 = use B3
    _pd = use pmem_def
    _pe = use pair_ex
    _pu = use pair_uniq
    _efs = use elem_first_subst
    _ps = use pair_set
    fix A
    _b3A = forall_elim _b3, A
    _eC = exists_elim _b3A, C
    fix x
    fix y
    _sx = assume set(x)
    _sy = assume set(y)
    _q1 = forall_elim _pd, x
    _q2 = forall_elim _q1, y
    _pdefC = forall_elim _q2, C
    _pdefA = forall_elim _q2, A
    _f = assume pmem(x,y,C)
    _fu = iff_elim_l _pdefC, _f
    _ep = exists_elim _fu, p
    _kp = and_elim_l _ep
    _pC = and_elim_r _ep
    _s1 = forall_elim _ps, x
    _s2 = forall_elim _s1, y
    _s3 = forall_elim _s2, p
    _s4 = implies_elim _s3, _sx
    _s5 = implies_elim _s4, _sy
    _sp = implies_elim _s5, _kp
    _c1 = forall_elim _eC, p
    _c2 = implies_elim _c1, _sp
    _npA = iff_elim_l _c2, _pC
    _h = assume pmem(x,y,A)
    _hu = iff_elim_l _pdefA, _h
    _eqq = exists_elim _hu, q
    _kq = and_elim_l _eqq
    _qA = and_elim_r _eqq
    _u1 = forall_elim _pu, x
    _u2 = forall_elim _u1, y
    _u3 = forall_elim _u2, q
    _u4 = forall_elim _u3, p
    _u5 = implies_elim _u4, _kq
    _eqp = implies_elim _u5, _kp
    _e1 = forall_elim _efs, q
    _e2 = forall_elim _e1, p
    _e3 = forall_elim _e2, A
    _e4 = implies_elim _e3, _eqp
    _pA = implies_elim _e4, _qA
    _bot = not_elim _npA, _pA
    _clq = exists_intro _bot
    _neg = not_intro _clq
    _cl2 = exists_intro _neg
    _fwd = implies_intro _cl2
    _g = assume (~ pmem(x,y,A))
    _p1 = forall_elim _pe, x
    _p2 = forall_elim _p1, y
    _p3 = implies_elim _p2, _sx
    _p4 = implies_elim _p3, _sy
    _er = exists_elim _p4, r
    _sr = and_elim_l _er
    _kr = and_elim_r _er
    _h2 = assume elem(r,A)
    _k2 = and_intro _kr, _h2
    _ex2 = exists_intro _k2, r
    _pmA = iff_elim_r _pdefA, _ex2
    _bot2 = not_elim _g, _pmA
    _nrA = not_intro _bot2
    _d1 = forall_elim _eC, r
    _d2 = implies_elim _d1, _sr
    _rC = iff_elim_r _d2, _nrA
    _k3 = and_intro _kr, _rC
    _ex3 = exists_intro _k3, r
    _res = iff_elim_r _pdefC, _ex3
    _cl3 = exists_intro _res
    _bwd = implies_intro _cl3
    _bi = iff_intro _fwd, _bwd
    _i1 = implies_intro _bi
    _i2 = implies_intro _i1
    _g1 = forall_intro _i2
    _g2 = forall_intro _g1
    _clC = exists_intro _g2
    _gA2 = forall_intro _clC
    qed _gA2

proof compile_psi:
    _ub1 = use B1
    _ub4 = use B4
    _ut4 = use T4
    _usn = use step_not
    _usa = use step_and
    _eE = exists_elim _ub1, E
    _t4E = forall_elim _ut4, E
    _eC1 = exists_elim _t4E, C1
    _snE = forall_elim _usn, E
    _eC2 = exists_elim _snE, C2
    _sa1 = forall_elim _usa, C1
    _sa2 = forall_elim _sa1, C2
    _eC3 = exists_elim _sa2, C3
    _b4C = forall_elim _ub4, C3
    _eC4 = exists_elim _b4C, C4
    fix x
    _sx = assume set(x)
    _m1 = forall_elim _eC4, x
    _m2 = implies_elim _m1, _sx
    fix y
    _sy = assume set(y)
    _a1 = forall_elim _eC3, x
    _a2 = forall_elim _a1, y
    _a3 = implies_elim _a2, _sx
    _a4 = implies_elim _a3, _sy
    _ba1 = forall_elim _eC1, y
    _ba2 = forall_elim _ba1, x
    _ba3 = implies_elim _ba2, _sy
    _ba4 = implies_elim _ba3, _sx
    _ca1 = forall_elim _eE, y
    _ca2 = forall_elim _ca1, x
    _ca3 = implies_elim _ca2, _sy
    _ca4 = implies_elim _ca3, _sx
    _da1 = forall_elim _eC2, x
    _da2 = forall_elim _da1, y
    _da3 = implies_elim _da2, _sx
    _da4 = implies_elim _da3, _sy
    _ea1 = forall_elim _eE, x
    _ea2 = forall_elim _ea1, y
    _ea3 = implies_elim _ea2, _sx
    _ea4 = implies_elim _ea3, _sy
    _if = assume pmem(x,y,C3)
    _i1 = iff_elim_l _a4, _if
    _i2 = and_elim_l _i1
    _i3 = and_elim_r _i1
    _i4 = iff_elim_l _ba4, _i2
    _i5 = iff_elim_l _ca4, _i4
    _i6 = iff_elim_l _da4, _i3
    _n1 = assume elem(x,y)
    _n2 = iff_elim_r _ea4, _n1
    _n3 = not_elim _i6, _n2
    _n4 = not_intro _n3
    _i7 = and_intro _i5, _n4
    _ifwd = implies_intro _i7
    _ib = assume (elem(y,x) & (~ elem(x,y)))
    _j1 = and_elim_l _ib
    _j2 = and_elim_r _ib
    _j3 = iff_elim_r _ca4, _j1
    _j4 = iff_elim_r _ba4, _j3
    _ma1 = assume pmem(x,y,E)
    _ma2 = iff_elim_l _ea4, _ma1
    _ma3 = not_elim _j2, _ma2
    _ma4 = not_intro _ma3
    _j5 = iff_elim_r _da4, _ma4
    _j6 = and_intro _j4, _j5
    _j7 = iff_elim_r _a4, _j6
    _ibwd = implies_intro _j7
    _ibi = iff_intro _ifwd, _ibwd
    _ig = implies_intro _ibi
    _inner = forall_intro _ig
    _f = assume elem(x,C4)
    _fu = iff_elim_l _m2, _f
    _ev = exists_elim _fu, v
    _svv = and_elim_l _ev
    _pv = and_elim_r _ev
    _w1 = forall_elim _inner, v
    _w2 = implies_elim _w1, _svv
    _w3 = iff_elim_l _w2, _pv
    _w4 = and_intro _svv, _w3
    _w5 = exists_intro _w4, v
    _clv = exists_intro _w5
    _fwd = implies_intro _clv
    _g = assume (exists y. (set(y) & (elem(y,x) & (~ elem(x,y)))))
    _ew = exists_elim _g, w
    _sw = and_elim_l _ew
    _bw = and_elim_r _ew
    _y1 = forall_elim _inner, w
    _y2 = implies_elim _y1, _sw
    _y3 = iff_elim_r _y2, _bw
    _y4 = and_intro _sw, _y3
    _y5 = exists_intro _y4, w
    _y6 = iff_elim_r _m2, _y5
    _clw = exists_intro _y6
    _bwd = implies_intro _clw
    _bi = iff_intro _fwd, _bwd
    _ix = implies_intro _bi
    _gx = forall_intro _ix
    _cl4 = exists_intro _gx
    _cl3 = exists_intro _cl4
    _cl2 = exists_intro _cl3
    _cl1 = exists_intro _cl2
    _clE = exists_intro _cl1
    qed _clE
