proof eq_refl:
    _e = use extensionality
    fix A
    fix u
    _a = assume elem(u,A)
    _i = implies_intro _a
    _b = iff_intro _i, _i
    _g = forall_intro _b
    _e1 = forall_elim _e, A
    _e2 = forall_elim _e1, A
    _r = iff_elim_r _e2, _g
    _ga = forall_intro _r
    qed _ga

proof set_cong:
    _pg = use pairing
    _ms = use members_are_sets
    _efs = use elem_first_subst
    _rf = use eq_refl
    fix A
    fix B
    _h = assume eq(A,B)
    _hs = assume set(A)
    _p1 = forall_elim _pg, A
    _p2 = forall_elim _p1, A
    _p3 = implies_elim _p2, _hs
    _p4 = implies_elim _p3, _hs
    _ez = exists_elim _p4, z
    _zs = and_elim_l _ez
    _zm = and_elim_r _ez
    _zmA = forall_elim _zm, A
    _rA = forall_elim _rf, A
    _d = let eq(A,A)
    _or = or_intro_l _rA, _d
    _Az = iff_elim_r _zmA, _or
    _s1 = forall_elim _efs, A
    _s2 = forall_elim _s1, B
    _s3 = forall_elim _s2, z
    _s4 = implies_elim _s3, _h
    _Bz = implies_elim _s4, _Az
    _m1 = forall_elim _ms, B
    _m2 = forall_elim _m1, z
    _sB = implies_elim _m2, _Bz
    _x = exists_intro _sB
    _i1 = implies_intro _x
    _i2 = implies_intro _i1
    _gB = forall_intro _i2
    _gA = forall_intro _gB
    qed _gA

proof upair_ex:
    _pg = use pairing
    _ud = use upair_def
    fix x
    fix y
    _sx = assume set(x)
    _sy = assume set(y)
    _p1 = forall_elim _pg, x
    _p2 = forall_elim _p1, y
    _p3 = implies_elim _p2, _sx
    _p4 = implies_elim _p3, _sy
    _ez = exists_elim _p4, w
    _ws = and_elim_l _ez
    _wm = and_elim_r _ez
    _u1 = forall_elim _ud, x
    _u2 = forall_elim _u1, y
    _u3 = forall_elim _u2, w
    _up = iff_elim_r _u3, _wm
    _k = and_intro _ws, _up
    _x1 = exists_intro _k, w
    _x2 = exists_intro _x1
    _i1 = implies_intro _x2
    _i2 = implies_intro _i1
    _gy = forall_intro _i2
    _gx = forall_intro _gy
    qed _gx

proof upair_uniq:
    _ud = use upair_def
    _e = use extensionality
    fix x
    fix y
    fix w
    fix w2
    _h1 = assume upair(x,y,w)
    _h2 = assume upair(x,y,w2)
    _d1 = forall_elim _ud, x
    _d2 = forall_elim _d1, y
    _d3 = forall_elim _d2, w
    _m1 = iff_elim_l _d3, _h1
    _d4 = forall_elim _d2, w2
    _m2 = iff_elim_l _d4, _h2
    fix u
    _m1u = forall_elim _m1, u
    _m2u = forall_elim _m2, u
    _a = assume elem(u,w)
    _b = iff_elim_l _m1u, _a
    _c = iff_elim_r _m2u, _b
    _f1 = implies_intro _c
    _a2 = assume elem(u,w2)
    _b2 = iff_elim_l _m2u, _a2
    _c2 = iff_elim_r _m1u, _b2
    _f2 = implies_intro _c2
    _bi = iff_intro _f1, _f2
    _gu = forall_intro _bi
    _e1 = forall_elim _e, w
    _e2 = forall_elim _e1, w2
    _eqw = iff_elim_r _e2, _gu
    _i1 = implies_intro _eqw
    _i2 = implies_intro _i1
    _g1 = forall_intro _i2
    _g2 = forall_intro _g1
    _g3 = forall_intro _g2
    _g4 = forall_intro _g3
    qed _g4

proof upair_set:
    _ux = use upair_ex
    _uq = use upair_uniq
    _sc = use set_cong
    fix x
    fix y
    fix w
    _hx = assume set(x)
    _hy = assume set(y)
    _hu = assume upair(x,y,w)
    _a1 = forall_elim _ux, x
    _a2 = forall_elim _a1, y
    _a3 = implies_elim _a2, _hx
    _a4 = implies_elim _a3, _hy
    _ew = exists_elim _a4, w0
    _w0s = and_elim_l _ew
    _w0u = and_elim_r _ew
    _q1 = forall_elim _uq, x
    _q2 = forall_elim _q1, y
    _q3 = forall_elim _q2, w0
    _q4 = forall_elim _q3, w
    _q5 = implies_elim _q4, _w0u
    _eqw = implies_elim _q5, _hu
    _c1 = forall_elim _sc, w0
    _c2 = forall_elim _c1, w
    _c3 = implies_elim _c2, _eqw
    _sw = implies_elim _c3, _w0s
    _x2 = exists_intro _sw
    _i1 = implies_intro _x2
    _i2 = implies_intro _i1
    _i3 = implies_intro _i2
    _g1 = forall_intro _i3
    _g2 = forall_intro _g1
    _g3 = forall_intro _g2
    qed _g3

proof pair_set:
    _kd = use kpair_def
    _us = use upair_set
    fix x
    fix y
    fix p
    _hx = assume set(x)
    _hy = assume set(y)
    _hk = assume kpair(x,y,p)
    _k1 = forall_elim _kd, x
    _k2 = forall_elim _k1, y
    _k3 = forall_elim _k2, p
    _ex = iff_elim_l _k3, _hk
    _ea = exists_elim _ex, a
    _eb = exists_elim _ea, b
    _ua = and_elim_l _eb
    _r = and_elim_r _eb
    _ub = and_elim_l _r
    _up = and_elim_r _r
    _s1 = forall_elim _us, x
    _s2 = forall_elim _s1, x
    _s3 = forall_elim _s2, a
    _s4 = implies_elim _s3, _hx
    _s5 = implies_elim _s4, _hx
    _sa = implies_elim _s5, _ua
    _t1 = forall_elim _us, x
    _t2 = forall_elim _t1, y
    _t3 = forall_elim _t2, b
    _t4 = implies_elim _t3, _hx
    _t5 = implies_elim _t4, _hy
    _sb = implies_elim _t5, _ub
    _v1 = forall_elim _us, a
    _v2 = forall_elim _v1, b
    _v3 = forall_elim _v2, p
    _v4 = implies_elim _v3, _sa
    _v5 = implies_elim _v4, _sb
    _sp = implies_elim _v5, _up
    _c1 = exists_intro _sp
    _c2 = exists_intro _c1
    _i1 = implies_intro _c2
    _i2 = implies_intro _i1
    _i3 = implies_intro _i2
    _g1 = forall_intro _i3
    _g2 = forall_intro _g1
    _g3 = forall_intro _g2
    qed _g3

proof T3:
    _b5 = use B5
    _pd = use pmem_def
    _td = use tmem_def
    _ps = use pair_set
    fix A
    _b5A = forall_elim _b5, A
    _eC = exists_elim _b5A, C
    fix x
    fix y
    fix z
    _sx = assume set(x)
    _sy = assume set(y)
    _sz = assume set(z)
    _y1 = forall_elim _td, x
    _y2 = forall_elim _y1, y
    _y3 = forall_elim _y2, z
    _tdef = forall_elim _y3, C
    _q1 = forall_elim _pd, x
    _q2 = forall_elim _q1, y
    _pdef = forall_elim _q2, A
    _f = assume tmem(x,y,z,C)
    _fu = iff_elim_l _tdef, _f
    _ep = exists_elim _fu, p
    _kp = and_elim_l _ep
    _pz = and_elim_r _ep
    _s1 = forall_elim _ps, x
    _s2 = forall_elim _s1, y
    _s3 = forall_elim _s2, p
    _s4 = implies_elim _s3, _sx
    _s5 = implies_elim _s4, _sy
    _sp = implies_elim _s5, _kp
    _c1 = forall_elim _eC, p
    _c2 = forall_elim _c1, z
    _c3 = implies_elim _c2, _sp
    _c4 = implies_elim _c3, _sz
    _pA = iff_elim_l _c4, _pz
    _k = and_intro _kp, _pA
    _ex = exists_intro _k, p
    _res = iff_elim_r _pdef, _ex
    _cl = exists_intro _res
    _fwd = implies_intro _cl
    _b = assume pmem(x,y,A)
    _bu = iff_elim_l _pdef, _b
    _eqq = exists_elim _bu, q
    _kq = and_elim_l _eqq
    _qA = and_elim_r _eqq
    _r1 = forall_elim _ps, x
    _r2 = forall_elim _r1, y
    _r3 = forall_elim _r2, q
    _r4 = implies_elim _r3, _sx
    _r5 = implies_elim _r4, _sy
    _sq = implies_elim _r5, _kq
    _d1 = forall_elim _eC, q
    _d2 = forall_elim _d1, z
    _d3 = implies_elim _d2, _sq
    _d4 = implies_elim _d3, _sz
    _qz = iff_elim_r _d4, _qA
    _k2 = and_intro _kq, _qz
    _ex2 = exists_intro _k2, q
    _res2 = iff_elim_r _tdef, _ex2
    _cl2 = exists_intro _res2
    _bwd = implies_intro _cl2
    _bi = iff_intro _fwd, _bwd
    _i1 = implies_intro _bi
    _i2 = implies_intro _i1
    _i3 = implies_intro _i2
    _g1 = forall_intro _i3
    _g2 = forall_intro _g1
    _g3 = forall_intro _g2
    _clC = exists_intro _g3
    _gA = forall_intro _clC
    qed _gA

proof T2:
    _b7 = use B7
    _t3u = use T3
    fix A
    _t3A = forall_elim _t3u, A
    _eC3 = exists_elim _t3A, C3
    _b7C = forall_elim _b7, C3
    _eC = exists_elim _b7C, C
    fix x
    fix y
    fix z
    _sx = assume set(x)
    _sy = assume set(y)
    _sz = assume set(z)
    _a1 = forall_elim _eC, x
    _a2 = forall_elim _a1, z
    _a3 = forall_elim _a2, y
    _a4 = implies_elim _a3, _sx
    _a5 = implies_elim _a4, _sz
    _a6 = implies_elim _a5, _sy
    _c1 = forall_elim _eC3, x
    _c2 = forall_elim _c1, y
    _c3 = forall_elim _c2, z
    _c4 = implies_elim _c3, _sx
    _c5 = implies_elim _c4, _sy
    _c6 = implies_elim _c5, _sz
    _f = assume tmem(x,z,y,C)
    _m = iff_elim_l _a6, _f
    _n = iff_elim_l _c6, _m
    _fwd = implies_intro _n
    _g = assume pmem(x,y,A)
    _m2 = iff_elim_r _c6, _g
    _n2 = iff_elim_r _a6, _m2
    _bwd = implies_intro _n2
    _bi = iff_intro _fwd, _bwd
    _i1 = implies_intro _bi
    _i2 = implies_intro _i1
    _i3 = implies_intro _i2
    _g1 = forall_intro _i3
    _g2 = forall_intro _g1
    _g3 = forall_intro _g2
    _cl1 = exists_intro _g3
    _cl2 = exists_intro _cl1
    _gA = forall_intro _cl2
    qed _gA

proof T1:
    _b6 = use B6
    _t3u = use T3
    fix A
    _t3A = forall_elim _t3u, A
    _eC3 = exists_elim _t3A, C3
    _b6C = forall_elim _b6, C3
    _eC = exists_elim _b6C, C
    fix x
    fix y
    fix z
    _sx = assume set(x)
    _sy = assume set(y)
    _sz = assume set(z)
    _a1 = forall_elim _eC, z
    _a2 = forall_elim _a1, x
    _a3 = forall_elim _a2, y
    _a4 = implies_elim _a3, _sz
    _a5 = implies_elim _a4, _sx
    _a6 = implies_elim _a5, _sy
    _c1 = forall_elim _eC3, x
    _c2 = forall_elim _c1, y
    _c3 = forall_elim _c2, z
    _c4 = implies_elim _c3, _sx
    _c5 = implies_elim _c4, _sy
    _c6 = implies_elim _c5, _sz
    _f = assume tmem(z,x,y,C)
    _m = iff_elim_l _a6, _f
    _n = iff_elim_l _c6, _m
    _fwd = implies_intro _n
    _g = assume pmem(x,y,A)
    _m2 = iff_elim_r _c6, _g
    _n2 = iff_elim_r _a6, _m2
    _bwd = implies_intro _n2
    _bi = iff_intro _fwd, _bwd
    _i1 = implies_intro _bi
    _i2 = implies_intro _i1
    _i3 = implies_intro _i2
    _g1 = forall_intro _i3
    _g2 = forall_intro _g1
    _g3 = forall_intro _g2
    _cl1 = exists_intro _g3
    _cl2 = exists_intro _cl1
    _gA = forall_intro _cl2
    qed _gA

proof swap_triple_short:
    _b6 = use B6
    _t2u = use T2
    fix A
    _t2A = forall_elim _t2u, A
    _eC2 = exists_elim _t2A, C2
    _b6C = forall_elim _b6, C2
    _eD = exists_elim _b6C, D
    fix u
    fix v
    fix w
    _su = assume set(u)
    _sv = assume set(v)
    _sw = assume set(w)
    _a1 = forall_elim _eD, u
    _a2 = forall_elim _a1, v
    _a3 = forall_elim _a2, w
    _a4 = implies_elim _a3, _su
    _a5 = implies_elim _a4, _sv
    _a6 = implies_elim _a5, _sw
    _c1 = forall_elim _eC2, v
    _c2 = forall_elim _c1, u
    _c3 = forall_elim _c2, w
    _c4 = implies_elim _c3, _sv
    _c5 = implies_elim _c4, _su
    _c6 = implies_elim _c5, _sw
    _f = assume tmem(u,v,w,D)
    _m = iff_elim_l _a6, _f
    _n = iff_elim_l _c6, _m
    _fwd = implies_intro _n
    _g = assume pmem(v,u,A)
    _m2 = iff_elim_r _c6, _g
    _n2 = iff_elim_r _a6, _m2
    _bwd = implies_intro _n2
    _bi = iff_intro _fwd, _bwd
    _i1 = implies_intro _bi
    _i2 = implies_intro _i1
    _i3 = implies_intro _i2
    _g1 = forall_intro _i3
    _g2 = forall_intro _g1
    _g3 = forall_intro _g2
    _cl1 = exists_intro _g3
    _cl2 = exists_intro _cl1
    _gA = forall_intro _cl2
    qed _gA

proof swap_triple_long:
    _b6 = use B6
    _b7 = use B7
    _t3u = use T3
    fix A
    _t3A = forall_elim _t3u, A
    _eC3 = exists_elim _t3A, C3
    _x1 = forall_elim _b6, C3
    _eP2 = exists_elim _x1, P2
    _x2 = forall_elim _b6, P2
    _eP3 = exists_elim _x2, P3
    _x3 = forall_elim _b7, P3
    _eP4 = exists_elim _x3, P4
    fix u
    fix v
    fix w
    _su = assume set(u)
    _sv = assume set(v)
    _sw = assume set(w)
    _p1 = forall_elim _eP4, u
    _p2 = forall_elim _p1, v
    _p3 = forall_elim _p2, w
    _p4 = implies_elim _p3, _su
    _p5 = implies_elim _p4, _sv
    _p6 = implies_elim _p5, _sw
    _q1 = forall_elim _eP3, u
    _q2 = forall_elim _q1, w
    _q3 = forall_elim _q2, v
    _q4 = implies_elim _q3, _su
    _q5 = implies_elim _q4, _sw
    _q6 = implies_elim _q5, _sv
    _r1 = forall_elim _eP2, w
    _r2 = forall_elim _r1, v
    _r3 = forall_elim _r2, u
    _r4 = implies_elim _r3, _sw
    _r5 = implies_elim _r4, _sv
    _r6 = implies_elim _r5, _su
    _s1 = forall_elim _eC3, v
    _s2 = forall_elim _s1, u
    _s3 = forall_elim _s2, w
    _s4 = implies_elim _s3, _sv
    _s5 = implies_elim _s4, _su
    _s6 = implies_elim _s5, _sw
    _f = assume tmem(u,v,w,P4)
    _m1 = iff_elim_l _p6, _f
    _m2 = iff_elim_l _q6, _m1
    _m3 = iff_elim_l _r6, _m2
    _m4 = iff_elim_l _s6, _m3
    _fwd = implies_intro _m4
    _g = assume pmem(v,u,A)
    _n1 = iff_elim_r _s6, _g
    _n2 = iff_elim_r _r6, _n1
    _n3 = iff_elim_r _q6, _n2
    _n4 = iff_elim_r _p6, _n3
    _bwd = implies_intro _n4
    _bi = iff_intro _fwd, _bwd
    _i1 = implies_intro _bi
    _i2 = implies_intro _i1
    _i3 = implies_intro _i2
    _g1 = forall_intro _i3
    _g2 = forall_intro _g1
    _g3 = forall_intro _g2
    _cl1 = exists_intro _g3
    _cl2 = exists_intro _cl1
    _cl3 = exists_intro _cl2
    _cl4 = exists_intro _cl3
    _gA = forall_intro _cl4
    qed _gA

proof T4:
    _b4 = use B4
    _sts = use swap_triple_short
    _em = use empty
    _pd = use pmem_def
    _td = use tmem_def
    _ps = use pair_set
    fix A
    _stA = forall_elim _sts, A
    _eD = exists_elim _stA, D
    _b4D = forall_elim _b4, D
    _eC = exists_elim _b4D, C
    _ee = exists_elim _em, e
    fix x
    fix y
    _sx = assume set(x)
    _sy = assume set(y)
    _pa1 = forall_elim _pd, y
    _pa2 = forall_elim _pa1, x
    _pdefC = forall_elim _pa2, C
    _f = assume pmem(y,x,C)
    _fu = iff_elim_l _pdefC, _f
    _ep = exists_elim _fu, p
    _kp = and_elim_l _ep
    _pC = and_elim_r _ep
    _z1 = forall_elim _ps, y
    _z2 = forall_elim _z1, x
    _z3 = forall_elim _z2, p
    _z4 = implies_elim _z3, _sy
    _z5 = implies_elim _z4, _sx
    _sp = implies_elim _z5, _kp
    _c1 = forall_elim _eC, p
    _c2 = implies_elim _c1, _sp
    _exs = iff_elim_l _c2, _pC
    _es = exists_elim _exs, s
    _ss = and_elim_l _es
    _psD = and_elim_r _es
    _k = and_intro _kp, _psD
    _tex = exists_intro _k, p
    _t1 = forall_elim _td, y
    _t2 = forall_elim _t1, x
    _t3 = forall_elim _t2, s
    _tdefD = forall_elim _t3, D
    _tm = iff_elim_r _tdefD, _tex
    _d1 = forall_elim _eD, y
    _d2 = forall_elim _d1, x
    _d3 = forall_elim _d2, s
    _d4 = implies_elim _d3, _sy
    _d5 = implies_elim _d4, _sx
    _d6 = implies_elim _d5, _ss
    _pA = iff_elim_l _d6, _tm
    _cl1 = exists_intro _pA
    _cl2 = exists_intro _cl1
    _fwd = implies_intro _cl2
    _g = assume pmem(x,y,A)
    _e1 = forall_elim _eD, y
    _e2 = forall_elim _e1, x
    _e3 = forall_elim _e2, e
    _e4 = implies_elim _e3, _sy
    _e5 = implies_elim _e4, _sx
    _e6 = implies_elim _e5, _ee
    _tmb = iff_elim_r _e6, _g
    _u1 = forall_elim _td, y
    _u2 = forall_elim _u1, x
    _u3 = forall_elim _u2, e
    _u4 = forall_elim _u3, D
    _tub = iff_elim_l _u4, _tmb
    _eqq = exists_elim _tub, q
    _kq = and_elim_l _eqq
    _qeD = and_elim_r _eqq
    _w1 = forall_elim _ps, y
    _w2 = forall_elim _w1, x
    _w3 = forall_elim _w2, q
    _w4 = implies_elim _w3, _sy
    _w5 = implies_elim _w4, _sx
    _sq = implies_elim _w5, _kq
    _v1 = forall_elim _eC, q
    _v2 = implies_elim _v1, _sq
    _kk = and_intro _ee, _qeD
    _exv = exists_intro _kk, e
    _qC = iff_elim_r _v2, _exv
    _kk2 = and_intro _kq, _qC
    _exq = exists_intro _kk2, q
    _res = iff_elim_r _pdefC, _exq
    _cl3 = exists_intro _res
    _bwd = implies_intro _cl3
    _bi = iff_intro _fwd, _bwd
    _i1 = implies_intro _bi
    _i2 = implies_intro _i1
    _g1 = forall_intro _i2
    _g2 = forall_intro _g1
    _cle = exists_intro _g2
    _clC = exists_intro _cle
    _clD = exists_intro _clC
    _gA = forall_intro _clD
    qed _gA
proof pair_ex:
    _ux = use upair_ex
    _kd = use kpair_def
    fix x
    fix y
    _hx = assume set(x)
    _hy = assume set(y)
    _a1 = forall_elim _ux, x
    _a2 = forall_elim _a1, x
    _a3 = implies_elim _a2, _hx
    _a4 = implies_elim _a3, _hx
    _ea = exists_elim _a4, a
    _sa = and_elim_l _ea
    _ua = and_elim_r _ea
    _b1 = forall_elim _ux, x
    _b2 = forall_elim _b1, y
    _b3 = implies_elim _b2, _hx
    _b4 = implies_elim _b3, _hy
    _eb = exists_elim _b4, b
    _sb = and_elim_l _eb
    _ub = and_elim_r _eb
    _c1 = forall_elim _ux, a
    _c2 = forall_elim _c1, b
    _c3 = implies_elim _c2, _sa
    _c4 = implies_elim _c3, _sb
    _ep = exists_elim _c4, p
    _sp = and_elim_l _ep
    _upb = and_elim_r _ep
    _k1 = forall_elim _kd, x
    _k2 = forall_elim _k1, y
    _k3 = forall_elim _k2, p
    _inner = and_intro _ub, _upb
    _body = and_intro _ua, _inner
    _xb = exists_intro _body, b
    _xa = exists_intro _xb, a
    _kp = iff_elim_r _k3, _xa
    _kk = and_intro _sp, _kp
    _y1 = exists_intro _kk, p
    _y2 = exists_intro _y1
    _y3 = exists_intro _y2
    _y4 = exists_intro _y3
    _i1 = implies_intro _y4
    _i2 = implies_intro _i1
    _gy = forall_intro _i2
    _gx = forall_intro _gy
    qed _gx

proof exp_append3:
    _b5 = use B5
    _qd = use qmem_def
    _td = use tmem_def
    _pd = use pmem_def
    _ps = use pair_set
    fix A
    _b5A = forall_elim _b5, A
    _eC = exists_elim _b5A, C
    fix a
    fix b
    fix c
    fix d
    _sa = assume set(a)
    _sb = assume set(b)
    _sc = assume set(c)
    _sd = assume set(d)
    _x1 = forall_elim _qd, a
    _x2 = forall_elim _x1, b
    _x3 = forall_elim _x2, c
    _x4 = forall_elim _x3, d
    _qdef = forall_elim _x4, C
    _y1 = forall_elim _td, a
    _y2 = forall_elim _y1, b
    _y3 = forall_elim _y2, c
    _tdefA = forall_elim _y3, A
    _f = assume qmem(a,b,c,d,C)
    _fu = iff_elim_l _qdef, _f
    _ep = exists_elim _fu, p
    _kp = and_elim_l _ep
    _tp = and_elim_r _ep
    _p1 = forall_elim _ps, a
    _p2 = forall_elim _p1, b
    _p3 = forall_elim _p2, p
    _p4 = implies_elim _p3, _sa
    _p5 = implies_elim _p4, _sb
    _sp = implies_elim _p5, _kp
    _z1 = forall_elim _td, p
    _z2 = forall_elim _z1, c
    _z3 = forall_elim _z2, d
    _tdefC = forall_elim _z3, C
    _tu = iff_elim_l _tdefC, _tp
    _eqq = exists_elim _tu, q
    _kq = and_elim_l _eqq
    _pq = and_elim_r _eqq
    _r1 = forall_elim _ps, p
    _r2 = forall_elim _r1, c
    _r3 = forall_elim _r2, q
    _r4 = implies_elim _r3, _sp
    _r5 = implies_elim _r4, _sc
    _sq = implies_elim _r5, _kq
    _w1 = forall_elim _eC, q
    _w2 = forall_elim _w1, d
    _w3 = implies_elim _w2, _sq
    _w4 = implies_elim _w3, _sd
    _qA = iff_elim_l _w4, _pq
    _v1 = forall_elim _pd, p
    _v2 = forall_elim _v1, c
    _pdefA = forall_elim _v2, A
    _k1 = and_intro _kq, _qA
    _e1 = exists_intro _k1, q
    _pmA = iff_elim_r _pdefA, _e1
    _k2 = and_intro _kp, _pmA
    _e2 = exists_intro _k2, p
    _res = iff_elim_r _tdefA, _e2
    _cl1 = exists_intro _res
    _cl2 = exists_intro _cl1
    _fwd = implies_intro _cl2
    _g = assume tmem(a,b,c,A)
    _gu = iff_elim_l _tdefA, _g
    _ep2 = exists_elim _gu, p2
    _kp2 = and_elim_l _ep2
    _pm2 = and_elim_r _ep2
    _qa1 = forall_elim _ps, a
    _qa2 = forall_elim _qa1, b
    _qa3 = forall_elim _qa2, p2
    _qa4 = implies_elim _qa3, _sa
    _qa5 = implies_elim _qa4, _sb
    _sp2 = implies_elim _qa5, _kp2
    _n1 = forall_elim _pd, p2
    _n2 = forall_elim _n1, c
    _pdefA2 = forall_elim _n2, A
    _pu = iff_elim_l _pdefA2, _pm2
    _eq2 = exists_elim _pu, q2
    _kq2 = and_elim_l _eq2
    _qA2 = and_elim_r _eq2
    _m1 = forall_elim _ps, p2
    _m2 = forall_elim _m1, c
    _m3 = forall_elim _m2, q2
    _m4 = implies_elim _m3, _sp2
    _m5 = implies_elim _m4, _sc
    _sq2 = implies_elim _m5, _kq2
    _o1 = forall_elim _eC, q2
    _o2 = forall_elim _o1, d
    _o3 = implies_elim _o2, _sq2
    _o4 = implies_elim _o3, _sd
    _pmC = iff_elim_r _o4, _qA2
    _u1 = forall_elim _td, p2
    _u2 = forall_elim _u1, c
    _u3 = forall_elim _u2, d
    _tdefC2 = forall_elim _u3, C
    _kk1 = and_intro _kq2, _pmC
    _ee1 = exists_intro _kk1, q2
    _tmC = iff_elim_r _tdefC2, _ee1
    _kk2 = and_intro _kp2, _tmC
    _ee2 = exists_intro _kk2, p2
    _res2 = iff_elim_r _qdef, _ee2
    _cl3 = exists_intro _res2
    _cl4 = exists_intro _cl3
    _bwd = implies_intro _cl4
    _bi = iff_intro _fwd, _bwd
    _i1 = implies_intro _bi
    _i2 = implies_intro _i1
    _i3 = implies_intro _i2
    _i4 = implies_intro _i3
    _g1 = forall_intro _i4
    _g2 = forall_intro _g1
    _g3 = forall_intro _g2
    _g4 = forall_intro _g3
    _clC = exists_intro _g4
    _gA = forall_intro _clC
    qed _gA

proof flatten_slot1:
    _qd = use qmem_def
    _ps = use pair_set
    _pe = use pair_ex
    fix z1
    fix z2
    fix x
    fix y
    fix B
    _s1 = assume set(z1)
    _s2 = assume set(z2)
    _hyp = assume (forall z. (set(z) -> (kpair(z1,z2,z) -> (tmem(z,x,y,B) <-> Phi))))
    _q1 = forall_elim _qd, z1
    _q2 = forall_elim _q1, z2
    _q3 = forall_elim _q2, x
    _q4 = forall_elim _q3, y
    _qdef = forall_elim _q4, B
    _f = assume qmem(z1,z2,x,y,B)
    _fu = iff_elim_l _qdef, _f
    _ep = exists_elim _fu, p
    _kp = and_elim_l _ep
    _tp = and_elim_r _ep
    _a1 = forall_elim _ps, z1
    _a2 = forall_elim _a1, z2
    _a3 = forall_elim _a2, p
    _a4 = implies_elim _a3, _s1
    _a5 = implies_elim _a4, _s2
    _sp = implies_elim _a5, _kp
    _b1 = forall_elim _hyp, p
    _b2 = implies_elim _b1, _sp
    _b3 = implies_elim _b2, _kp
    _phi = iff_elim_l _b3, _tp
    _cl = exists_intro _phi
    _fwd = implies_intro _cl
    _g = assume Phi
    _c1 = forall_elim _pe, z1
    _c2 = forall_elim _c1, z2
    _c3 = implies_elim _c2, _s1
    _c4 = implies_elim _c3, _s2
    _eqq = exists_elim _c4, q
    _sq = and_elim_l _eqq
    _kq = and_elim_r _eqq
    _d1 = forall_elim _hyp, q
    _d2 = implies_elim _d1, _sq
    _d3 = implies_elim _d2, _kq
    _tq = iff_elim_r _d3, _g
    _k = and_intro _kq, _tq
    _ex = exists_intro _k, q
    _res = iff_elim_r _qdef, _ex
    _cl2 = exists_intro _res
    _bwd = implies_intro _cl2
    _bi = iff_intro _fwd, _bwd
    _i1 = implies_intro _bi
    _i2 = implies_intro _i1
    _i3 = implies_intro _i2
    _g1 = forall_intro _i3
    _g2 = forall_intro _g1
    _g3 = forall_intro _g2
    _g4 = forall_intro _g3
    _g5 = forall_intro _g4
    qed _g5

