    _i1 = implies_intro _res
    _i2 = implies_intro _i1
    _i3 = implies_intro _i2
    _q1 = forall_intro _i3
    _i4 = implies_intro _q1
    _q2 = forall_intro _i4
    _i5 = implies_intro _q2
    _q3 = forall_intro _i5
    _i6 = implies_intro _q3
    _q4 = forall_intro _i6
    qed _q4

