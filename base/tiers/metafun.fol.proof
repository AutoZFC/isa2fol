    _w2s = and_elim_l _w2
    _w2p = and_elim_r _w2
    _h1 = forall_elim _ha, t
    _h2 = implies_elim _h1, _st
    _h3 = forall_elim _h2, u2
    _h4 = implies_elim _h3, _w2s
