    _c3 = forall_elim _c2, p1
    _c4 = implies_elim _c3, _sp1
    _c5 = forall_elim _c4, r
    _c6 = implies_elim _c5, _sr
    _c7 = exists_elim _c6, a2
    _c8 = and_elim_l _c7
    _c9 = and_elim_r _c7
    _d1 = forall_elim _h4, a1
    _d2 = implies_elim _d1, _b8
    _d3 = forall_elim _d2, a2
    _d4 = implies_elim _d3, _c8
    _d5 = implies_elim _d4, _b9
    _d6 = implies_elim _d5, _c9
    _d7 = iff_elim_r _d6, _b0
    _d8 = and_intro _c9, _d7
    _d9 = and_intro _c8, _d8
    _da = exists_intro _d9, a2
    _db = and_intro _b9, _da
    _dc = and_intro _b8, _db
    _dd = exists_intro _dc, a1
    _de = iff_elim_r _k4, _dd
    _df = exists_intro _de
    _dg = exists_intro _df
    _bwd = implies_intro _dg
    _bo = iff_intro _fwd, _bwd
    _g1 = implies_intro _bo
    _g2 = forall_intro _g1
    _g3 = implies_intro _g2
    _g4 = forall_intro _g3
    _ex = exists_intro _g4, K
    _cl = exists_intro _ex
    _i1 = implies_intro _cl
    _i2 = implies_intro _i1
    _i3 = forall_intro _i2
    _i4 = forall_intro _i3
    _i5 = implies_intro _i4
    _i6 = forall_intro _i5
    _i7 = implies_intro _i6
    _i8 = forall_intro _i7
    qed _i8

proof cls_apply:
    _b4 = use B4
    _b3 = use B3
    _cz = use cls_zero
    _cp = use cls_place2
    _cv = use cls_conv
    _gi = use g1_inter2
    _gc = use g2_pcompl
    _ad = use apply_def
    fix F
    _d0 = forall_elim _b4, F
    _dD = exists_elim _d0, D
    _n0 = forall_elim _b3, D
    _dN = exists_elim _n0, N
    _x0 = forall_elim _cp, N
    _dX1 = exists_elim _x0, X1
    _x1 = forall_elim _cv, X1
    _dX2 = exists_elim _x1, X2
    _dZ = exists_elim _cz, Z
    _y0 = forall_elim _cp, Z
    _dY = exists_elim _y0, Y
    _m0 = forall_elim _gi, X2
    _m1 = forall_elim _m0, Y
    _dM = exists_elim _m1, M
    _f0 = forall_elim _gc, F
    _dNF = exists_elim _f0, NF
    _f1 = forall_elim _gc, M
    _dNM = exists_elim _f1, NM
    _i0 = forall_elim _gi, NF
    _i1 = forall_elim _i0, NM
    _dI = exists_elim _i1, I
    _w0 = forall_elim _gc, I
    _dW = exists_elim _w0, W
    fix t
    _st = assume set(t)
    fix r
    _sr = assume set(r)
    _W1 = forall_elim _dW, t
    _W2 = implies_elim _W1, _st
    _W3 = forall_elim _W2, r
    _W4 = implies_elim _W3, _sr
    _I1 = forall_elim _dI, t
    _I2 = implies_elim _I1, _st
    _I3 = forall_elim _I2, r
    _I4 = implies_elim _I3, _sr
    _P1 = forall_elim _dNF, t
    _P2 = implies_elim _P1, _st
    _P3 = forall_elim _P2, r
    _P4 = implies_elim _P3, _sr
    _Q1 = forall_elim _dNM, t
    _Q2 = implies_elim _Q1, _st
    _Q3 = forall_elim _Q2, r
    _Q4 = implies_elim _Q3, _sr
    _M1 = forall_elim _dM, t
    _M2 = implies_elim _M1, _st
    _M3 = forall_elim _M2, r
    _M4 = implies_elim _M3, _sr
    _X1 = forall_elim _dX2, t
    _X2 = implies_elim _X1, _st
    _X3 = forall_elim _X2, r
    _X4 = implies_elim _X3, _sr
    _V1 = forall_elim _dX1, r
    _V2 = implies_elim _V1, _sr
    _V3 = forall_elim _V2, t
    _V4 = implies_elim _V3, _st
    _N1 = forall_elim _dN, t
    _N2 = implies_elim _N1, _st
    _D1 = forall_elim _dD, t
    _D2 = implies_elim _D1, _st
    _Y1 = forall_elim _dY, t
    _Y2 = implies_elim _Y1, _st
    _Y3 = forall_elim _Y2, r
    _Y4 = implies_elim _Y3, _sr
    _Z1 = forall_elim _dZ, r
    _Z2 = implies_elim _Z1, _sr
    _A1 = forall_elim _ad, t
    _A2 = forall_elim _A1, r
    _A3 = forall_elim _A2, F
    _c1 = schema_inst iff_trans { A: pmem(t,r,X2), B: pmem(r,t,X1), C: elem(t,N) }
    _c2 = implies_elim _c1, _X4
    _c3 = implies_elim _c2, _V4
    _c4 = schema_inst iff_trans { A: pmem(t,r,X2), B: elem(t,N), C: (~ elem(t,D)) }
    _c5 = implies_elim _c4, _c3
    _c6 = implies_elim _c5, _N2
    _c7 = schema_inst cong_not { A: elem(t,D), B: (exists v. (set(v) & pmem(t,v,F))) }
    _c8 = implies_elim _c7, _D2
    _c9 = schema_inst iff_trans { A: pmem(t,r,X2), B: (~ elem(t,D)), C: (~ (exists v. (set(v) & pmem(t,v,F)))) }
    _ca = implies_elim _c9, _c6
    _cb = implies_elim _ca, _c8
    _y1 = schema_inst iff_trans { A: pmem(t,r,Y), B: elem(r,Z), C: zero(r) }
    _y2 = implies_elim _y1, _Y4
    _y3 = implies_elim _y2, _Z2
    _m2 = schema_inst cong_and { A: pmem(t,r,X2), A2: (~ (exists v. (set(v) & pmem(t,v,F)))), B: pmem(t,r,Y), B2: zero(r) }
    _m3 = implies_elim _m2, _cb
    _m4 = implies_elim _m3, _y3
    _m5 = schema_inst iff_trans { A: pmem(t,r,M), B: (pmem(t,r,X2) & pmem(t,r,Y)), C: ((~ (exists v. (set(v) & pmem(t,v,F)))) & zero(r)) }
    _m6 = implies_elim _m5, _M4
    _m7 = implies_elim _m6, _m4
    _i2 = schema_inst cong_and { A: pmem(t,r,NF), A2: (~ pmem(t,r,F)), B: pmem(t,r,NM), B2: (~ pmem(t,r,M)) }
    _i3 = implies_elim _i2, _P4
    _i4 = implies_elim _i3, _Q4
    _i5 = schema_inst iff_trans { A: pmem(t,r,I), B: (pmem(t,r,NF) & pmem(t,r,NM)), C: ((~ pmem(t,r,F)) & (~ pmem(t,r,M))) }
    _i6 = implies_elim _i5, _I4
    _i7 = implies_elim _i6, _i4
    _w1 = schema_inst cong_not { A: pmem(t,r,I), B: ((~ pmem(t,r,F)) & (~ pmem(t,r,M))) }
    _w2 = implies_elim _w1, _i7
    _w3 = schema_inst iff_trans { A: pmem(t,r,W), B: (~ pmem(t,r,I)), C: (~ ((~ pmem(t,r,F)) & (~ pmem(t,r,M)))) }
    _w4 = implies_elim _w3, _W4
    _w5 = implies_elim _w4, _w2
    _w6 = schema_inst demorgan_or { A: pmem(t,r,F), B: pmem(t,r,M) }
    _w7 = schema_inst iff_trans { A: pmem(t,r,W), B: (~ ((~ pmem(t,r,F)) & (~ pmem(t,r,M)))), C: (pmem(t,r,F) | pmem(t,r,M)) }
    _w8 = implies_elim _w7, _w5
    _w9 = implies_elim _w8, _w6
    _o1 = schema_inst iff_refl { A: pmem(t,r,F) }
    _o2 = schema_inst cong_or { A: pmem(t,r,F), A2: pmem(t,r,F), B: pmem(t,r,M), B2: ((~ (exists v. (set(v) & pmem(t,v,F)))) & zero(r)) }
    _o3 = implies_elim _o2, _o1
    _o4 = implies_elim _o3, _m7
    _o5 = schema_inst iff_trans { A: pmem(t,r,W), B: (pmem(t,r,F) | pmem(t,r,M)), C: (pmem(t,r,F) | ((~ (exists v. (set(v) & pmem(t,v,F)))) & zero(r))) }
    _o6 = implies_elim _o5, _w9
    _o7 = implies_elim _o6, _o4
    _s1 = schema_inst iff_symm { A: apply(t,r,F), B: (pmem(t,r,F) | ((~ (exists v. (set(v) & pmem(t,v,F)))) & zero(r))) }
    _s2 = implies_elim _s1, _A3
    _s3 = schema_inst iff_trans { A: pmem(t,r,W), B: (pmem(t,r,F) | ((~ (exists v. (set(v) & pmem(t,v,F)))) & zero(r))), C: apply(t,r,F) }
    _s4 = implies_elim _s3, _o7
    _s5 = implies_elim _s4, _s2
    _g1 = implies_intro _s5
    _g2 = forall_intro _g1
    _g3 = implies_intro _g2
    _g4 = forall_intro _g3
    _e0 = exists_intro _g4, W
    _e1 = exists_intro _e0
    _e2 = exists_intro _e1
    _e3 = exists_intro _e2
    _e4 = exists_intro _e3
    _e5 = exists_intro _e4
    _e6 = exists_intro _e5
    _e7 = exists_intro _e6
    _e8 = exists_intro _e7
    _e9 = exists_intro _e8
    _ea = exists_intro _e9
    _eb = exists_intro _ea
    _r = forall_intro _eb
    qed _r
