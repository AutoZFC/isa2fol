proof apply_EX:
    _ad = use apply_def
    _ze = use zero_EX
    fix F
    fix t
    _st = assume set(t)
    _a1 = forall_elim _ad, t
    _phi = let (exists u. (set(u) & pmem(t,u,F)))
    _em = excluded_middle _phi
    _c1 = assume (exists u. (set(u) & pmem(t,u,F)))
    _w1 = exists_elim _c1, w
    _sw = and_elim_l _w1
    _pw = and_elim_r _w1
    _a2 = forall_elim _a1, w
    _a3 = forall_elim _a2, F
    _o1d = let ((~ (exists u. (set(u) & pmem(t,u,F)))) & zero(w))
    _o1 = or_intro_l _pw, _o1d
    _ap1 = iff_elim_r _a3, _o1
    _cj1 = and_intro _sw, _ap1
    _ex1 = exists_intro _cj1, w
    _cl1 = exists_intro _ex1
    _l1 = implies_intro _cl1
    _c2 = assume (~ (exists u. (set(u) & pmem(t,u,F))))
    _w2 = exists_elim _ze, z
    _sz = and_elim_l _w2
    _zz = and_elim_r _w2
    _b1 = forall_elim _a1, z
    _b2 = forall_elim _b1, F
    _nz = and_intro _c2, _zz
    _o2d = let pmem(t,z,F)
    _o2 = or_intro_r _o2d, _nz
    _ap2 = iff_elim_r _b2, _o2
    _cj2 = and_intro _sz, _ap2
    _ex2 = exists_intro _cj2, z
    _cl2 = exists_intro _ex2
    _l2 = implies_intro _cl2
    _res = or_elim _em, _l1, _l2
    _i = implies_intro _res
    _q1 = forall_intro _i
    _q2 = forall_intro _q1
    qed _q2

proof apply_UNIQ:
    _ad = use apply_def
