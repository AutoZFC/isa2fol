proof g7_fresh:
    _id = use index_def
    _sy = use eq_symm
    _es = use elem_second
    fix p
    _sp = assume set(p)
    fix p1
    _sp1 = assume set(p1)
    _ip = assume index(p)
    _pin = assume elem(p,p1)
    _i1 = forall_elim _id, p
    _i2 = iff_elim_l _i1, _ip
    _tr = and_elim_l _i2
    _irr = and_elim_r _i2
    _ha = assume eq(p,p1)
    _s1 = forall_elim _sy, p
    _s2 = forall_elim _s1, p1
    _s3 = implies_elim _s2, _ha
    _e1 = forall_elim _es, p1
    _e2 = forall_elim _e1, p
    _e3 = forall_elim _e2, p
    _e4 = implies_elim _e3, _s3
    _e5 = implies_elim _e4, _pin
    _ba = not_elim _irr, _e5
    _na = not_intro _ba
    _hb = assume eq(p1,p)
    _f4 = implies_elim _e3, _hb
    _f5 = implies_elim _f4, _pin
    _bb = not_elim _irr, _f5
    _nb = not_intro _bb
    _hc = assume elem(p1,p)
    _t1 = forall_elim _tr, p1
    _t2 = implies_elim _t1, _sp1
    _t3 = implies_elim _t2, _hc
    _t4 = forall_elim _t3, p
    _t5 = implies_elim _t4, _sp
    _t6 = implies_elim _t5, _pin
    _bc = not_elim _irr, _t6
    _nc = not_intro _bc
    _cbc = and_intro _nb, _nc
    _all = and_intro _na, _cbc
    _j1 = implies_intro _all
    _j2 = implies_intro _j1
    _j3 = implies_intro _j2
    _g1 = forall_intro _j3
    _j4 = implies_intro _g1
    _g2 = forall_intro _j4
    qed _g2

proof g7_at_p:
    _td = use tuple_def
    _id = use index_def
    _tdm = use tuple_dom
    _sp = use snoc_pmem
    _fr = use g7_fresh
    fix p
    _ssp = assume set(p)
    fix p1
    _ssp1 = assume set(p1)
    fix c
    _ssc = assume set(c)
    _htc = assume tuple(c,p)
    _pin = assume elem(p,p1)
    fix t
    _sst = assume set(t)
    fix r
    _ssr = assume set(r)
    fix a1
    _ssa1 = assume set(a1)
    fix a2
    _ssa2 = assume set(a2)
    _h1 = assume snoc(c,p,t,a1)
    _h2 = assume snoc(a1,p1,r,a2)
    fix u
    _ssu = assume set(u)
    _hu = assume pmem(p,u,a2)
    _d1 = forall_elim _td, c
    _d2 = forall_elim _d1, p
    _d3 = iff_elim_l _d2, _htc
    _ip = and_elim_l _d3
    _x1 = forall_elim _id, p
    _x2 = iff_elim_l _x1, _ip
    _irr = and_elim_r _x2
    _f1 = forall_elim _fr, p
    _f2 = implies_elim _f1, _ssp
    _f3 = forall_elim _f2, p1
    _f4 = implies_elim _f3, _ssp1
    _f5 = implies_elim _f4, _ip
    _f6 = implies_elim _f5, _pin
    _npp1 = and_elim_l _f6
    _q1 = forall_elim _sp, a1
    _q2 = forall_elim _q1, p1
    _q3 = forall_elim _q2, r
    _q4 = forall_elim _q3, a2
    _q5 = implies_elim _q4, _h2
    _q6 = forall_elim _q5, p
    _q7 = implies_elim _q6, _ssp
    _q8 = forall_elim _q7, u
    _q9 = implies_elim _q8, _ssu
    _D2 = iff_elim_l _q9, _hu
    _c1 = assume pmem(p,u,a1)
    _w1 = forall_elim _sp, c
    _w2 = forall_elim _w1, p
    _w3 = forall_elim _w2, t
    _w4 = forall_elim _w3, a1
    _w5 = implies_elim _w4, _h1
    _w6 = forall_elim _w5, p
    _w7 = implies_elim _w6, _ssp
    _w8 = forall_elim _w7, u
    _w9 = implies_elim _w8, _ssu
    _D1 = iff_elim_l _w9, _c1
    _c1a = assume pmem(p,u,c)
    _m1 = forall_elim _tdm, c
    _m2 = forall_elim _m1, p
    _m3 = implies_elim _m2, _htc
    _m4 = forall_elim _m3, p
    _m5 = implies_elim _m4, _ssp
    _m6 = forall_elim _m5, u
    _m7 = implies_elim _m6, _ssu
    _m8 = implies_elim _m7, _c1a
    _b1a = not_elim _irr, _m8
    _lut = let eq(u,t)
    _r1a = bottom_elim _b1a, _lut
    _k1a = implies_intro _r1a
    _c1b = assume (eq(p,p) & eq(u,t))
    _r1b = and_elim_r _c1b
    _k1b = implies_intro _r1b
    _r1 = or_elim _D1, _k1a, _k1b
    _k1 = implies_intro _r1
    _c2 = assume (eq(p,p1) & eq(u,r))
    _e2 = and_elim_l _c2
    _b2 = not_elim _npp1, _e2
    _r2 = bottom_elim _b2, _lut
    _k2 = implies_intro _r2
    _res = or_elim _D2, _k1, _k2
    _j1 = implies_intro _res
    _j2 = implies_intro _j1
    _g1 = forall_intro _j2
    _j3 = implies_intro _g1
    _j4 = implies_intro _j3
    _j5 = implies_intro _j4
    _g2 = forall_intro _j5
    _j6 = implies_intro _g2
    _g3 = forall_intro _j6
    _j7 = implies_intro _g3
    _g4 = forall_intro _j7
    _j8 = implies_intro _g4
    _g5 = forall_intro _j8
    _j9 = implies_intro _g5
    _j10 = implies_intro _j9
    _j11 = implies_intro _j10
    _g6 = forall_intro _j11
    _j12 = implies_intro _g6
    _g7 = forall_intro _j12
    _j13 = implies_intro _g7
    _g8 = forall_intro _j13
    qed _g8

proof g7_at_p1:
    _td = use tuple_def
    _tdm = use tuple_dom
    _sp = use snoc_pmem
    _fr = use g7_fresh
    fix p
    _ssp = assume set(p)
    fix p1
    _ssp1 = assume set(p1)
    fix c
    _ssc = assume set(c)
    _htc = assume tuple(c,p)
    _pin = assume elem(p,p1)
    fix t
    _sst = assume set(t)
    fix r
    _ssr = assume set(r)
    fix a1
    _ssa1 = assume set(a1)
    fix a2
    _ssa2 = assume set(a2)
    _h1 = assume snoc(c,p,t,a1)
    _h2 = assume snoc(a1,p1,r,a2)
    fix v
    _ssv = assume set(v)
    _hv = assume pmem(p1,v,a2)
    _d1 = forall_elim _td, c
    _d2 = forall_elim _d1, p
    _d3 = iff_elim_l _d2, _htc
    _ip = and_elim_l _d3
    _f1 = forall_elim _fr, p
    _f2 = implies_elim _f1, _ssp
    _f3 = forall_elim _f2, p1
    _f4 = implies_elim _f3, _ssp1
    _f5 = implies_elim _f4, _ip
    _f6 = implies_elim _f5, _pin
    _f7 = and_elim_r _f6
    _np1p = and_elim_l _f7
    _nep1 = and_elim_r _f7
    _q1 = forall_elim _sp, a1
    _q2 = forall_elim _q1, p1
    _q3 = forall_elim _q2, r
    _q4 = forall_elim _q3, a2
    _q5 = implies_elim _q4, _h2
    _q6 = forall_elim _q5, p1
    _q7 = implies_elim _q6, _ssp1
    _q8 = forall_elim _q7, v
    _q9 = implies_elim _q8, _ssv
    _D2 = iff_elim_l _q9, _hv
    _lvr = let eq(v,r)
    _c1 = assume pmem(p1,v,a1)
    _w1 = forall_elim _sp, c
    _w2 = forall_elim _w1, p
    _w3 = forall_elim _w2, t
    _w4 = forall_elim _w3, a1
    _w5 = implies_elim _w4, _h1
    _w6 = forall_elim _w5, p1
    _w7 = implies_elim _w6, _ssp1
    _w8 = forall_elim _w7, v
    _w9 = implies_elim _w8, _ssv
    _D1 = iff_elim_l _w9, _c1
    _c1a = assume pmem(p1,v,c)
    _m1 = forall_elim _tdm, c
    _m2 = forall_elim _m1, p
    _m3 = implies_elim _m2, _htc
    _m4 = forall_elim _m3, p1
    _m5 = implies_elim _m4, _ssp1
    _m6 = forall_elim _m5, v
    _m7 = implies_elim _m6, _ssv
    _m8 = implies_elim _m7, _c1a
    _b1a = not_elim _nep1, _m8
    _r1a = bottom_elim _b1a, _lvr
    _k1a = implies_intro _r1a
    _c1b = assume (eq(p1,p) & eq(v,t))
    _e1b = and_elim_l _c1b
    _b1b = not_elim _np1p, _e1b
    _r1b = bottom_elim _b1b, _lvr
    _k1b = implies_intro _r1b
    _r1 = or_elim _D1, _k1a, _k1b
    _k1 = implies_intro _r1
    _c2 = assume (eq(p1,p1) & eq(v,r))
    _r2 = and_elim_r _c2
    _k2 = implies_intro _r2
    _res = or_elim _D2, _k1, _k2
    _j1 = implies_intro _res
    _j2 = implies_intro _j1
    _g1 = forall_intro _j2
    _j3 = implies_intro _g1
    _j4 = implies_intro _j3
    _j5 = implies_intro _j4
    _g2 = forall_intro _j5
    _j6 = implies_intro _g2
    _g3 = forall_intro _j6
    _j7 = implies_intro _g3
    _g4 = forall_intro _j7
    _j8 = implies_intro _g4
    _g5 = forall_intro _j8
    _j9 = implies_intro _g5
    _j10 = implies_intro _j9
    _j11 = implies_intro _j10
    _g6 = forall_intro _j11
    _j12 = implies_intro _g6
    _g7 = forall_intro _j12
    _j13 = implies_intro _g7
    _g8 = forall_intro _j13
    qed _g8

proof lam_eta:
    _nd = use nsucc_def
    _er = use eq_refl
    _sex = use snoc_EX
    _sn = use snoc_new
    _sp = use snoc_pmem
    _pc = use g1_pmem_cong
    _ap = use g7_at_p
    _ap1 = use g7_at_p1
    fix p
    _ssp = assume set(p)
    fix p1
    _ssp1 = assume set(p1)
    _hns = assume nsucc(p,p1)
    fix c
    _ssc = assume set(c)
    _htc = assume tuple(c,p)
    fix F
    fix A
    _hA = assume (forall a. (set(a) -> (elem(a,A) <-> (exists u. (set(u) & (pmem(p,u,a) & (exists v. (set(v) & (pmem(p1,v,a) & pmem(u,v,F))))))))))
    fix t
    _sst = assume set(t)
    fix r
    _ssr = assume set(r)
    _n1 = forall_elim _nd, p
    _n2 = forall_elim _n1, p1
    _n3 = iff_elim_l _n2, _hns
    _n4 = forall_elim _n3, p
    _n5 = implies_elim _n4, _ssp
    _epp = forall_elim _er, p
    _lpp = let elem(p,p)
    _n6 = or_intro_r _lpp, _epp
    _pin = iff_elim_r _n5, _n6
    _hf = assume (exists a1. (set(a1) & (snoc(c,p,t,a1) & (exists a2. (set(a2) & (snoc(a1,p1,r,a2) & elem(a2,A)))))))
    _x1 = exists_elim _hf, a1
    _sa1 = and_elim_l _x1
    _x1r = and_elim_r _x1
    _s1 = and_elim_l _x1r
    _x1e = and_elim_r _x1r
    _x2 = exists_elim _x1e, a2
    _sa2 = and_elim_l _x2
    _x2r = and_elim_r _x2
    _s2 = and_elim_l _x2r
    _ina = and_elim_r _x2r
    _a1 = forall_elim _hA, a2
    _a2 = implies_elim _a1, _sa2
    _a3 = iff_elim_l _a2, _ina
    _x3 = exists_elim _a3, u
    _su = and_elim_l _x3
    _x3r = and_elim_r _x3
    _pu = and_elim_l _x3r
    _x3e = and_elim_r _x3r
    _x4 = exists_elim _x3e, v
    _sv = and_elim_l _x4
    _x4r = and_elim_r _x4
    _pv = and_elim_l _x4r
    _pF = and_elim_r _x4r
    _u1 = forall_elim _ap, p
    _u2 = implies_elim _u1, _ssp
    _u3 = forall_elim _u2, p1
    _u4 = implies_elim _u3, _ssp1
    _u5 = forall_elim _u4, c
    _u6 = implies_elim _u5, _ssc
    _u7 = implies_elim _u6, _htc
    _u8 = implies_elim _u7, _pin
    _u9 = forall_elim _u8, t
    _u10 = implies_elim _u9, _sst
    _u11 = forall_elim _u10, r
    _u12 = implies_elim _u11, _ssr
    _u13 = forall_elim _u12, a1
    _u14 = implies_elim _u13, _sa1
    _u15 = forall_elim _u14, a2
    _u16 = implies_elim _u15, _sa2
    _u17 = implies_elim _u16, _s1
    _u18 = implies_elim _u17, _s2
    _u19 = forall_elim _u18, u
    _u20 = implies_elim _u19, _su
    _eut = implies_elim _u20, _pu
    _v1 = forall_elim _ap1, p
    _v2 = implies_elim _v1, _ssp
    _v3 = forall_elim _v2, p1
    _v4 = implies_elim _v3, _ssp1
    _v5 = forall_elim _v4, c
    _v6 = implies_elim _v5, _ssc
    _v7 = implies_elim _v6, _htc
    _v8 = implies_elim _v7, _pin
    _v9 = forall_elim _v8, t
    _v10 = implies_elim _v9, _sst
    _v11 = forall_elim _v10, r
    _v12 = implies_elim _v11, _ssr
    _v13 = forall_elim _v12, a1
    _v14 = implies_elim _v13, _sa1
    _v15 = forall_elim _v14, a2
    _v16 = implies_elim _v15, _sa2
    _v17 = implies_elim _v16, _s1
    _v18 = implies_elim _v17, _s2
    _v19 = forall_elim _v18, v
    _v20 = implies_elim _v19, _sv
    _evr = implies_elim _v20, _pv
    _c1 = forall_elim _pc, F
    _c2 = forall_elim _c1, u
    _c3 = implies_elim _c2, _su
    _c4 = forall_elim _c3, t
    _c5 = implies_elim _c4, _sst
    _c6 = forall_elim _c5, v
    _c7 = implies_elim _c6, _sv
    _c8 = forall_elim _c7, r
    _c9 = implies_elim _c8, _ssr
    _c10 = implies_elim _c9, _eut
    _c11 = implies_elim _c10, _evr
    _ptr = implies_elim _c11, _pF
    _o4 = exists_intro _ptr
    _o3 = exists_intro _o4
    _o2 = exists_intro _o3
    _o1 = exists_intro _o2
    _fwd = implies_intro _o1
    _hb = assume pmem(t,r,F)
    _y1 = forall_elim _sex, c
    _y2 = implies_elim _y1, _ssc
    _y3 = forall_elim _y2, p
    _y4 = implies_elim _y3, _ssp
    _y5 = forall_elim _y4, t
    _y6 = implies_elim _y5, _sst
    _z1 = exists_elim _y6, a1
    _ta1 = and_elim_l _z1
    _sn1 = and_elim_r _z1
    _y7 = forall_elim _sex, a1
    _y8 = implies_elim _y7, _ta1
    _y9 = forall_elim _y8, p1
    _y10 = implies_elim _y9, _ssp1
    _y11 = forall_elim _y10, r
    _y12 = implies_elim _y11, _ssr
    _z2 = exists_elim _y12, a2
    _ta2 = and_elim_l _z2
    _sn2 = and_elim_r _z2
    _k1 = forall_elim _sn, a1
    _k2 = forall_elim _k1, p1
    _k3 = forall_elim _k2, r
    _k4 = forall_elim _k3, a2
    _k5 = implies_elim _k4, _sn2
    _k6 = implies_elim _k5, _ssp1
    _p1r = implies_elim _k6, _ssr
    _l1 = forall_elim _sn, c
    _l2 = forall_elim _l1, p
    _l3 = forall_elim _l2, t
    _l4 = forall_elim _l3, a1
    _l5 = implies_elim _l4, _sn1
    _l6 = implies_elim _l5, _ssp
    _pta1 = implies_elim _l6, _sst
    _m1 = forall_elim _sp, a1
    _m2 = forall_elim _m1, p1
    _m3 = forall_elim _m2, r
    _m4 = forall_elim _m3, a2
    _m5 = implies_elim _m4, _sn2
    _m6 = forall_elim _m5, p
    _m7 = implies_elim _m6, _ssp
    _m8 = forall_elim _m7, t
    _m9 = implies_elim _m8, _sst
    _lx = let (eq(p,p1) & eq(t,r))
    _m10 = or_intro_l _pta1, _lx
    _pta2 = iff_elim_r _m9, _m10
    _b1 = and_intro _p1r, _hb
    _b2 = and_intro _ssr, _b1
    _b3 = exists_intro _b2, r
    _b4 = and_intro _pta2, _b3
    _b5 = and_intro _sst, _b4
    _b6 = exists_intro _b5, t
    _h1 = forall_elim _hA, a2
    _h2 = implies_elim _h1, _ta2
    _ina2 = iff_elim_r _h2, _b6
    _b7 = and_intro _sn2, _ina2
    _b8 = and_intro _ta2, _b7
    _b9 = exists_intro _b8, a2
    _b10 = exists_intro _b9
    _b11 = and_intro _sn1, _b10
    _b12 = and_intro _ta1, _b11
    _b13 = exists_intro _b12, a1
    _b14 = exists_intro _b13
    _bwd = implies_intro _b14
    _iff = iff_intro _fwd, _bwd
    _j1 = implies_intro _iff
    _g1 = forall_intro _j1
    _j2 = implies_intro _g1
    _g2 = forall_intro _j2
    _j3 = implies_intro _g2
    _g3 = forall_intro _j3
    _g4 = forall_intro _g3
    _j4 = implies_intro _g4
    _j5 = implies_intro _j4
    _g5 = forall_intro _j5
    _j6 = implies_intro _g5
    _j7 = implies_intro _j6
    _g6 = forall_intro _j7
    _j8 = implies_intro _g6
    _g7 = forall_intro _j8
    qed _g7

proof mfun_comb:
    _pc = use g1_pmem_cong
    _es = use eq_symm
    _er = use eq_refl
    fix F
    fix G
    _hyp = assume forall t. (set(t) -> (forall r. (set(r) -> (pmem(t,r,F) <-> pmem(t,r,G)))))
    fix t
    _st = assume set(t)
    fix t2
    _st2 = assume set(t2)
    _htt = assume eq(t,t2)
    fix r
    _sr = assume set(r)
    _rr = forall_elim _er, r
    _e1 = forall_elim _es, t
    _e2 = forall_elim _e1, t2
    _ts = implies_elim _e2, _htt
    _h1 = forall_elim _hyp, t
    _h2 = implies_elim _h1, _st
    _h3 = forall_elim _h2, r
    _h4 = implies_elim _h3, _sr
    _a = assume pmem(t,r,F)
    _a1 = iff_elim_l _h4, _a
    _g1 = forall_elim _pc, G
    _g2 = forall_elim _g1, t
    _g3 = implies_elim _g2, _st
    _g4 = forall_elim _g3, t2
    _g5 = implies_elim _g4, _st2
    _g6 = forall_elim _g5, r
    _g7 = implies_elim _g6, _sr
    _g8 = forall_elim _g7, r
    _g9 = implies_elim _g8, _sr
    _g10 = implies_elim _g9, _htt
    _g11 = implies_elim _g10, _rr
    _g12 = implies_elim _g11, _a1
    _fw = implies_intro _g12
    _b = assume pmem(t2,r,G)
    _j1 = forall_elim _pc, G
    _j2 = forall_elim _j1, t2
    _j3 = implies_elim _j2, _st2
    _j4 = forall_elim _j3, t
    _j5 = implies_elim _j4, _st
    _j6 = forall_elim _j5, r
    _j7 = implies_elim _j6, _sr
    _j8 = forall_elim _j7, r
    _j9 = implies_elim _j8, _sr
    _j10 = implies_elim _j9, _ts
    _j11 = implies_elim _j10, _rr
    _j12 = implies_elim _j11, _b
    _b1 = iff_elim_r _h4, _j12
    _bw = implies_intro _b1
    _iff = iff_intro _fw, _bw
    _c1 = implies_intro _iff
    _c2 = forall_intro _c1
    _c3 = implies_intro _c2
    _c4 = implies_intro _c3
    _c5 = forall_intro _c4
    _c6 = implies_intro _c5
    _c7 = forall_intro _c6
    _c8 = implies_intro _c7
    _c9 = forall_intro _c8
    _c10 = forall_intro _c9
    qed _c10

proof mfun_ext:
    _md = use mfun_def
    _pc = use g1_pmem_cong
    _er = use eq_refl
    fix F
    fix G
    fix D
    _mF = assume mfun(F,D)
    _mG = assume mfun(G,D)
    _hx = assume forall t. (set(t) -> (elem(t,D) -> (exists r. (set(r) & (pmem(t,r,F) & pmem(t,r,G))))))
    fix t
    _st = assume set(t)
    _tD = assume elem(t,D)
    fix r
    _sr = assume set(r)
    _f1 = forall_elim _md, F
    _f2 = forall_elim _f1, D
    _f3 = iff_elim_l _f2, _mF
    _f4 = forall_elim _f3, t
    _f5 = implies_elim _f4, _st
    _f6 = implies_elim _f5, _tD
    _fsv = and_elim_r _f6
    _k1 = forall_elim _md, G
    _k2 = forall_elim _k1, D
    _k3 = iff_elim_l _k2, _mG
    _k4 = forall_elim _k3, t
    _k5 = implies_elim _k4, _st
    _k6 = implies_elim _k5, _tD
    _gsv = and_elim_r _k6
    _x1 = forall_elim _hx, t
    _x2 = implies_elim _x1, _st
    _x3 = implies_elim _x2, _tD
    _tt = forall_elim _er, t
    _a = assume pmem(t,r,F)
    _w = exists_elim _x3, r0
    _sr0 = and_elim_l _w
    _wr = and_elim_r _w
    _r0F = and_elim_l _wr
    _r0G = and_elim_r _wr
    _s1 = forall_elim _fsv, r0
    _s2 = implies_elim _s1, _sr0
    _s3 = forall_elim _s2, r
    _s4 = implies_elim _s3, _sr
    _s5 = implies_elim _s4, _r0F
    _s6 = implies_elim _s5, _a
    _g1 = forall_elim _pc, G
    _g2 = forall_elim _g1, t
    _g3 = implies_elim _g2, _st
    _g4 = forall_elim _g3, t
    _g5 = implies_elim _g4, _st
    _g6 = forall_elim _g5, r0
    _g7 = implies_elim _g6, _sr0
    _g8 = forall_elim _g7, r
    _g9 = implies_elim _g8, _sr
    _g10 = implies_elim _g9, _tt
    _g11 = implies_elim _g10, _s6
    _g12 = implies_elim _g11, _r0G
    _fx = exists_intro _g12
    _fw = implies_intro _fx
    _b = assume pmem(t,r,G)
    _v = exists_elim _x3, r1
    _sr1 = and_elim_l _v
    _vr = and_elim_r _v
    _r1F = and_elim_l _vr
    _r1G = and_elim_r _vr
    _q1 = forall_elim _gsv, r1
    _q2 = implies_elim _q1, _sr1
    _q3 = forall_elim _q2, r
