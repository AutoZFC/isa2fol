    _hi = assume (forall u1. (set(u1) -> (forall u2. (set(u2) -> (forall u3. (set(u3) -> B(u1,u2,u3)))))))
    fix u1
    fix u2
    fix u3
    _iuu1 = assume set(u1)
    _iuu2 = assume set(u2)
    _iuu3 = assume set(u3)
    _s13 = forall_elim _hi, u1
    _s14 = implies_elim _s13, _iuu1
    _s15 = forall_elim _s14, u2
    _s16 = implies_elim _s15, _iuu2
    _s17 = forall_elim _s16, u3
    _s18 = implies_elim _s17, _iuu3
    _s19 = implies_intro _s18
    _s20 = implies_intro _s19
    _s21 = implies_intro _s20
    _s22 = forall_intro _s21
    _s23 = forall_intro _s22
    _s24 = forall_intro _s23
    _s25 = implies_intro _s24
    _r = iff_intro _s12, _s25
    qed _r

