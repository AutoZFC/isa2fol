    _s3 = implies_elim _s2, _gxx1
    _s4 = implies_elim _s3, _gxx2
    _s5 = implies_elim _s4, _gxx3
    _s6 = implies_intro _s5
    _s7 = forall_intro _s6
    _s8 = implies_intro _s7
