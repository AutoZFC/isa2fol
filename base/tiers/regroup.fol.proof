proof regroup2:
    _hg = assume (forall x1. (forall x2. (set(x1) -> (set(x2) -> B(x1,x2)))))
    fix x1
    _gxx1 = assume set(x1)
    fix x2
    _gxx2 = assume set(x2)
    _s0 = forall_elim _hg, x1
    _s1 = forall_elim _s0, x2
    _s2 = implies_elim _s1, _gxx1
    _s3 = implies_elim _s2, _gxx2
    _s4 = implies_intro _s3
    _s5 = forall_intro _s4
    _s6 = implies_intro _s5
    _s7 = forall_intro _s6
    _s8 = implies_intro _s7
    _hi = assume (forall u1. (set(u1) -> (forall u2. (set(u2) -> B(u1,u2)))))
    fix u1
    fix u2
    _iuu1 = assume set(u1)
    _iuu2 = assume set(u2)
    _s9 = forall_elim _hi, u1
    _s10 = implies_elim _s9, _iuu1
    _s11 = forall_elim _s10, u2
    _s12 = implies_elim _s11, _iuu2
    _s13 = implies_intro _s12
    _s14 = implies_intro _s13
    _s15 = forall_intro _s14
    _s16 = forall_intro _s15
    _s17 = implies_intro _s16
    _r = iff_intro _s8, _s17
    qed _r

proof regroup3:
    _hg = assume (forall x1. (forall x2. (forall x3. (set(x1) -> (set(x2) -> (set(x3) -> B(x1,x2,x3)))))))
    fix x1
