proof truth_EX:
    _zx = use zero_EX
    _zd = use zero_def
    _ue = use upair_ex
    _m1 = use upair_mem1
    _se = use sing_elem
    _ce = use cong_elem_r
    _td = use truth_def
    _hd = use holds_def
    _zo = exists_elim _zx, z
    _sz = and_elim_l _zo
    _zz = and_elim_r _zo
    _zd1 = forall_elim _zd, z
    _ez = iff_elim_l _zd1, _zz
    _a = let A
    _em = excluded_middle _a
    _ha = assume A
    _u1 = forall_elim _ue, z
    _u2 = forall_elim _u1, z
    _u3 = implies_elim _u2, _sz
    _u4 = implies_elim _u3, _sz
    _so = exists_elim _u4, s
    _ss = and_elim_l _so
    _us = and_elim_r _so
    fix u
    _su = assume set(u)
    _eu = assume elem(u,s)
    _se1 = forall_elim _se, z
    _se2 = forall_elim _se1, s
    _se3 = forall_elim _se2, u
    _se4 = implies_elim _se3, _us
    _equz = implies_elim _se4, _eu
    fix w
    _sw = assume set(w)
    _ew = assume elem(w,u)
    _c1 = forall_elim _ce, w
    _c2 = forall_elim _c1, u
    _c3 = forall_elim _c2, z
    _c4 = implies_elim _c3, _equz
    _ewz = iff_elim_l _c4, _ew
    _nz1 = forall_elim _ez, w
    _nz2 = implies_elim _nz1, _sw
    _bot = not_elim _nz2, _ewz
    _nw = not_intro _bot
    _iw = implies_intro _nw
    _fw = forall_intro _iw
    _zd2 = forall_elim _zd, u
    _zu = iff_elim_r _zd2, _fw
    _i1 = implies_intro _zu
    _i2 = implies_intro _i1
    _fu = forall_intro _i2
    _tsb = and_intro _ss, _fu
    _td1 = forall_elim _td, s
    _ts = iff_elim_r _td1, _tsb
    _m11 = forall_elim _m1, z
    _m12 = forall_elim _m11, z
    _m13 = forall_elim _m12, s
    _ezs = implies_elim _m13, _us
    _zzs = and_intro _zz, _ezs
    _szz = and_intro _sz, _zzs
    _hx = exists_intro _szz, z
    _hd1 = forall_elim _hd, s
    _hs = iff_elim_r _hd1, _hx
    _hh = assume holds(s)
    _hsa = implies_intro _ha
    _aa = assume A
    _ahs = implies_intro _hs
    _iff = iff_intro _hsa, _ahs
    _body = and_intro _ts, _iff
    _ex = exists_intro _body, s
    _cl = exists_intro _ex
    _caseA = implies_intro _cl
    _hn = assume ~ A
    fix u2
    _su2 = assume set(u2)
    _eu2 = assume elem(u2,z)
    _nzu1 = forall_elim _ez, u2
    _nzu2 = implies_elim _nzu1, _su2
    _bot2 = not_elim _nzu2, _eu2
    _zl = let zero(u2)
    _zu2 = bottom_elim _bot2, _zl
    _j1 = implies_intro _zu2
    _j2 = implies_intro _j1
    _fu2 = forall_intro _j2
    _tzb = and_intro _sz, _fu2
    _td2 = forall_elim _td, z
    _tz = iff_elim_r _td2, _tzb
    _hz = assume holds(z)
    _hd2 = forall_elim _hd, z
    _hz1 = iff_elim_l _hd2, _hz
    _wo = exists_elim _hz1, v
    _sv = and_elim_l _wo
    _rest = and_elim_r _wo
    _evz = and_elim_r _rest
    _nv1 = forall_elim _ez, v
    _nv2 = implies_elim _nv1, _sv
    _bot3 = not_elim _nv2, _evz
    _al = let A
    _a3 = bottom_elim _bot3, _al
    _a3c = exists_intro _a3
    _hza = implies_intro _a3c
    _aa2 = assume A
    _bot4 = not_elim _hn, _aa2
    _hl = let holds(z)
    _hz4 = bottom_elim _bot4, _hl
    _azh = implies_intro _hz4
    _iff2 = iff_intro _hza, _azh
    _body2 = and_intro _tz, _iff2
    _ex2 = exists_intro _body2, z
    _caseN = implies_intro _ex2
    _goal = or_elim _em, _caseA, _caseN
    _done = exists_intro _goal
    qed _done

proof weaken:
    _a = assume A
    _b = assume B
    _ba = implies_intro _a
    _aba = implies_intro _ba
    qed _aba
