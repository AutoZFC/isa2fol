    _h28 = schema_inst cong_and { A: pmem(i,u,a), A2: pmem(i,u,a), B: (exists z. (set(z) & (pmem(j,z,a) & pmem(u,z,Ee)))), B2: (exists z. (set(z) & (pmem(j,z,a) & elem(u,z)))) }
