proof g1_pmem_cong:
    _pd = use pmem_def
    _kac = use kpair_arg_cong
    fix X
    fix a
    _sa = assume set(a)
    fix b
    _sb = assume set(b)
    fix c
    _sc = assume set(c)
    fix d
    _sd = assume set(d)
    _h1 = assume eq(a,b)
    _h2 = assume eq(c,d)
    _h3 = assume pmem(a,c,X)
    _p1 = forall_elim _pd, a
    _p2 = forall_elim _p1, c
    _p3 = forall_elim _p2, X
    _u = iff_elim_l _p3, _h3
    _w = exists_elim _u, r
    _sr = and_elim_l _w
    _wr = and_elim_r _w
    _kr = and_elim_l _wr
    _er = and_elim_r _wr
    _k1 = forall_elim _kac, a
    _k2 = forall_elim _k1, c
    _k3 = forall_elim _k2, b
    _k4 = forall_elim _k3, d
    _k5 = forall_elim _k4, r
    _k6 = implies_elim _k5, _kr
    _k7 = implies_elim _k6, _h1
    _k8 = implies_elim _k7, _h2
    _c1 = and_intro _k8, _er
    _c2 = and_intro _sr, _c1
    _ex = exists_intro _c2, r
    _q1 = forall_elim _pd, b
    _q2 = forall_elim _q1, d
    _q3 = forall_elim _q2, X
    _res = iff_elim_r _q3, _ex
    _cl = exists_intro _res
    _i3 = implies_intro _cl
    _i2 = implies_intro _i3
    _i1 = implies_intro _i2
    _gd = implies_intro _i1
    _fd = forall_intro _gd
    _gc = implies_intro _fd
    _fc = forall_intro _gc
    _gb = implies_intro _fc
    _fb = forall_intro _gb
    _ga = implies_intro _fb
    _fa = forall_intro _ga
    _fX = forall_intro _fa
    qed _fX

proof g1_tmem_at:
    _td = use tmem_def
    _pu = use pair_uniq
    _pc = use g1_pmem_cong
    _eqr = use eq_refl
    fix X
    fix u
    _su = assume set(u)
    fix v
    _sv = assume set(v)
    fix w
    _sw = assume set(w)
    fix p
    _sp = assume set(p)
    _kp = assume kpair(u,v,p)
    _t1 = forall_elim _td, u
    _t2 = forall_elim _t1, v
    _t3 = forall_elim _t2, w
    _t4 = forall_elim _t3, X
    _f = assume tmem(u,v,w,X)
    _fx = iff_elim_l _t4, _f
    _e = exists_elim _fx, p1
    _sp1 = and_elim_l _e
    _e2 = and_elim_r _e
    _kp1 = and_elim_l _e2
    _pm1 = and_elim_r _e2
    _u1 = forall_elim _pu, u
    _u2 = forall_elim _u1, v
    _u3 = forall_elim _u2, p1
    _u4 = forall_elim _u3, p
    _u5 = implies_elim _u4, _kp1
    _eq = implies_elim _u5, _kp
    _ww = forall_elim _eqr, w
    _c1 = forall_elim _pc, X
    _c2 = forall_elim _c1, p1
    _c3 = implies_elim _c2, _sp1
    _c4 = forall_elim _c3, p
    _c5 = implies_elim _c4, _sp
    _c6 = forall_elim _c5, w
    _c7 = implies_elim _c6, _sw
    _c8 = forall_elim _c7, w
    _c9 = implies_elim _c8, _sw
    _c10 = implies_elim _c9, _eq
    _c11 = implies_elim _c10, _ww
    _res = implies_elim _c11, _pm1
    _cl = exists_intro _res
    _fwd = implies_intro _cl
    _g = assume pmem(p,w,X)
    _d1 = and_intro _kp, _g
    _d2 = and_intro _sp, _d1
    _ex = exists_intro _d2, p
    _bk = iff_elim_r _t4, _ex
    _bwd = implies_intro _bk
    _bi = iff_intro _fwd, _bwd
    _ik = implies_intro _bi
    _ip = implies_intro _ik
    _fp = forall_intro _ip
    _iw = implies_intro _fp
    _fw = forall_intro _iw
    _iv = implies_intro _fw
    _fv = forall_intro _iv
    _iu = implies_intro _fv
    _fu = forall_intro _iu
    _fX = forall_intro _fu
    qed _fX

proof g1_inter2:
    _b2 = use B2
    _pe = use pair_ex
    _pa = use pmem_at
    fix A
    fix B
    _x1 = forall_elim _b2, A
    _x2 = forall_elim _x1, B
    _ec = exists_elim _x2, C
    fix u
    _su = assume set(u)
    fix v
    _sv = assume set(v)
    _p1 = forall_elim _pe, u
    _p2 = forall_elim _p1, v
    _p3 = implies_elim _p2, _su
    _p4 = implies_elim _p3, _sv
    _ep = exists_elim _p4, p
    _sp = and_elim_l _ep
    _kp = and_elim_r _ep
    _a1 = forall_elim _pa, u
    _a2 = forall_elim _a1, v
    _a3 = forall_elim _a2, p
    _aC0 = forall_elim _a3, C
    _aC = implies_elim _aC0, _kp
    _aA0 = forall_elim _a3, A
    _aA = implies_elim _aA0, _kp
    _aB0 = forall_elim _a3, B
    _aB = implies_elim _aB0, _kp
    _bp0 = forall_elim _ec, p
    _bp = implies_elim _bp0, _sp
    _f = assume pmem(u,v,C)
    _f1 = iff_elim_l _aC, _f
    _f2 = iff_elim_l _bp, _f1
    _f3 = and_elim_l _f2
    _f4 = and_elim_r _f2
    _f5 = iff_elim_r _aA, _f3
    _f6 = iff_elim_r _aB, _f4
    _f7 = and_intro _f5, _f6
    _fwd = implies_intro _f7
    _g = assume (pmem(u,v,A) & pmem(u,v,B))
    _g1 = and_elim_l _g
    _g2 = and_elim_r _g
    _g3 = iff_elim_l _aA, _g1
    _g4 = iff_elim_l _aB, _g2
    _g5 = and_intro _g3, _g4
    _g6 = iff_elim_r _bp, _g5
    _g7 = iff_elim_r _aC, _g6
    _bwd = implies_intro _g7
    _bi = iff_intro _fwd, _bwd
    _cl = exists_intro _bi
    _iv = implies_intro _cl
    _fv = forall_intro _iv
    _iu = implies_intro _fv
    _fu = forall_intro _iu
    _eC = exists_intro _fu
    _fB = forall_intro _eC
    _fA = forall_intro _fB
    qed _fA

proof cls_place12:
    _b5 = use B5
    _pa = use pmem_at
    fix A
    _x1 = forall_elim _b5, A
    _ec = exists_elim _x1, C
    fix u
    _su = assume set(u)
    fix v
    _sv = assume set(v)
    fix w
    _sw = assume set(w)
    fix q
    _sq = assume set(q)
    _kq = assume kpair(u,v,q)
    _c1 = forall_elim _ec, q
    _c2 = forall_elim _c1, w
    _c3 = implies_elim _c2, _sq
    _c4 = implies_elim _c3, _sw
    _a1 = forall_elim _pa, u
    _a2 = forall_elim _a1, v
    _a3 = forall_elim _a2, q
    _a4 = forall_elim _a3, A
    _a5 = implies_elim _a4, _kq
    _f = assume pmem(q,w,C)
    _f1 = iff_elim_l _c4, _f
    _f2 = iff_elim_r _a5, _f1
    _fwd = implies_intro _f2
    _g = assume pmem(u,v,A)
    _g1 = iff_elim_l _a5, _g
    _g2 = iff_elim_r _c4, _g1
    _bwd = implies_intro _g2
    _bi = iff_intro _fwd, _bwd
    _ik = implies_intro _bi
    _iq = implies_intro _ik
    _fq = forall_intro _iq
    _iw = implies_intro _fq
    _fw = forall_intro _iw
    _iv = implies_intro _fw
    _fv = forall_intro _iv
    _iu = implies_intro _fv
    _fu = forall_intro _iu
    _eC = exists_intro _fu
    _fA = forall_intro _eC
    qed _fA

proof cls_dom3:
    _b4 = use B4
    _pa = use pmem_at
    fix A
    _x1 = forall_elim _b4, A
    _ec = exists_elim _x1, C
    fix u
    _su = assume set(u)
    fix v
    _sv = assume set(v)
    fix q
    _sq = assume set(q)
    _kq = assume kpair(u,v,q)
    _c1 = forall_elim _ec, q
    _c2 = implies_elim _c1, _sq
    _a1 = forall_elim _pa, u
    _a2 = forall_elim _a1, v
    _a3 = forall_elim _a2, q
    _a4 = forall_elim _a3, C
    _a5 = implies_elim _a4, _kq
    _f = assume pmem(u,v,C)
    _f1 = iff_elim_l _a5, _f
    _f2 = iff_elim_l _c2, _f1
    _fwd = implies_intro _f2
    _g = assume (exists w. (set(w) & pmem(q,w,A)))
    _g1 = iff_elim_r _c2, _g
    _g2 = iff_elim_r _a5, _g1
    _bwd = implies_intro _g2
    _bi = iff_intro _fwd, _bwd
    _ik = implies_intro _bi
    _iq = implies_intro _ik
    _fq = forall_intro _iq
    _iv = implies_intro _fq
    _fv = forall_intro _iv
    _iu = implies_intro _fv
    _fu = forall_intro _iu
    _eC = exists_intro _fu
    _fA = forall_intro _eC
    qed _fA

proof cls_place13:
    _b5 = use B5
    _b7 = use B7
    _pa = use pmem_at
    _pe = use pair_ex
    _ta = use g1_tmem_at
    fix A
    _x1 = forall_elim _b5, A
    _eD = exists_elim _x1, D
    _x2 = forall_elim _b7, D
    _eC = exists_elim _x2, C
    fix u
    _su = assume set(u)
    fix v
    _sv = assume set(v)
    fix w
    _sw = assume set(w)
    fix q
    _sq = assume set(q)
    _kq = assume kpair(u,v,q)
    _p1 = forall_elim _pe, u
    _p2 = forall_elim _p1, w
    _p3 = implies_elim _p2, _su
    _p4 = implies_elim _p3, _sw
    _er = exists_elim _p4, r
    _sr = and_elim_l _er
    _kr = and_elim_r _er
    _l1a = forall_elim _ta, C
    _l1b = forall_elim _l1a, u
    _l1c = implies_elim _l1b, _su
    _l1d = forall_elim _l1c, v
    _l1e = implies_elim _l1d, _sv
    _l1f = forall_elim _l1e, w
    _l1g = implies_elim _l1f, _sw
    _l1h = forall_elim _l1g, q
    _l1i = implies_elim _l1h, _sq
    _L1 = implies_elim _l1i, _kq
    _l2a = forall_elim _eC, u
    _l2b = forall_elim _l2a, v
    _l2c = forall_elim _l2b, w
    _l2d = implies_elim _l2c, _su
    _l2e = implies_elim _l2d, _sv
    _L2 = implies_elim _l2e, _sw
    _l3a = forall_elim _ta, D
    _l3b = forall_elim _l3a, u
    _l3c = implies_elim _l3b, _su
    _l3d = forall_elim _l3c, w
    _l3e = implies_elim _l3d, _sw
    _l3f = forall_elim _l3e, v
    _l3g = implies_elim _l3f, _sv
    _l3h = forall_elim _l3g, r
    _l3i = implies_elim _l3h, _sr
    _L3 = implies_elim _l3i, _kr
    _l4a = forall_elim _eD, r
    _l4b = forall_elim _l4a, v
    _l4c = implies_elim _l4b, _sr
    _L4 = implies_elim _l4c, _sv
    _l5a = forall_elim _pa, u
    _l5b = forall_elim _l5a, w
    _l5c = forall_elim _l5b, r
    _l5d = forall_elim _l5c, A
    _L5 = implies_elim _l5d, _kr
    _f = assume pmem(q,w,C)
    _f1 = iff_elim_r _L1, _f
    _f2 = iff_elim_l _L2, _f1
    _f3 = iff_elim_l _L3, _f2
    _f4 = iff_elim_l _L4, _f3
    _f5 = iff_elim_r _L5, _f4
    _fwd = implies_intro _f5
    _g = assume pmem(u,w,A)
    _g1 = iff_elim_l _L5, _g
    _g2 = iff_elim_r _L4, _g1
    _g3 = iff_elim_r _L3, _g2
    _g4 = iff_elim_r _L2, _g3
    _g5 = iff_elim_l _L1, _g4
    _bwd = implies_intro _g5
    _bi = iff_intro _fwd, _bwd
    _cr = exists_intro _bi
    _ik = implies_intro _cr
    _iq = implies_intro _ik
    _fq = forall_intro _iq
    _iw = implies_intro _fq
    _fw = forall_intro _iw
    _iv = implies_intro _fw
    _fv = forall_intro _iv
    _iu = implies_intro _fv
    _fu = forall_intro _iu
    _xC = exists_intro _fu
    _xD = exists_intro _xC
    _fA = forall_intro _xD
    qed _fA

proof cls_place23:
    _b5 = use B5
    _b6 = use B6
    _pa = use pmem_at
    _pe = use pair_ex
    _ta = use g1_tmem_at
    fix A
    _x1 = forall_elim _b5, A
    _eD = exists_elim _x1, D
    _x2 = forall_elim _b6, D
    _eC = exists_elim _x2, C
    fix u
    _su = assume set(u)
    fix v
    _sv = assume set(v)
    fix w
    _sw = assume set(w)
    fix q
    _sq = assume set(q)
    _kq = assume kpair(u,v,q)
    _p1 = forall_elim _pe, v
    _p2 = forall_elim _p1, w
    _p3 = implies_elim _p2, _sv
    _p4 = implies_elim _p3, _sw
    _er = exists_elim _p4, r
    _sr = and_elim_l _er
    _kr = and_elim_r _er
    _l1a = forall_elim _ta, C
    _l1b = forall_elim _l1a, u
    _l1c = implies_elim _l1b, _su
    _l1d = forall_elim _l1c, v
    _l1e = implies_elim _l1d, _sv
    _l1f = forall_elim _l1e, w
    _l1g = implies_elim _l1f, _sw
    _l1h = forall_elim _l1g, q
    _l1i = implies_elim _l1h, _sq
    _L1 = implies_elim _l1i, _kq
    _l2a = forall_elim _eC, u
    _l2b = forall_elim _l2a, v
    _l2c = forall_elim _l2b, w
    _l2d = implies_elim _l2c, _su
    _l2e = implies_elim _l2d, _sv
    _L2 = implies_elim _l2e, _sw
    _l3a = forall_elim _ta, D
    _l3b = forall_elim _l3a, v
    _l3c = implies_elim _l3b, _sv
    _l3d = forall_elim _l3c, w
    _l3e = implies_elim _l3d, _sw
    _l3f = forall_elim _l3e, u
    _l3g = implies_elim _l3f, _su
    _l3h = forall_elim _l3g, r
    _l3i = implies_elim _l3h, _sr
    _L3 = implies_elim _l3i, _kr
    _l4a = forall_elim _eD, r
    _l4b = forall_elim _l4a, u
    _l4c = implies_elim _l4b, _sr
    _L4 = implies_elim _l4c, _su
    _l5a = forall_elim _pa, v
    _l5b = forall_elim _l5a, w
    _l5c = forall_elim _l5b, r
    _l5d = forall_elim _l5c, A
    _L5 = implies_elim _l5d, _kr
    _f = assume pmem(q,w,C)
    _f1 = iff_elim_r _L1, _f
    _f2 = iff_elim_l _L2, _f1
    _f3 = iff_elim_l _L3, _f2
    _f4 = iff_elim_l _L4, _f3
    _f5 = iff_elim_r _L5, _f4
    _fwd = implies_intro _f5
    _g = assume pmem(v,w,A)
    _g1 = iff_elim_l _L5, _g
    _g2 = iff_elim_r _L4, _g1
    _g3 = iff_elim_r _L3, _g2
    _g4 = iff_elim_r _L2, _g3
    _g5 = iff_elim_l _L1, _g4
    _bwd = implies_intro _g5
    _bi = iff_intro _fwd, _bwd
    _cr = exists_intro _bi
    _ik = implies_intro _cr
    _iq = implies_intro _ik
    _fq = forall_intro _iq
    _iw = implies_intro _fq
    _fw = forall_intro _iw
    _iv = implies_intro _fw
    _fv = forall_intro _iv
    _iu = implies_intro _fv
    _fu = forall_intro _iu
    _xC = exists_intro _fu
    _xD = exists_intro _xC
    _fA = forall_intro _xD
    qed _fA

proof cls_conv:
    _b4 = use B4
    _b5 = use B5
    _b6 = use B6
    _b7 = use B7
    _pa = use pmem_at
    _pe = use pair_ex
    _ta = use g1_tmem_at
    fix A
    _x1 = forall_elim _b5, A
    _eD = exists_elim _x1, D
    _x2 = forall_elim _b7, D
    _eX1 = exists_elim _x2, X1
    _x3 = forall_elim _b6, X1
    _eX2 = exists_elim _x3, X2
    _x4 = forall_elim _b4, X2
    _eC = exists_elim _x4, C
    fix u
    _su = assume set(u)
    fix v
    _sv = assume set(v)
    _p1 = forall_elim _pe, u
    _p2 = forall_elim _p1, v
    _p3 = implies_elim _p2, _su
    _p4 = implies_elim _p3, _sv
    _ep = exists_elim _p4, p
    _sp = and_elim_l _ep
    _kp = and_elim_r _ep
    _o1 = forall_elim _pe, v
    _o2 = forall_elim _o1, u
    _o3 = implies_elim _o2, _sv
    _o4 = implies_elim _o3, _su
    _eo = exists_elim _o4, o
    _so = and_elim_l _eo
    _ko = and_elim_r _eo
    _l1a = forall_elim _pa, u
    _l1b = forall_elim _l1a, v
    _l1c = forall_elim _l1b, p
    _l1d = forall_elim _l1c, C
    _L1 = implies_elim _l1d, _kp
    _l2a = forall_elim _eC, p
    _L2 = implies_elim _l2a, _sp
    _l7a = forall_elim _pa, v
    _l7b = forall_elim _l7a, u
    _l7c = forall_elim _l7b, o
    _l7d = forall_elim _l7c, A
    _L7 = implies_elim _l7d, _ko
    fix c
    _sc = assume set(c)
    _m1a = forall_elim _ta, X2
    _m1b = forall_elim _m1a, u
    _m1c = implies_elim _m1b, _su
    _m1d = forall_elim _m1c, v
    _m1e = implies_elim _m1d, _sv
    _m1f = forall_elim _m1e, c
    _m1g = implies_elim _m1f, _sc
    _m1h = forall_elim _m1g, p
    _m1i = implies_elim _m1h, _sp
    _M1 = implies_elim _m1i, _kp
    _m2a = forall_elim _eX2, u
    _m2b = forall_elim _m2a, v
    _m2c = forall_elim _m2b, c
    _m2d = implies_elim _m2c, _su
    _m2e = implies_elim _m2d, _sv
    _M2 = implies_elim _m2e, _sc
    _m3a = forall_elim _eX1, v
    _m3b = forall_elim _m3a, c
    _m3c = forall_elim _m3b, u
    _m3d = implies_elim _m3c, _sv
    _m3e = implies_elim _m3d, _sc
    _M3 = implies_elim _m3e, _su
    _m4a = forall_elim _ta, D
    _m4b = forall_elim _m4a, v
    _m4c = implies_elim _m4b, _sv
    _m4d = forall_elim _m4c, u
    _m4e = implies_elim _m4d, _su
    _m4f = forall_elim _m4e, c
    _m4g = implies_elim _m4f, _sc
    _m4h = forall_elim _m4g, o
    _m4i = implies_elim _m4h, _so
    _M4 = implies_elim _m4i, _ko
    _m5a = forall_elim _eD, o
    _m5b = forall_elim _m5a, c
    _m5c = implies_elim _m5b, _so
    _M5 = implies_elim _m5c, _sc
    _h = assume pmem(p,c,X2)
    _h1 = iff_elim_r _M1, _h
    _h2 = iff_elim_l _M2, _h1
    _h3 = iff_elim_l _M3, _h2
    _h4 = iff_elim_l _M4, _h3
    _h5 = iff_elim_l _M5, _h4
    _hf = implies_intro _h5
    _k = assume elem(o,A)
    _k1 = iff_elim_r _M5, _k
    _k2 = iff_elim_r _M4, _k1
    _k3 = iff_elim_r _M3, _k2
    _k4 = iff_elim_r _M2, _k3
    _k5 = iff_elim_l _M1, _k4
    _kb = implies_intro _k5
    _mi = iff_intro _hf, _kb
    _mic = implies_intro _mi
    _Mall = forall_intro _mic
    _f = assume pmem(u,v,C)
    _f1 = iff_elim_l _L1, _f
    _f2 = iff_elim_l _L2, _f1
    _ee = exists_elim _f2, e
    _se = and_elim_l _ee
