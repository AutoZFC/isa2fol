    _o3 = forall_elim _o2, y
    _h6 = implies_elim _o3, _sy
    _j15 = schema_inst iff_trans { A: pmem(x,y,C), B: (~ pmem(x,y,K5)), C: (~ (exists z. (set(z) & (~ (elem(z,x) <-> elem(z,y)))))) }
    _j16 = implies_elim _j15, _h6
    _j17 = implies_elim _j16, _cn4
    _j18 = schema_inst iff_trans { A: pmem(x,y,C), B: (~ (exists z. (set(z) & (~ (elem(z,x) <-> elem(z,y)))))), C: (forall z. (set(z) -> (elem(z,x) <-> elem(z,y)))) }
    _j19 = implies_elim _j18, _j17
    _j20 = implies_elim _j19, _fn
    _j21 = schema_inst iff_trans { A: pmem(x,y,C), B: (forall z. (set(z) -> (elem(z,x) <-> elem(z,y)))), C: eq(x,y) }
    _j22 = implies_elim _j21, _j20
    _res = implies_elim _j22, _eg2
    _cl = exists_intro _res
    _iy = implies_intro _cl
    _fy = forall_intro _iy
    _ix = implies_intro _fy
    _fx = forall_intro _ix
    _z1 = exists_intro _fx
    _z2 = exists_intro _z1
    _z3 = exists_intro _z2
    _z4 = exists_intro _z3
    _z5 = exists_intro _z4
    _z6 = exists_intro _z5
    _z7 = exists_intro _z6
    _z8 = exists_intro _z7
    qed _z8

