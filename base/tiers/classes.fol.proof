    _r2 = implies_elim _r1, _sa
    _f0 = assume elem(a,C)
    _f1 = iff_elim_l _hC, _f0
    _f2 = exists_elim _f1, u
    _su = and_elim_l _f2
    _f3 = and_elim_r _f2
    _f4 = forall_elim _i2, u
    _f5 = implies_elim _f4, _su
    _f6 = iff_elim_l _f5, _f3
    _f7 = and_elim_l _f6
    _f8 = and_elim_r _f6
    _f9 = forall_elim _q2, u
    _f10 = implies_elim _f9, _su
    _piu = iff_elim_l _f10, _f7
    _f11 = forall_elim _r2, u
    _f12 = implies_elim _f11, _su
    _pju = iff_elim_l _f12, _f8
    _x1 = forall_elim _xe, a
    _x2 = forall_elim _x1, j
    _x3 = forall_elim _x2, u
    _x4 = implies_elim _x3, _su
    _x5 = implies_elim _x4, _pju
    _f13 = and_intro _piu, _x5
    _f14 = and_intro _su, _f13
    _f15 = exists_intro _f14, u
    _f16 = exists_intro _f15
    _fwd = implies_intro _f16
    _g0 = assume (exists u. (set(u) & (pmem(i,u,a) & (exists v. (set(v) & (pmem(j,v,a) & eq(u,v)))))))
    _g1 = exists_elim _g0, w
    _sw = and_elim_l _g1
    _g2 = and_elim_r _g1
    _piw = and_elim_l _g2
    _g3 = and_elim_r _g2
    _g4 = exists_elim _g3, v
    _g5 = and_elim_r _g4
    _pjv = and_elim_l _g5
    _ewv = and_elim_r _g5
    _k1 = forall_elim _pc, j
    _k2 = forall_elim _k1, w
    _k3 = forall_elim _k2, v
    _k4 = forall_elim _k3, a
    _k5 = implies_elim _k4, _ewv
    _pjw = implies_elim _k5, _pjv
    _g6 = forall_elim _q2, w
    _g7 = implies_elim _g6, _sw
    _g8 = iff_elim_r _g7, _piw
    _g9 = forall_elim _r2, w
    _g10 = implies_elim _g9, _sw
    _g11 = iff_elim_r _g10, _pjw
    _g12 = and_intro _g8, _g11
    _g13 = forall_elim _i2, w
    _g14 = implies_elim _g13, _sw
    _g15 = iff_elim_r _g14, _g12
    _g16 = and_intro _sw, _g15
    _g17 = exists_intro _g16, w
    _g18 = iff_elim_r _hC, _g17
    _g19 = exists_intro _g18
    _g20 = exists_intro _g19
    _bwd = implies_intro _g20
    _bi = iff_intro _fwd, _bwd
    _ia = implies_intro _bi
    _fa = forall_intro _ia
    _z1 = exists_intro _fa
    _z2 = exists_intro _z1
    _z3 = exists_intro _z2
    _z4 = exists_intro _z3
    _ij = implies_intro _z4
    _fj = forall_intro _ij
    _ii = implies_intro _fj
    _fi = forall_intro _ii
    qed _fi

proof cls_diag:
    _b1 = use B1
