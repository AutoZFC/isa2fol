proof row_all:
    fix k
    _h1 = assume set(k)
    fix A
    _b3 = use B3
    _re = use row_ex
    _x1 = forall_elim _b3, A
    _e1 = exists_elim _x1, NA
    _x2 = forall_elim _re, k
    _x3 = implies_elim _x2, _h1
    _x4 = forall_elim _x3, NA
    _e2 = exists_elim _x4, E
    _x5 = forall_elim _b3, E
    _e3 = exists_elim _x5, C
    fix a
    _sa = assume set(a)
    _y1 = forall_elim _e2, a
    _pe = implies_elim _y1, _sa
    _y2 = forall_elim _e3, a
    _pc = implies_elim _y2, _sa
    _f0 = assume elem(a,C)
    _f1 = iff_elim_l _pc, _f0
    fix v
    _sv = assume set(v)
    fix b
    _sb = assume set(b)
    _sn = assume snoc(a,k,v,b)
    _f2 = assume (~ elem(b,A))
    _y3 = forall_elim _e1, b
    _pn = implies_elim _y3, _sb
    _f3 = iff_elim_r _pn, _f2
    _f4 = and_intro _sn, _f3
    _f5 = and_intro _sb, _f4
    _f6 = exists_intro _f5, b
    _f7 = and_intro _sv, _f6
    _f8 = exists_intro _f7, v
    _f9 = iff_elim_r _pe, _f8
    _f10 = not_elim _f1, _f9
    _f11 = not_intro _f10
    _f12 = double_neg_elim _f11
    _f13 = implies_intro _f12
    _f14 = implies_intro _f13
    _f15 = forall_intro _f14
    _f16 = implies_intro _f15
    _f17 = forall_intro _f16
    _fwd = implies_intro _f17
