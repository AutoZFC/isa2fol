    _v7 = forall_elim _v6, q
    _v8 = implies_elim _v7, _sq
    _h2 = implies_elim _v8, _kq
    _w1 = forall_elim _eF, x
    _w2 = implies_elim _w1, _sx
    _w3 = forall_elim _w2, z
    _hFx = implies_elim _w3, _sz
    _w4 = forall_elim _eF, y
    _w5 = implies_elim _w4, _sy
    _w6 = forall_elim _w5, z
    _hFy = implies_elim _w6, _sz
    _e1 = forall_elim _eE, z
    _e2 = forall_elim _e1, x
    _e3 = implies_elim _e2, _sz
    _hEx = implies_elim _e3, _sx
    _e4 = forall_elim _e1, y
    _e5 = implies_elim _e4, _sz
    _hEy = implies_elim _e5, _sy
    _j1 = schema_inst iff_trans { A: pmem(q,z,K1), B: pmem(x,z,F), C: pmem(z,x,E) }
    _j2 = implies_elim _j1, _h1
    _j3 = implies_elim _j2, _hFx
    _j4 = schema_inst iff_trans { A: pmem(q,z,K1), B: pmem(z,x,E), C: elem(z,x) }
    _j5 = implies_elim _j4, _j3
    _gx = implies_elim _j5, _hEx
    _l1 = schema_inst iff_trans { A: pmem(q,z,K2), B: pmem(y,z,F), C: pmem(z,y,E) }
    _l2 = implies_elim _l1, _h2
    _l3 = implies_elim _l2, _hFy
    _l4 = schema_inst iff_trans { A: pmem(q,z,K2), B: pmem(z,y,E), C: elem(z,y) }
    _l5 = implies_elim _l4, _l3
    _gy = implies_elim _l5, _hEy
    _ci = schema_inst cong_iff { A: pmem(q,z,K1), A2: elem(z,x), B: pmem(q,z,K2), B2: elem(z,y) }
    _ci2 = implies_elim _ci, _gx
    _ci3 = implies_elim _ci2, _gy
    _j7 = schema_inst iff_trans { A: pmem(q,z,K3), B: (pmem(q,z,K1) <-> pmem(q,z,K2)), C: (elem(z,x) <-> elem(z,y)) }
    _j8 = implies_elim _j7, _h3
    _j9 = implies_elim _j8, _ci3
    _cn = schema_inst cong_not { A: pmem(q,z,K3), B: (elem(z,x) <-> elem(z,y)) }
    _cn2 = implies_elim _cn, _j9
    _j10 = schema_inst iff_trans { A: pmem(q,z,K4), B: (~ pmem(q,z,K3)), C: (~ (elem(z,x) <-> elem(z,y))) }
    _j11 = implies_elim _j10, _h4
    _hz = implies_elim _j11, _cn2
    _iz = implies_intro _hz
    _fz = forall_intro _iz
    _ce = schema_inst cong_exists { P: \z. pmem(q,z,K4), Q: \z. (~ (elem(z,x) <-> elem(z,y))) }
    _ce2 = implies_elim _ce, _fz
