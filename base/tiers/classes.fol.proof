    _m5 = forall_elim _m4, q
    _m6 = implies_elim _m5, _sq
    _h5 = implies_elim _m6, _kq
    _j12 = schema_inst iff_trans { A: pmem(x,y,K5), B: (exists w. (set(w) & pmem(q,w,K4))), C: (exists z. (set(z) & (~ (elem(z,x) <-> elem(z,y))))) }
    _j13 = implies_elim _j12, _h5
    _j14 = implies_elim _j13, _ce2
    _cn3 = schema_inst cong_not { A: pmem(x,y,K5), B: (exists z. (set(z) & (~ (elem(z,x) <-> elem(z,y))))) }
    _cn4 = implies_elim _cn3, _j14
    _fn = schema_inst forall_as_nexists { P: \z. (elem(z,x) <-> elem(z,y)) }
    _eg1 = forall_elim _eg, x
    _eg2 = forall_elim _eg1, y
    _o1 = forall_elim _eC, x
