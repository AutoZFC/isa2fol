    _kq = and_elim_r _eq
    fix z
    _sz = assume set(z)
    _t1 = forall_elim _eK4, q
    _t2 = implies_elim _t1, _sq
    _t3 = forall_elim _t2, z
    _h4 = implies_elim _t3, _sz
    _t4 = forall_elim _eK3, q
    _t5 = implies_elim _t4, _sq
    _t6 = forall_elim _t5, z
    _h3 = implies_elim _t6, _sz
    _u1 = forall_elim _eK1, x
    _u2 = implies_elim _u1, _sx
    _u3 = forall_elim _u2, y
    _u4 = implies_elim _u3, _sy
    _u5 = forall_elim _u4, z
    _u6 = implies_elim _u5, _sz
    _u7 = forall_elim _u6, q
