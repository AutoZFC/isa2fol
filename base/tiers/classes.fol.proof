proof g2_pcompl:
    _b3 = use B3
    _pe = use pair_ex
    _pa = use pmem_at
    fix A
    _x1 = forall_elim _b3, A
    _eC = exists_elim _x1, C
    fix u
    _su = assume set(u)
    fix v
    _sv = assume set(v)
    _p1 = forall_elim _pe, u
    _p2 = forall_elim _p1, v
    _p3 = implies_elim _p2, _su
    _p4 = implies_elim _p3, _sv
    _ep = exists_elim _p4, p
    _sp = and_elim_l _ep
    _kp = and_elim_r _ep
    _c1 = forall_elim _eC, p
    _cp = implies_elim _c1, _sp
    _a1 = forall_elim _pa, u
    _a2 = forall_elim _a1, v
    _a3 = forall_elim _a2, p
    _aC0 = forall_elim _a3, C
    _aC = implies_elim _aC0, _kp
    _aA0 = forall_elim _a3, A
    _aA = implies_elim _aA0, _kp
    _f0 = assume pmem(u,v,C)
    _f1 = iff_elim_l _aC, _f0
    _f2 = iff_elim_l _cp, _f1
    _f3 = assume pmem(u,v,A)
    _f4 = iff_elim_l _aA, _f3
    _f5 = not_elim _f2, _f4
    _f6 = not_intro _f5
    _fwd = implies_intro _f6
    _g0 = assume (~ pmem(u,v,A))
    _g1 = assume elem(p,A)
    _g2 = iff_elim_r _aA, _g1
    _g3 = not_elim _g0, _g2
    _g4 = not_intro _g3
    _g5 = iff_elim_r _cp, _g4
    _g6 = iff_elim_r _aC, _g5
    _bwd = implies_intro _g6
    _bi = iff_intro _fwd, _bwd
    _cl = exists_intro _bi
    _iv = implies_intro _cl
    _fv = forall_intro _iv
    _iu = implies_intro _fv
    _fu = forall_intro _iu
    _ex = exists_intro _fu
    _fA = forall_intro _ex
    qed _fA

proof g2_piff:
    _bf = use B_iff
    _pe = use pair_ex
    _pa = use pmem_at
    fix A
    fix B
    _x1 = forall_elim _bf, A
    _x2 = forall_elim _x1, B
    _eC = exists_elim _x2, C
    fix u
    _su = assume set(u)
    fix v
    _sv = assume set(v)
    _p1 = forall_elim _pe, u
    _p2 = forall_elim _p1, v
    _p3 = implies_elim _p2, _su
    _p4 = implies_elim _p3, _sv
    _ep = exists_elim _p4, p
    _sp = and_elim_l _ep
    _kp = and_elim_r _ep
    _c1 = forall_elim _eC, p
    _cp = implies_elim _c1, _sp
    _a1 = forall_elim _pa, u
    _a2 = forall_elim _a1, v
    _a3 = forall_elim _a2, p
    _aC0 = forall_elim _a3, C
    _aC = implies_elim _aC0, _kp
    _aA0 = forall_elim _a3, A
    _aA = implies_elim _aA0, _kp
    _aB0 = forall_elim _a3, B
    _aB = implies_elim _aB0, _kp
    _ci = schema_inst cong_iff { A: pmem(u,v,A), A2: elem(p,A), B: pmem(u,v,B), B2: elem(p,B) }
    _c2 = implies_elim _ci, _aA
    _c3 = implies_elim _c2, _aB
    _f0 = assume pmem(u,v,C)
    _f1 = iff_elim_l _aC, _f0
    _f2 = iff_elim_l _cp, _f1
    _f3 = iff_elim_r _c3, _f2
    _fwd = implies_intro _f3
    _g0 = assume (pmem(u,v,A) <-> pmem(u,v,B))
    _g1 = iff_elim_l _c3, _g0
    _g2 = iff_elim_r _cp, _g1
    _g3 = iff_elim_r _aC, _g2
    _bwd = implies_intro _g3
    _bi = iff_intro _fwd, _bwd
    _cl = exists_intro _bi
    _iv = implies_intro _cl
    _fv = forall_intro _iv
    _iu = implies_intro _fv
    _fu = forall_intro _iu
    _ex = exists_intro _fu
    _fB = forall_intro _ex
    _fA = forall_intro _fB
    qed _fA

proof g2_pmem_cong:
    _pd = use pmem_def
    _kc = use kpair_arg_cong
    _er = use eq_refl
    _es = use eq_symm
    fix j
    fix u
    fix v
    fix a
    _h1 = assume eq(u,v)
    _h2 = assume pmem(j,v,a)
    _d1 = forall_elim _pd, j
    _d2 = forall_elim _d1, v
    _d3 = forall_elim _d2, a
    _d4 = iff_elim_l _d3, _h2
    _ep = exists_elim _d4, p
    _sp = and_elim_l _ep
    _r = and_elim_r _ep
    _kp = and_elim_l _r
    _pa = and_elim_r _r
    _y1 = forall_elim _es, u
    _y2 = forall_elim _y1, v
    _vu = implies_elim _y2, _h1
    _jj = forall_elim _er, j
    _k1 = forall_elim _kc, j
    _k2 = forall_elim _k1, v
    _k3 = forall_elim _k2, j
    _k4 = forall_elim _k3, u
    _k5 = forall_elim _k4, p
    _k6 = implies_elim _k5, _kp
    _k7 = implies_elim _k6, _jj
    _k8 = implies_elim _k7, _vu
    _c1 = and_intro _k8, _pa
    _c2 = and_intro _sp, _c1
    _c3 = exists_intro _c2, p
    _n1 = forall_elim _pd, j
    _n2 = forall_elim _n1, u
    _n3 = forall_elim _n2, a
    _r1 = iff_elim_r _n3, _c3
    _cl = exists_intro _r1
    _i2 = implies_intro _cl
    _i1 = implies_intro _i2
    _fa = forall_intro _i1
    _fv = forall_intro _fa
    _fu = forall_intro _fv
    _fj = forall_intro _fu
    qed _fj

proof g2_ex_eq:
    _er = use eq_refl
    fix a
    fix j
    fix u0
    fix w
    _h1 = assume eq(u0,w)
    _h2 = assume set(w)
    _h3 = assume pmem(j,w,a)
    _c1 = and_intro _h3, _h1
    _c2 = and_intro _h2, _c1
    _ex = exists_intro _c2, w
    _i3 = implies_intro _ex
    _i2 = implies_intro _i3
    _i1 = implies_intro _i2
    _fw = forall_intro _i1
    _fu0 = forall_intro _fw
    fix u
    _su = assume set(u)
    _pu = assume pmem(j,u,a)
    _k1 = forall_elim _fu0, u
    _k2 = forall_elim _k1, u
    _ruu = forall_elim _er, u
    _k3 = implies_elim _k2, _ruu
    _k4 = implies_elim _k3, _su
    _k5 = implies_elim _k4, _pu
    _i5 = implies_intro _k5
    _i4 = implies_intro _i5
    _gu = forall_intro _i4
    _gj = forall_intro _gu
    _ga = forall_intro _gj
    qed _ga

proof row_eq:
    _ap = use row_app
    _pn = use g1_inter2
    _b4 = use B4
    _pc = use g2_pmem_cong
    _xe = use g2_ex_eq
    fix i
    _si = assume set(i)
    fix j
    _sj = assume set(j)
    _a1 = forall_elim _ap, i
    _a2 = implies_elim _a1, _si
    _eCi = exists_elim _a2, Ci
    _a3 = forall_elim _ap, j
    _a4 = implies_elim _a3, _sj
    _eCj = exists_elim _a4, Cj
    _n1 = forall_elim _pn, Ci
    _n2 = forall_elim _n1, Cj
    _eI = exists_elim _n2, I
    _b1 = forall_elim _b4, I
    _eC = exists_elim _b1, C
    fix a
    _sa = assume set(a)
    _c1 = forall_elim _eC, a
    _hC = implies_elim _c1, _sa
    _i1 = forall_elim _eI, a
    _i2 = implies_elim _i1, _sa
    _q1 = forall_elim _eCi, a
    _q2 = implies_elim _q1, _sa
