proof rs_key:
    _pe = use pair_ex
    fix S
    _hS = assume (forall v. (set(v) -> (forall w. (set(w) -> (forall u. (set(u) -> (forall x. (set(x) -> (forall p. (set(p) -> (forall q. (set(q) -> (kpair(v,w,p) -> (kpair(p,u,q) -> (pmem(q,x,S) <-> snoc(u,v,w,x))))))))))))))))
    fix u
    _su = assume set(u)
    fix v
    _sv = assume set(v)
    fix w
    _sw = assume set(w)
    fix x
    _sx = assume set(x)
    _hE = assume (exists p. (set(p) & (kpair(v,w,p) & (exists q. (set(q) & (kpair(p,u,q) & pmem(q,x,S)))))))
    _eP = exists_elim _hE, Pf
    _sPf = and_elim_l _eP
    _f1 = and_elim_r _eP
    _kPf = and_elim_l _f1
    _f2 = and_elim_r _f1
    _eQ = exists_elim _f2, Qf
    _sQf = and_elim_l _eQ
    _f3 = and_elim_r _eQ
    _kQf = and_elim_l _f3
    _mQf = and_elim_r _f3
    _a1 = forall_elim _hS, v
    _a2 = implies_elim _a1, _sv
    _a3 = forall_elim _a2, w
    _a4 = implies_elim _a3, _sw
    _a5 = forall_elim _a4, u
    _a6 = implies_elim _a5, _su
    _a7 = forall_elim _a6, x
    _a8 = implies_elim _a7, _sx
    _a9 = forall_elim _a8, Pf
    _a10 = implies_elim _a9, _sPf
    _a11 = forall_elim _a10, Qf
    _a12 = implies_elim _a11, _sQf
    _a13 = implies_elim _a12, _kPf
    _a14 = implies_elim _a13, _kQf
    _f4 = iff_elim_l _a14, _mQf
    _f5 = exists_intro _f4
