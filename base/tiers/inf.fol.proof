proof nimp_as_and:
    _h1 = assume (A & (~ B))
    _h2 = assume (A -> B)
    _h3 = and_elim_l _h1
    _h4 = implies_elim _h2, _h3
    _h5 = and_elim_r _h1
    _h6 = not_elim _h5, _h4
    _h7 = not_intro _h6
    _h8 = implies_intro _h7
    _h9 = assume (~ (A -> B))
    _h10 = assume B
    _h11 = assume A
    _h12 = implies_intro _h10
    _h13 = not_elim _h9, _h12
    _h14 = not_intro _h13
    _h15 = assume (~ A)
    _h16 = assume A
    _h17 = not_elim _h15, _h16
    _h18 = let B
    _h19 = bottom_elim _h17, _h18
    _h20 = implies_intro _h19
    _h21 = not_elim _h9, _h20
    _h22 = not_intro _h21
    _h23 = double_neg_elim _h22
    _h24 = and_intro _h23, _h14
    _h25 = implies_intro _h24
    _h26 = iff_intro _h8, _h25
    qed _h26

proof empty_eq:
    _h1 = use extensionality
    fix e
    fix e2
    _h2 = assume (forall u. (set(u) -> (~ elem(u,e))))
    _h3 = assume (forall u. (set(u) -> (~ elem(u,e2))))
    fix u
    _h4 = assume set(u)
    _h5 = assume elem(u,e)
    _h6 = forall_elim _h2, u
    _h7 = implies_elim _h6, _h4
    _h8 = not_elim _h7, _h5
    _h9 = let elem(u,e2)
    _h10 = bottom_elim _h8, _h9
    _h11 = implies_intro _h10
    _h12 = assume elem(u,e2)
    _h13 = forall_elim _h3, u
    _h14 = implies_elim _h13, _h4
    _h15 = not_elim _h14, _h12
    _h16 = let elem(u,e)
    _h17 = bottom_elim _h15, _h16
    _h18 = implies_intro _h17
    _h19 = iff_intro _h11, _h18
    _h20 = implies_intro _h19
    _h21 = forall_intro _h20
    _h22 = forall_elim _h1, e
    _h23 = forall_elim _h22, e2
    _h24 = iff_elim_r _h23, _h21
    _h25 = implies_intro _h24
    _h26 = implies_intro _h25
    _h27 = forall_intro _h26
    _h28 = forall_intro _h27
    qed _h28

proof succ_eq:
    _h1 = use extensionality
    fix y
    fix s
    fix s2
    _h2 = assume (forall w. (set(w) -> (elem(w,s) <-> (elem(w,y) | eq(w,y)))))
    _h3 = assume (forall w. (set(w) -> (elem(w,s2) <-> (elem(w,y) | eq(w,y)))))
    fix u
    _h4 = assume set(u)
    _h5 = forall_elim _h2, u
    _h6 = implies_elim _h5, _h4
    _h7 = forall_elim _h3, u
    _h8 = implies_elim _h7, _h4
    _h9 = schema_inst iff_symm { A: elem(u,s2), B: (elem(u,y) | eq(u,y)) }
    _h10 = implies_elim _h9, _h8
    _h11 = schema_inst iff_trans { A: elem(u,s), B: (elem(u,y) | eq(u,y)), C: elem(u,s2) }
    _h12 = implies_elim _h11, _h6
    _h13 = implies_elim _h12, _h10
    _h14 = implies_intro _h13
    _h15 = forall_intro _h14
    _h16 = forall_elim _h1, s
    _h17 = forall_elim _h16, s2
    _h18 = iff_elim_r _h17, _h15
    _h19 = implies_intro _h18
    _h20 = implies_intro _h19
    _h21 = forall_intro _h20
    _h22 = forall_intro _h21
    _h23 = forall_intro _h22
    qed _h23

