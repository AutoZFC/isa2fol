proof step_and:
    _b2 = use B2
    _pd = use pmem_def
    _pu = use pair_uniq
    _efs = use elem_first_subst
    _ps = use pair_set
    fix A
    fix B
    _b2A = forall_elim _b2, A
    _b2B = forall_elim _b2A, B
    _eC = exists_elim _b2B, C
    fix x
    fix y
    _sx = assume set(x)
    _sy = assume set(y)
    _q1 = forall_elim _pd, x
    _q2 = forall_elim _q1, y
    _pdefC = forall_elim _q2, C
    _pdefA = forall_elim _q2, A
    _pdefB = forall_elim _q2, B
    _f = assume pmem(x,y,C)
    _fu = iff_elim_l _pdefC, _f
    _ep = exists_elim _fu, p
    _sgP = and_elim_l _ep
    _epr = and_elim_r _ep
    _kp = and_elim_l _epr
    _pC = and_elim_r _epr
    _s1 = forall_elim _ps, x
    _s2 = forall_elim _s1, y
    _s3 = forall_elim _s2, p
    _s4 = implies_elim _s3, _sx
    _s5 = implies_elim _s4, _sy
    _sp = implies_elim _s5, _kp
    _c1 = forall_elim _eC, p
    _c2 = implies_elim _c1, _sp
    _conj = iff_elim_l _c2, _pC
    _pA = and_elim_l _conj
    _pB = and_elim_r _conj
    _ka = and_intro _kp, _pA
    _kag = and_intro _sgP, _ka
    _exa = exists_intro _kag, p
    _pmA = iff_elim_r _pdefA, _exa
    _kb = and_intro _kp, _pB
    _kbg = and_intro _sgP, _kb
    _exb = exists_intro _kbg, p
    _pmB = iff_elim_r _pdefB, _exb
    _res = and_intro _pmA, _pmB
    _cl = exists_intro _res
    _fwd = implies_intro _cl
    _g = assume (pmem(x,y,A) & pmem(x,y,B))
    _gA = and_elim_l _g
    _gB = and_elim_r _g
    _ua = iff_elim_l _pdefA, _gA
    _epa = exists_elim _ua, pa
    _sgA = and_elim_l _epa
    _epar = and_elim_r _epa
    _kpa = and_elim_l _epar
    _paA = and_elim_r _epar
    _ub = iff_elim_l _pdefB, _gB
    _epb = exists_elim _ub, pb
    _sgB = and_elim_l _epb
    _epbr = and_elim_r _epb
    _kpb = and_elim_l _epbr
    _pbB = and_elim_r _epbr
    _u1 = forall_elim _pu, x
    _u2 = forall_elim _u1, y
    _u3 = forall_elim _u2, pb
    _u4 = forall_elim _u3, pa
    _u5 = implies_elim _u4, _kpb
    _eqba = implies_elim _u5, _kpa
    _e1 = forall_elim _efs, pb
    _e2 = forall_elim _e1, pa
    _e3 = forall_elim _e2, B
    _e4 = implies_elim _e3, _eqba
    _paB = implies_elim _e4, _pbB
    _t1 = forall_elim _ps, x
    _t2 = forall_elim _t1, y
    _t3 = forall_elim _t2, pa
    _t4 = implies_elim _t3, _sx
    _t5 = implies_elim _t4, _sy
    _spa = implies_elim _t5, _kpa
    _d1 = forall_elim _eC, pa
    _d2 = implies_elim _d1, _spa
    _cj = and_intro _paA, _paB
    _paC = iff_elim_r _d2, _cj
    _k = and_intro _kpa, _paC
    _kg = and_intro _sgA, _k
    _ex = exists_intro _kg, pa
    _res2 = iff_elim_r _pdefC, _ex
    _cl1 = exists_intro _res2
    _cl2 = exists_intro _cl1
    _bwd = implies_intro _cl2
    _bi = iff_intro _fwd, _bwd
    _i1 = implies_intro _bi
    _i2 = implies_intro _i1
    _g1 = forall_intro _i2
    _g2 = forall_intro _g1
    _clC = exists_intro _g2
    _gB2 = forall_intro _clC
    _gA2 = forall_intro _gB2
    qed _gA2

proof step_not:
    _b3 = use B3
    _pd = use pmem_def
    _pe = use pair_ex
    _pu = use pair_uniq
    _efs = use elem_first_subst
    _ps = use pair_set
    fix A
    _b3A = forall_elim _b3, A
    _eC = exists_elim _b3A, C
    fix x
    fix y
    _sx = assume set(x)
    _sy = assume set(y)
    _q1 = forall_elim _pd, x
    _q2 = forall_elim _q1, y
    _pdefC = forall_elim _q2, C
    _pdefA = forall_elim _q2, A
    _f = assume pmem(x,y,C)
    _fu = iff_elim_l _pdefC, _f
    _ep = exists_elim _fu, p
    _sgP = and_elim_l _ep
    _epr = and_elim_r _ep
    _kp = and_elim_l _epr
    _pC = and_elim_r _epr
    _s1 = forall_elim _ps, x
    _s2 = forall_elim _s1, y
    _s3 = forall_elim _s2, p
    _s4 = implies_elim _s3, _sx
    _s5 = implies_elim _s4, _sy
    _sp = implies_elim _s5, _kp
    _c1 = forall_elim _eC, p
    _c2 = implies_elim _c1, _sp
    _npA = iff_elim_l _c2, _pC
    _h = assume pmem(x,y,A)
    _hu = iff_elim_l _pdefA, _h
    _eqq = exists_elim _hu, q
    _sgQ = and_elim_l _eqq
    _eqqr = and_elim_r _eqq
    _kq = and_elim_l _eqqr
    _qA = and_elim_r _eqqr
    _u1 = forall_elim _pu, x
    _u2 = forall_elim _u1, y
    _u3 = forall_elim _u2, q
    _u4 = forall_elim _u3, p
    _u5 = implies_elim _u4, _kq
    _eqp = implies_elim _u5, _kp
    _e1 = forall_elim _efs, q
    _e2 = forall_elim _e1, p
    _e3 = forall_elim _e2, A
    _e4 = implies_elim _e3, _eqp
    _pA = implies_elim _e4, _qA
    _bot = not_elim _npA, _pA
    _clq = exists_intro _bot
    _neg = not_intro _clq
    _cl2 = exists_intro _neg
    _fwd = implies_intro _cl2
    _g = assume (~ pmem(x,y,A))
    _p1 = forall_elim _pe, x
    _p2 = forall_elim _p1, y
    _p3 = implies_elim _p2, _sx
    _p4 = implies_elim _p3, _sy
    _er = exists_elim _p4, r
    _sr = and_elim_l _er
    _kr = and_elim_r _er
    _h2 = assume elem(r,A)
    _k2 = and_intro _kr, _h2
    _k2g = and_intro _sr, _k2
    _ex2 = exists_intro _k2g, r
    _pmA = iff_elim_r _pdefA, _ex2
    _bot2 = not_elim _g, _pmA
    _nrA = not_intro _bot2
    _d1 = forall_elim _eC, r
    _d2 = implies_elim _d1, _sr
    _rC = iff_elim_r _d2, _nrA
    _k3 = and_intro _kr, _rC
    _k3g = and_intro _sr, _k3
    _ex3 = exists_intro _k3g, r
    _res = iff_elim_r _pdefC, _ex3
    _cl3 = exists_intro _res
    _bwd = implies_intro _cl3
    _bi = iff_intro _fwd, _bwd
    _i1 = implies_intro _bi
    _i2 = implies_intro _i1
    _g1 = forall_intro _i2
    _g2 = forall_intro _g1
    _clC = exists_intro _g2
    _gA2 = forall_intro _clC
    qed _gA2
