proof Inf_side_condition:
    _i = use infinity
    qed _i

proof Inf_EX:
    _i = use Inf_intro
    _e = exists_elim _i, r0
    _s = and_elim_l _e
    _rest = and_elim_r _e
    _ir = and_elim_l _rest
    _cj = and_intro _s, _ir
    _x = exists_intro _cj, r0
    _cl = exists_intro _x
    qed _cl

proof Inf_UNIQ:
    _i = use Inf_intro
    _sym = use eq_symm
    _tr = use eq_trans
    fix r
    _sr = assume set(r)
    fix s
    _ss = assume set(s)
    _hr = assume Inf(r)
    _hs = assume Inf(s)
    _e = exists_elim _i, r0
    _rest = and_elim_r _e
    _uni = and_elim_r _rest
    _a1 = forall_elim _uni, r
    _e0r = implies_elim _a1, _hr
    _a2 = forall_elim _uni, s
    _e0s = implies_elim _a2, _hs
    _y1 = forall_elim _sym, r0
    _y2 = forall_elim _y1, r
    _er0 = implies_elim _y2, _e0r
    _t1 = forall_elim _tr, r
    _t2 = forall_elim _t1, r0
    _t3 = forall_elim _t2, s
    _t4 = implies_elim _t3, _er0
    _res = implies_elim _t4, _e0s
    _cl = exists_intro _res
    _o1 = implies_intro _cl
    _o2 = implies_intro _o1
    _o3 = implies_intro _o2
    _g1 = forall_intro _o3
    _o4 = implies_intro _g1
    _g2 = forall_intro _o4
    qed _g2
