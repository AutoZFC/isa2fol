    _sx0 = forall_elim _smm, x
    _sxx = implies_elim _sx0, _sx
    _ox = iff_elim_l _sxx, _xs
    _a = assume elem(x,t)
    _a0 = forall_elim _relt, x
    _a1 = implies_elim _a0, _sx
    _a2 = implies_elim _a1, _a
    _ei = exists_elim _a2, i1
    _eis = and_elim_l _ei
    _eir = and_elim_r _ei
    _ein = and_elim_l _eir
    _eiy = and_elim_r _eir
    _mi0 = forall_elim _mm, i1
    _mi = implies_elim _mi0, _eis
    _leq = let eq(i1,n)
    _oi = or_intro_l _ein, _leq
    _iim = iff_elim_r _mi, _oi
    _a3 = and_intro _iim, _eiy
    _a4 = and_intro _eis, _a3
    _a5 = exists_intro _a4, i1
    _a6 = exists_intro _a5
    _ka = implies_intro _a6
    _b = assume kpair(n,v,x)
    _b1 = and_intro _sv, _b
    _b2 = exists_intro _b1, v
    _b3 = and_intro _nim, _b2
    _b4 = and_intro _sn, _b3
    _b5 = exists_intro _b4, n
    _kb = implies_intro _b5
    _rx = or_elim _ox, _ka, _kb
    _r1 = implies_intro _rx
    _r2 = implies_intro _r1
    _rels = forall_intro _r2
    fix k
    _si = assume set(k)
    _im = assume elem(k,m)
    _mi2 = forall_elim _mm, k
    _mi3 = implies_elim _mi2, _si
    _oim = iff_elim_l _mi3, _im
    _c = assume elem(k,n)
    _c0 = forall_elim _tott, k
    _c1 = implies_elim _c0, _si
    _c2 = implies_elim _c1, _c
    _ey = exists_elim _c2, w
    _eys = and_elim_l _ey
    _eyp = and_elim_r _ey
    _p0 = forall_elim _SP, k
    _p1 = implies_elim _p0, _si
    _p2 = forall_elim _p1, w
    _p3 = implies_elim _p2, _eys
    _lq = let (eq(k,n) & eq(w,v))
    _po = or_intro_l _eyp, _lq
    _pis = iff_elim_r _p3, _po
    _c3 = and_intro _eys, _pis
    _c4 = exists_intro _c3, w
    _c5 = exists_intro _c4
    _kc = implies_intro _c5
    _d = assume eq(k,n)
    _d0 = forall_elim _SP, k
    _d1 = implies_elim _d0, _si
    _d2 = forall_elim _d1, v
    _d3 = implies_elim _d2, _sv
    _rv = forall_elim _er, v
    _dc = and_intro _d, _rv
    _lp = let pmem(k,v,t)
    _do = or_intro_r _lp, _dc
    _dis = iff_elim_r _d3, _do
    _d4 = and_intro _sv, _dis
    _d5 = exists_intro _d4, v
    _kd = implies_intro _d5
    _tx = or_elim _oim, _kc, _kd
    _t1x = implies_intro _tx
    _t2x = implies_intro _t1x
    _tots = forall_intro _t2x
    fix k2
    _sk = assume set(k2)
    fix y2
    _sy2 = assume set(y2)
    fix z2
    _sz2 = assume set(z2)
    _hy = assume pmem(k2,y2,s)
    _hz = assume pmem(k2,z2,s)
    _e0 = forall_elim _SP, k2
    _e1 = implies_elim _e0, _sk
    _e2 = forall_elim _e1, y2
    _e3 = implies_elim _e2, _sy2
    _Dy = iff_elim_l _e3, _hy
    _e4 = forall_elim _e1, z2
    _e5 = implies_elim _e4, _sz2
    _Dz = iff_elim_l _e5, _hz
    _A = assume pmem(k2,y2,t)
    _A1 = assume pmem(k2,z2,t)
    _w0 = forall_elim _svt, k2
    _w1 = implies_elim _w0, _sk
    _w2 = forall_elim _w1, y2
    _w3 = implies_elim _w2, _sy2
    _w4 = forall_elim _w3, z2
    _w5 = implies_elim _w4, _sz2
    _w6 = implies_elim _w5, _A
    _w7 = implies_elim _w6, _A1
    _kA1 = implies_intro _w7
    _A2 = assume (eq(k2,n) & eq(z2,v))
    _A2e = and_elim_l _A2
    _v0 = forall_elim _DOM, k2
    _v1 = implies_elim _v0, _sk
    _v2 = forall_elim _v1, y2
    _v3 = implies_elim _v2, _sy2
    _v4 = implies_elim _v3, _A
    _f0 = forall_elim _ef, k2
    _f1 = forall_elim _f0, n
    _f2 = forall_elim _f1, n
    _f3 = implies_elim _f2, _A2e
    _f4 = implies_elim _f3, _v4
    _fb = not_elim _irr, _f4
    _lyz = let eq(y2,z2)
    _f5 = bottom_elim _fb, _lyz
    _kA2 = implies_intro _f5
    _rA = or_elim _Dz, _kA1, _kA2
    _kA = implies_intro _rA
    _B = assume (eq(k2,n) & eq(y2,v))
    _Be = and_elim_l _B
    _Byv = and_elim_r _B
    _B1 = assume pmem(k2,z2,t)
    _g0 = forall_elim _DOM, k2
    _g1 = implies_elim _g0, _sk
    _g2 = forall_elim _g1, z2
    _g3 = implies_elim _g2, _sz2
    _g4 = implies_elim _g3, _B1
    _h0 = forall_elim _ef, k2
    _h1 = forall_elim _h0, n
    _h2 = forall_elim _h1, n
    _h3 = implies_elim _h2, _Be
    _h4 = implies_elim _h3, _g4
    _hb = not_elim _irr, _h4
    _lyz2 = let eq(y2,z2)
    _h5 = bottom_elim _hb, _lyz2
    _kB1 = implies_intro _h5
    _B2 = assume (eq(k2,n) & eq(z2,v))
    _Bzv = and_elim_r _B2
    _j0 = forall_elim _ej, y2
    _j1 = forall_elim _j0, v
    _j2 = forall_elim _j1, z2
    _j3 = implies_elim _j2, _Byv
    _j4 = implies_elim _j3, _Bzv
    _kB2 = implies_intro _j4
    _rB = or_elim _Dz, _kB1, _kB2
    _kB = implies_intro _rB
    _eyz = or_elim _Dy, _kA, _kB
    _z1 = implies_intro _eyz
    _z2x = implies_intro _z1
    _z3 = implies_intro _z2x
    _gz = forall_intro _z3
    _z4 = implies_intro _gz
    _gy = forall_intro _z4
    _z5 = implies_intro _gy
    _svs = forall_intro _z5
    _c1a = and_intro _tots, _svs
    _c2a = and_intro _rels, _c1a
    _c3a = and_intro _ixm, _c2a
    _dd0 = forall_elim _td, s
