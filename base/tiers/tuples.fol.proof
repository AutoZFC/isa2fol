    _o1 = implies_intro _tsm
    _o2 = implies_intro _o1
    _o3 = implies_intro _o2
    _o4 = implies_intro _o3
    _gm = forall_intro _o4
    _o5 = implies_intro _gm
    _gv = forall_intro _o5
    _o6 = implies_intro _gv
    _gn = forall_intro _o6
    _gs = forall_intro _gn
    _gt = forall_intro _gs
    qed _gt

proof snoc_inj:
    _sd = use snoc_def
    _sp = use snoc_pmem
    _sw = use snoc_new
    _tdm = use tuple_dom
    _tf = use tuple_fresh
    _td = use tuple_def
    _id = use index_def
    _ex = use extensionality
    _sy = use eq_symm
    fix t
    fix t2
    fix n
    _sn = assume set(n)
    fix v
    _sv = assume set(v)
    fix v2
    _sv2 = assume set(v2)
    fix s
    _ht = assume tuple(t,n)
    _ht2 = assume tuple(t2,n)
    _h1 = assume snoc(t,n,v,s)
    _h2 = assume snoc(t2,n,v2,s)
    _t0 = forall_elim _td, t
    _t1 = forall_elim _t0, n
    _tc = iff_elim_l _t1, _ht
    _ix = and_elim_l _tc
    _i0 = forall_elim _id, n
    _ic = iff_elim_l _i0, _ix
    _irr = and_elim_r _ic
    _n0 = forall_elim _sw, t2
    _n1 = forall_elim _n0, n
    _n2 = forall_elim _n1, v2
    _n3 = forall_elim _n2, s
    _n4 = implies_elim _n3, _h2
    _n5 = implies_elim _n4, _sn
    _pv2 = implies_elim _n5, _sv2
    _q0 = forall_elim _sp, t
    _q1 = forall_elim _q0, n
    _q2 = forall_elim _q1, v
    _q3 = forall_elim _q2, s
    _q4 = implies_elim _q3, _h1
    _q5 = forall_elim _q4, n
    _q6 = implies_elim _q5, _sn
    _q7 = forall_elim _q6, v2
    _q8 = implies_elim _q7, _sv2
    _qo = iff_elim_l _q8, _pv2
    _a = assume pmem(n,v2,t)
    _a0 = forall_elim _tdm, t
    _a1 = forall_elim _a0, n
    _a2 = implies_elim _a1, _ht
    _a3 = forall_elim _a2, n
    _a4 = implies_elim _a3, _sn
    _a5 = forall_elim _a4, v2
    _a6 = implies_elim _a5, _sv2
    _nn = implies_elim _a6, _a
    _ab = not_elim _irr, _nn
    _lv = let eq(v2,v)
    _av = bottom_elim _ab, _lv
    _ka = implies_intro _av
    _b = assume (eq(n,n) & eq(v2,v))
    _bv = and_elim_r _b
    _kb = implies_intro _bv
    _v2v = or_elim _qo, _ka, _kb
    _y0 = forall_elim _sy, v2
    _y1 = forall_elim _y0, v
    _vv2 = implies_elim _y1, _v2v
    _s0 = forall_elim _sd, t
    _s1 = forall_elim _s0, n
    _s2 = forall_elim _s1, v
    _s3 = forall_elim _s2, s
    _m1 = iff_elim_l _s3, _h1
    _s4 = forall_elim _sd, t2
    _s5 = forall_elim _s4, n
    _s6 = forall_elim _s5, v2
    _s7 = forall_elim _s6, s
    _m2 = iff_elim_l _s7, _h2
    _f0 = forall_elim _tf, t
    _f1 = forall_elim _f0, n
    _F1 = implies_elim _f1, _ht
    _f2 = forall_elim _tf, t2
    _f3 = forall_elim _f2, n
    _F2 = implies_elim _f3, _ht2
    fix x
    _sx = assume set(x)
    _m1x0 = forall_elim _m1, x
    _m1x = implies_elim _m1x0, _sx
    _m2x0 = forall_elim _m2, x
    _m2x = implies_elim _m2x0, _sx
    _c = assume elem(x,t)
    _lk1 = let kpair(n,v,x)
    _c1 = or_intro_l _c, _lk1
    _cs = iff_elim_r _m1x, _c1
    _c2 = iff_elim_l _m2x, _cs
    _c3 = assume elem(x,t2)
    _kc3 = implies_intro _c3
    _c4 = assume kpair(n,v2,x)
    _g0 = forall_elim _F1, x
    _g1 = implies_elim _g0, _sx
    _g2 = implies_elim _g1, _c
    _g3 = forall_elim _g2, v2
    _gb = not_elim _g3, _c4
    _lt2 = let elem(x,t2)
    _g4 = bottom_elim _gb, _lt2
    _kc4 = implies_intro _g4
    _cx = or_elim _c2, _kc3, _kc4
    _fwd = implies_intro _cx
    _d = assume elem(x,t2)
    _lk2 = let kpair(n,v2,x)
    _d1 = or_intro_l _d, _lk2
    _ds = iff_elim_r _m2x, _d1
    _d2 = iff_elim_l _m1x, _ds
    _d3 = assume elem(x,t)
    _kd3 = implies_intro _d3
    _d4 = assume kpair(n,v,x)
    _e0 = forall_elim _F2, x
    _e1 = implies_elim _e0, _sx
    _e2 = implies_elim _e1, _d
    _e3 = forall_elim _e2, v
    _eb = not_elim _e3, _d4
    _lt = let elem(x,t)
    _e4 = bottom_elim _eb, _lt
    _kd4 = implies_intro _e4
    _dx = or_elim _d2, _kd3, _kd4
    _bwd = implies_intro _dx
    _iff = iff_intro _fwd, _bwd
    _is = implies_intro _iff
    _gx = forall_intro _is
    _x0 = forall_elim _ex, t
    _x1 = forall_elim _x0, t2
    _ett = iff_elim_r _x1, _gx
    _res = and_intro _ett, _vv2
    _o1 = implies_intro _res
    _o2 = implies_intro _o1
    _o3 = implies_intro _o2
    _o4 = implies_intro _o3
    _gs = forall_intro _o4
    _o5 = implies_intro _gs
    _gv2 = forall_intro _o5
    _o6 = implies_intro _gv2
    _gv = forall_intro _o6
    _o7 = implies_intro _gv
    _gn = forall_intro _o7
    _gt2 = forall_intro _gn
    _gt = forall_intro _gt2
    qed _gt

proof snoc_CONG:
    _sd = use snoc_def
    _es = use elem_second
    _ac = use kpair_arg_cong
    _sy = use eq_symm
    fix t
    fix t2
    fix n
    fix n2
    fix v
    fix v2
    fix s
    _et = assume eq(t,t2)
    _en = assume eq(n,n2)
    _ev = assume eq(v,v2)
    _hs = assume snoc(t,n,v,s)
    _s0 = forall_elim _sd, t
    _s1 = forall_elim _s0, n
    _s2 = forall_elim _s1, v
    _s3 = forall_elim _s2, s
    _sm = iff_elim_l _s3, _hs
    _y0 = forall_elim _sy, t
    _y1 = forall_elim _y0, t2
    _ett = implies_elim _y1, _et
    _y2 = forall_elim _sy, n
    _y3 = forall_elim _y2, n2
    _enn = implies_elim _y3, _en
    _y4 = forall_elim _sy, v
    _y5 = forall_elim _y4, v2
    _evv = implies_elim _y5, _ev
    fix x
    _sx = assume set(x)
    _sx0 = forall_elim _sm, x
    _sxx = implies_elim _sx0, _sx
    _h = assume elem(x,s)
    _o = iff_elim_l _sxx, _h
    _a = assume elem(x,t)
    _a0 = forall_elim _es, t
    _a1 = forall_elim _a0, t2
    _a2 = forall_elim _a1, x
    _a3 = implies_elim _a2, _et
    _a4 = implies_elim _a3, _a
    _lk = let kpair(n2,v2,x)
    _a5 = or_intro_l _a4, _lk
    _ka = implies_intro _a5
    _b = assume kpair(n,v,x)
    _b0 = forall_elim _ac, n
    _b1 = forall_elim _b0, v
    _b2 = forall_elim _b1, n2
    _b3 = forall_elim _b2, v2
    _b4 = forall_elim _b3, x
    _b5 = implies_elim _b4, _b
    _b6 = implies_elim _b5, _en
    _b7 = implies_elim _b6, _ev
    _lt = let elem(x,t2)
    _b8 = or_intro_r _lt, _b7
    _kb = implies_intro _b8
    _fwd0 = or_elim _o, _ka, _kb
    _fwd = implies_intro _fwd0
    _g = assume (elem(x,t2) | kpair(n2,v2,x))
    _c = assume elem(x,t2)
    _c0 = forall_elim _es, t2
    _c1 = forall_elim _c0, t
    _c2 = forall_elim _c1, x
    _c3 = implies_elim _c2, _ett
    _c4 = implies_elim _c3, _c
    _lk2 = let kpair(n,v,x)
    _c5 = or_intro_l _c4, _lk2
    _kc = implies_intro _c5
    _d = assume kpair(n2,v2,x)
    _d0 = forall_elim _ac, n2
    _d1 = forall_elim _d0, v2
    _d2 = forall_elim _d1, n
    _d3 = forall_elim _d2, v
    _d4 = forall_elim _d3, x
    _d5 = implies_elim _d4, _d
    _d6 = implies_elim _d5, _enn
    _d7 = implies_elim _d6, _evv
    _lt2 = let elem(x,t)
    _d8 = or_intro_r _lt2, _d7
    _kd = implies_intro _d8
    _o2 = or_elim _g, _kc, _kd
    _xs = iff_elim_r _sxx, _o2
    _bwd = implies_intro _xs
    _iff = iff_intro _fwd, _bwd
    _is = implies_intro _iff
    _gx = forall_intro _is
    _e0 = forall_elim _sd, t2
    _e1 = forall_elim _e0, n2
    _e2 = forall_elim _e1, v2
    _e3 = forall_elim _e2, s
    _res = iff_elim_r _e3, _gx
    _i1 = implies_intro _res
    _i2 = implies_intro _i1
    _i3 = implies_intro _i2
    _i4 = implies_intro _i3
    _g1 = forall_intro _i4
    _g2 = forall_intro _g1
    _g3 = forall_intro _g2
    _g4 = forall_intro _g3
    _g5 = forall_intro _g4
    _g6 = forall_intro _g5
    _g7 = forall_intro _g6
    qed _g7
