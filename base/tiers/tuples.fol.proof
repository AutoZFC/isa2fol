    _x2 = forall_elim _x1, m
    _x3 = implies_elim _x2, _sm
    _x4 = implies_elim _x3, _ix
    _ixm = implies_elim _x4, _hn
    _mn0 = forall_elim _mm, n
    _mnn = implies_elim _mn0, _sn
    _rn = forall_elim _er, n
    _lnn = let elem(n,n)
    _on = or_intro_r _lnn, _rn
    _nim = iff_elim_r _mnn, _on
    fix x
    _sx = assume set(x)
