    _ix = and_elim_l _tc
    _tr = and_elim_r _tc
    _relt = and_elim_l _tr
    _tr2 = and_elim_r _tr
    _tott = and_elim_l _tr2
    _svt = and_elim_r _tr2
    _i0 = forall_elim _id, n
