proof union2_ex:
    _pg = use pairing
    _un = use union
    _es = use elem_second
    _er = use eq_refl
    fix a
    _sa = assume set(a)
    fix b
    _sb = assume set(b)
    _p1 = forall_elim _pg, a
    _p2 = forall_elim _p1, b
    _p3 = implies_elim _p2, _sa
    _p4 = implies_elim _p3, _sb
    _ez = exists_elim _p4, z
    _zs = and_elim_l _ez
    _zm = and_elim_r _ez
    _q1 = forall_elim _un, z
    _q2 = implies_elim _q1, _zs
    _eu = exists_elim _q2, u
    _us = and_elim_l _eu
    _um = and_elim_r _eu
    fix x
    _sx = assume set(x)
    _umx0 = forall_elim _um, x
    _umx = implies_elim _umx0, _sx
    _h = assume elem(x,u)
    _ey0 = iff_elim_l _umx, _h
    _ey = exists_elim _ey0, y
    _ys = and_elim_l _ey
    _yr = and_elim_r _ey
    _yz = and_elim_l _yr
    _xy = and_elim_r _yr
    _zmy0 = forall_elim _zm, y
    _zmy = implies_elim _zmy0, _ys
    _yab = iff_elim_l _zmy, _yz
    _ca = assume eq(y,a)
    _e1 = forall_elim _es, y
    _e2 = forall_elim _e1, a
    _e3 = forall_elim _e2, x
    _e4 = implies_elim _e3, _ca
    _xa = implies_elim _e4, _xy
    _lb = let elem(x,b)
    _ra = or_intro_l _xa, _lb
    _fa = implies_intro _ra
    _cb = assume eq(y,b)
    _f1 = forall_elim _es, y
    _f2 = forall_elim _f1, b
    _f3 = forall_elim _f2, x
    _f4 = implies_elim _f3, _cb
    _xb = implies_elim _f4, _xy
    _la = let elem(x,a)
    _rb = or_intro_r _la, _xb
    _fb = implies_intro _rb
    _ab = or_elim _yab, _fa, _fb
    _ab2 = exists_intro _ab
    _fwd = implies_intro _ab2
    _g = assume (elem(x,a) | elem(x,b))
    _ga = assume elem(x,a)
    _zma0 = forall_elim _zm, a
    _zma = implies_elim _zma0, _sa
    _raa = forall_elim _er, a
    _lab = let eq(a,b)
    _oa = or_intro_l _raa, _lab
    _az = iff_elim_r _zma, _oa
    _c1 = and_intro _az, _ga
    _c2 = and_intro _sa, _c1
    _ex1 = exists_intro _c2, a
    _xu1 = iff_elim_r _umx, _ex1
    _ia = implies_intro _xu1
    _gb = assume elem(x,b)
    _zmb0 = forall_elim _zm, b
    _zmb = implies_elim _zmb0, _sb
    _rbb = forall_elim _er, b
    _lba = let eq(b,a)
    _ob = or_intro_r _lba, _rbb
    _bz = iff_elim_r _zmb, _ob
    _d1 = and_intro _bz, _gb
    _d2 = and_intro _sb, _d1
    _ex2 = exists_intro _d2, b
    _xu2 = iff_elim_r _umx, _ex2
    _ib = implies_intro _xu2
    _xu = or_elim _g, _ia, _ib
    _bwd = implies_intro _xu
    _iff = iff_intro _fwd, _bwd
    _is = implies_intro _iff
    _gx = forall_intro _is
    _k = and_intro _us, _gx
    _xe = exists_intro _k, u
    _cu = exists_intro _xe
    _cz = exists_intro _cu
    _ib1 = implies_intro _cz
    _gb1 = forall_intro _ib1
    _ia1 = implies_intro _gb1
    _ga1 = forall_intro _ia1
    qed _ga1

proof nsucc_EX:
    _pg = use pairing
    _u2 = use union2_ex
    _nd = use nsucc_def
    fix n
    _sn = assume set(n)
    _p1 = forall_elim _pg, n
    _p2 = forall_elim _p1, n
    _p3 = implies_elim _p2, _sn
    _p4 = implies_elim _p3, _sn
    _ez = exists_elim _p4, z
    _zs = and_elim_l _ez
    _zm = and_elim_r _ez
    _w1 = forall_elim _u2, n
    _w2 = implies_elim _w1, _sn
    _w3 = forall_elim _w2, z
    _w4 = implies_elim _w3, _zs
    _em = exists_elim _w4, m
    _ms = and_elim_l _em
    _mm = and_elim_r _em
    fix x
    _sx = assume set(x)
    _mx0 = forall_elim _mm, x
    _mx = implies_elim _mx0, _sx
    _zx0 = forall_elim _zm, x
    _zx = implies_elim _zx0, _sx
    _h = assume elem(x,m)
    _o = iff_elim_l _mx, _h
    _a1 = assume elem(x,n)
    _le = let eq(x,n)
    _r1 = or_intro_l _a1, _le
    _i1 = implies_intro _r1
    _a2 = assume elem(x,z)
    _ee = iff_elim_l _zx, _a2
    _b1 = assume eq(x,n)
    _j1 = implies_intro _b1
    _ex = or_elim _ee, _j1, _j1
    _ln = let elem(x,n)
    _r2 = or_intro_r _ln, _ex
    _i2 = implies_intro _r2
    _res = or_elim _o, _i1, _i2
    _fwd = implies_intro _res
    _g = assume (elem(x,n) | eq(x,n))
    _c1 = assume elem(x,n)
    _lz = let elem(x,z)
    _o1 = or_intro_l _c1, _lz
    _m1 = iff_elim_r _mx, _o1
    _k1 = implies_intro _m1
    _c2 = assume eq(x,n)
    _lq = let eq(x,n)
    _o2 = or_intro_l _c2, _lq
    _xz = iff_elim_r _zx, _o2
    _lnn = let elem(x,n)
    _o3 = or_intro_r _lnn, _xz
    _m2 = iff_elim_r _mx, _o3
    _k2 = implies_intro _m2
    _m3 = or_elim _g, _k1, _k2
    _bwd = implies_intro _m3
    _iff = iff_intro _fwd, _bwd
    _is = implies_intro _iff
    _gx = forall_intro _is
    _d1 = forall_elim _nd, n
    _d2 = forall_elim _d1, m
    _ns = iff_elim_r _d2, _gx
    _k = and_intro _ms, _ns
    _xm = exists_intro _k, m
    _cm = exists_intro _xm
    _cz = exists_intro _cm
    _in = implies_intro _cz
    _gn = forall_intro _in
    qed _gn

proof snoc_EX:
    _pe = use pair_ex
    _pg = use pairing
    _un = use union2_ex
    _sd = use snoc_def
    _rc = use kpair_res_cong
    _pu = use pair_uniq
    _sy = use eq_symm
    fix t
    _st = assume set(t)
    fix n
    _sn = assume set(n)
    fix v
    _sv = assume set(v)
    _a1 = forall_elim _pe, n
    _a2 = forall_elim _a1, v
    _a3 = implies_elim _a2, _sn
    _a4 = implies_elim _a3, _sv
    _ep = exists_elim _a4, p
    _ps = and_elim_l _ep
    _pk = and_elim_r _ep
    _p1 = forall_elim _pg, p
    _p2 = forall_elim _p1, p
    _p3 = implies_elim _p2, _ps
    _p4 = implies_elim _p3, _ps
    _ez = exists_elim _p4, z
    _zs = and_elim_l _ez
    _zm = and_elim_r _ez
    _w1 = forall_elim _un, t
    _w2 = implies_elim _w1, _st
    _w3 = forall_elim _w2, z
    _w4 = implies_elim _w3, _zs
    _es = exists_elim _w4, s
    _ss = and_elim_l _es
    _sm = and_elim_r _es
    fix x
    _sx = assume set(x)
    _sx0 = forall_elim _sm, x
    _sxm = implies_elim _sx0, _sx
    _zx0 = forall_elim _zm, x
    _zx = implies_elim _zx0, _sx
    _h = assume elem(x,s)
    _o = iff_elim_l _sxm, _h
    _a = assume elem(x,t)
    _lk = let kpair(n,v,x)
    _r1 = or_intro_l _a, _lk
    _i1 = implies_intro _r1
    _b = assume elem(x,z)
    _ee = iff_elim_l _zx, _b
    _q = assume eq(x,p)
    _jq = implies_intro _q
    _exp = or_elim _ee, _jq, _jq
    _s1 = forall_elim _sy, x
    _s2 = forall_elim _s1, p
    _epx = implies_elim _s2, _exp
    _c1 = forall_elim _rc, n
    _c2 = forall_elim _c1, v
    _c3 = forall_elim _c2, p
    _c4 = forall_elim _c3, x
    _c5 = implies_elim _c4, _pk
    _kx = implies_elim _c5, _epx
    _lt = let elem(x,t)
    _r2 = or_intro_r _lt, _kx
    _i2 = implies_intro _r2
    _res = or_elim _o, _i1, _i2
    _fwd = implies_intro _res
    _g = assume (elem(x,t) | kpair(n,v,x))
    _d = assume elem(x,t)
    _lz = let elem(x,z)
    _o1 = or_intro_l _d, _lz
    _m1 = iff_elim_r _sxm, _o1
    _k1 = implies_intro _m1
    _e = assume kpair(n,v,x)
    _u1 = forall_elim _pu, n
    _u2 = forall_elim _u1, v
    _u3 = forall_elim _u2, x
    _u4 = forall_elim _u3, p
    _u5 = implies_elim _u4, _e
    _exp2 = implies_elim _u5, _pk
    _lq = let eq(x,p)
    _o2 = or_intro_l _exp2, _lq
    _xz = iff_elim_r _zx, _o2
    _ltt = let elem(x,t)
    _o3 = or_intro_r _ltt, _xz
    _m2 = iff_elim_r _sxm, _o3
    _k2 = implies_intro _m2
    _m3 = or_elim _g, _k1, _k2
    _bwd = implies_intro _m3
    _iff = iff_intro _fwd, _bwd
    _is = implies_intro _iff
    _gx = forall_intro _is
    _d1 = forall_elim _sd, t
    _d2 = forall_elim _d1, n
    _d3 = forall_elim _d2, v
    _d4 = forall_elim _d3, s
    _sn2 = iff_elim_r _d4, _gx
    _k = and_intro _ss, _sn2
    _xs = exists_intro _k, s
    _cs = exists_intro _xs
    _cz = exists_intro _cs
    _cp = exists_intro _cz
    _iv = implies_intro _cp
    _gv = forall_intro _iv
    _in = implies_intro _gv
    _gn = forall_intro _in
    _it = implies_intro _gn
    _gt = forall_intro _it
    qed _gt

proof snoc_UNIQ:
    _sd = use snoc_def
    _e = use extensionality
    fix t
    fix n
    fix v
    fix s
    fix s2
    _h1 = assume snoc(t,n,v,s)
    _h2 = assume snoc(t,n,v,s2)
    _d1 = forall_elim _sd, t
    _d2 = forall_elim _d1, n
    _d3 = forall_elim _d2, v
    _d4 = forall_elim _d3, s
    _m1 = iff_elim_l _d4, _h1
    _d5 = forall_elim _d3, s2
    _m2 = iff_elim_l _d5, _h2
    fix u
    _su = assume set(u)
    _a0 = forall_elim _m1, u
    _a = implies_elim _a0, _su
    _b0 = forall_elim _m2, u
    _b = implies_elim _b0, _su
    _x = assume elem(u,s)
    _x1 = iff_elim_l _a, _x
    _x2 = iff_elim_r _b, _x1
    _f1 = implies_intro _x2
    _y = assume elem(u,s2)
    _y1 = iff_elim_l _b, _y
    _y2 = iff_elim_r _a, _y1
    _f2 = implies_intro _y2
    _bi = iff_intro _f1, _f2
    _big = implies_intro _bi
    _gu = forall_intro _big
    _e1 = forall_elim _e, s
    _e2 = forall_elim _e1, s2
    _eq = iff_elim_r _e2, _gu
    _i1 = implies_intro _eq
    _i2 = implies_intro _i1
    _g1 = forall_intro _i2
    _g2 = forall_intro _g1
    _g3 = forall_intro _g2
    _g4 = forall_intro _g3
    _g5 = forall_intro _g4
    qed _g5

proof index_zero:
    _id = use index_def
    _mas = use members_are_sets
    fix e
    _h = assume forall u. (set(u) -> (~ elem(u,e)))
    fix x
    _sx = assume set(x)
    _xe = assume elem(x,e)
    _hx0 = forall_elim _h, x
    _hx = implies_elim _hx0, _sx
    _bot = not_elim _hx, _xe
    _goal = let forall y. (set(y) -> (elem(y,x) -> elem(y,e)))
    _t = bottom_elim _bot, _goal
    _i1 = implies_intro _t
    _i2 = implies_intro _i1
    _gx = forall_intro _i2
    _ee = assume elem(e,e)
    _m1 = forall_elim _mas, e
    _m2 = forall_elim _m1, e
    _se = implies_elim _m2, _ee
    _he0 = forall_elim _h, e
    _he = implies_elim _he0, _se
    _b2 = not_elim _he, _ee
    _ne = not_intro _b2
    _cj = and_intro _gx, _ne
    _d = forall_elim _id, e
    _ix = iff_elim_r _d, _cj
    _ih = implies_intro _ix
    _ge = forall_intro _ih
    qed _ge

proof index_succ:
    _id = use index_def
    _nd = use nsucc_def
    _es = use elem_second
    _ef = use elem_first_subst
    _er = use eq_refl
    fix n
    _sn = assume set(n)
    fix m
    _sm = assume set(m)
    _hi = assume index(n)
    _hs = assume nsucc(n,m)
    _i0 = forall_elim _id, n
    _ic = iff_elim_l _i0, _hi
    _tr = and_elim_l _ic
    _irr = and_elim_r _ic
    _n0 = forall_elim _nd, n
    _n1 = forall_elim _n0, m
    _mm = iff_elim_l _n1, _hs
    fix x
    _sx = assume set(x)
    _xm = assume elem(x,m)
    fix y
    _sy = assume set(y)
    _yx = assume elem(y,x)
    _mx0 = forall_elim _mm, x
    _mx = implies_elim _mx0, _sx
    _oxn = iff_elim_l _mx, _xm
    _my0 = forall_elim _mm, y
    _my = implies_elim _my0, _sy
    _c1 = assume elem(x,n)
    _t1 = forall_elim _tr, x
    _t2 = implies_elim _t1, _sx
    _t3 = implies_elim _t2, _c1
    _t4 = forall_elim _t3, y
    _t5 = implies_elim _t4, _sy
    _yn = implies_elim _t5, _yx
    _lq = let eq(y,n)
    _o1 = or_intro_l _yn, _lq
    _ym1 = iff_elim_r _my, _o1
    _k1 = implies_intro _ym1
    _c2 = assume eq(x,n)
    _s1 = forall_elim _es, x
    _s2 = forall_elim _s1, n
    _s3 = forall_elim _s2, y
    _s4 = implies_elim _s3, _c2
    _yn2 = implies_elim _s4, _yx
    _lq2 = let eq(y,n)
    _o2 = or_intro_l _yn2, _lq2
    _ym2 = iff_elim_r _my, _o2
    _k2 = implies_intro _ym2
    _ym = or_elim _oxn, _k1, _k2
    _j1 = implies_intro _ym
    _j2 = implies_intro _j1
    _gy = forall_intro _j2
    _j3 = implies_intro _gy
    _j4 = implies_intro _j3
    _gx = forall_intro _j4
    _hm = assume elem(m,m)
    _mm0 = forall_elim _mm, m
    _mmm = implies_elim _mm0, _sm
    _omn = iff_elim_l _mmm, _hm
    _mn0 = forall_elim _mm, n
    _mnn = implies_elim _mn0, _sn
    _rn = forall_elim _er, n
    _lnn = let elem(n,n)
    _on = or_intro_r _lnn, _rn
    _nim = iff_elim_r _mnn, _on
    _d1 = assume elem(m,n)
    _u1 = forall_elim _tr, m
    _u2 = implies_elim _u1, _sm
    _u3 = implies_elim _u2, _d1
    _u4 = forall_elim _u3, n
    _u5 = implies_elim _u4, _sn
    _nn1 = implies_elim _u5, _nim
    _b1 = not_elim _irr, _nn1
    _k3 = implies_intro _b1
    _d2 = assume eq(m,n)
    _f1 = forall_elim _ef, m
    _f2 = forall_elim _f1, n
    _f3 = forall_elim _f2, m
    _f4 = implies_elim _f3, _d2
    _nm = implies_elim _f4, _hm
    _g1 = forall_elim _es, m
    _g2 = forall_elim _g1, n
    _g3 = forall_elim _g2, n
    _g4 = implies_elim _g3, _d2
    _nn2 = implies_elim _g4, _nm
    _b2 = not_elim _irr, _nn2
    _k4 = implies_intro _b2
    _bot = or_elim _omn, _k3, _k4
    _nmm = not_intro _bot
    _cj = and_intro _gx, _nmm
    _im0 = forall_elim _id, m
    _im = iff_elim_r _im0, _cj
    _q1 = implies_intro _im
    _q2 = implies_intro _q1
    _q3 = implies_intro _q2
    _gm = forall_intro _q3
    _q4 = implies_intro _gm
    _gn = forall_intro _q4
    qed _gn

proof tuple_dom:
    _td = use tuple_def
    _pd = use pmem_def
    _pi = use pair_inj
    _sy = use eq_symm
    _ef = use elem_first_subst
    fix t
    fix n
    _ht = assume tuple(t,n)
    _t0 = forall_elim _td, t
    _t1 = forall_elim _t0, n
    _tc = iff_elim_l _t1, _ht
    _tr = and_elim_r _tc
    _rel = and_elim_l _tr
    fix i
    _si = assume set(i)
    fix y
    _sy2 = assume set(y)
    _hp = assume pmem(i,y,t)
    _p0 = forall_elim _pd, i
    _p1 = forall_elim _p0, y
    _p2 = forall_elim _p1, t
    _pe = iff_elim_l _p2, _hp
    _ep = exists_elim _pe, p
    _ps = and_elim_l _ep
    _pr = and_elim_r _ep
    _pk = and_elim_l _pr
    _pt = and_elim_r _pr
    _r0 = forall_elim _rel, p
    _r1 = implies_elim _r0, _ps
    _r2 = implies_elim _r1, _pt
    _ej = exists_elim _r2, j
    _jr = and_elim_r _ej
    _jn = and_elim_l _jr
    _ew = and_elim_r _jr
    _ez = exists_elim _ew, w
    _jk = and_elim_r _ez
    _q1 = forall_elim _pi, i
    _q2 = forall_elim _q1, y
    _q3 = forall_elim _q2, j
    _q4 = forall_elim _q3, w
    _q5 = forall_elim _q4, p
    _q6 = implies_elim _q5, _pk
    _q7 = implies_elim _q6, _jk
    _eij = and_elim_l _q7
    _s1 = forall_elim _sy, i
    _s2 = forall_elim _s1, j
    _eji = implies_elim _s2, _eij
    _f1 = forall_elim _ef, j
    _f2 = forall_elim _f1, i
    _f3 = forall_elim _f2, n
    _f4 = implies_elim _f3, _eji
    _in = implies_elim _f4, _jn
    _cw = exists_intro _in
    _cj = exists_intro _cw
    _cp = exists_intro _cj
    _i1 = implies_intro _cp
    _i2 = implies_intro _i1
    _gy = forall_intro _i2
    _i3 = implies_intro _gy
    _gi = forall_intro _i3
    _i4 = implies_intro _gi
    _gn = forall_intro _i4
    _gt = forall_intro _gn
    qed _gt

proof tuple_fresh:
    _td = use tuple_def
    _id = use index_def
    _pi = use pair_inj
    _sy = use eq_symm
    _ef = use elem_first_subst
    fix t
    fix n
    _ht = assume tuple(t,n)
    _t0 = forall_elim _td, t
    _t1 = forall_elim _t0, n
    _tc = iff_elim_l _t1, _ht
    _ix = and_elim_l _tc
    _tr = and_elim_r _tc
    _rel = and_elim_l _tr
    _i0 = forall_elim _id, n
    _ic = iff_elim_l _i0, _ix
    _irr = and_elim_r _ic
    fix x
    _sx = assume set(x)
    _xt = assume elem(x,t)
    fix w
    _hk = assume kpair(n,w,x)
    _r0 = forall_elim _rel, x
    _r1 = implies_elim _r0, _sx
    _r2 = implies_elim _r1, _xt
    _ej = exists_elim _r2, j
    _jr = and_elim_r _ej
    _jn = and_elim_l _jr
    _ew = and_elim_r _jr
    _ez = exists_elim _ew, y
    _jk = and_elim_r _ez
    _q1 = forall_elim _pi, n
    _q2 = forall_elim _q1, w
    _q3 = forall_elim _q2, j
    _q4 = forall_elim _q3, y
    _q5 = forall_elim _q4, x
    _q6 = implies_elim _q5, _hk
    _q7 = implies_elim _q6, _jk
    _enj = and_elim_l _q7
    _s1 = forall_elim _sy, n
    _s2 = forall_elim _s1, j
    _ejn = implies_elim _s2, _enj
    _f1 = forall_elim _ef, j
    _f2 = forall_elim _f1, n
    _f3 = forall_elim _f2, n
    _f4 = implies_elim _f3, _ejn
    _nn = implies_elim _f4, _jn
    _bot = not_elim _irr, _nn
    _cy = exists_intro _bot
    _cj = exists_intro _cy
    _nk = not_intro _cj
    _gw = forall_intro _nk
    _i1 = implies_intro _gw
    _i2 = implies_intro _i1
    _gx = forall_intro _i2
    _i3 = implies_intro _gx
    _gn = forall_intro _i3
    _gt = forall_intro _gn
    qed _gt

proof snoc_pmem:
    _sd = use snoc_def
    _pd = use pmem_def
    _pi = use pair_inj
    _pe = use pair_ex
    _ac = use kpair_arg_cong
    fix t
    fix n
    fix v
    fix s
    _hs = assume snoc(t,n,v,s)
    _d0 = forall_elim _sd, t
    _d1 = forall_elim _d0, n
    _d2 = forall_elim _d1, v
    _d3 = forall_elim _d2, s
    _sm = iff_elim_l _d3, _hs
    fix i
    _si = assume set(i)
    fix y
    _sy = assume set(y)
    _ps0 = forall_elim _pd, i
    _ps1 = forall_elim _ps0, y
    _pss = forall_elim _ps1, s
    _pst = forall_elim _ps1, t
    _h = assume pmem(i,y,s)
    _e1 = iff_elim_l _pss, _h
    _ep = exists_elim _e1, p
    _ps = and_elim_l _ep
    _pr = and_elim_r _ep
    _pk = and_elim_l _pr
    _pin = and_elim_r _pr
    _sp0 = forall_elim _sm, p
    _sp = implies_elim _sp0, _ps
    _o = iff_elim_l _sp, _pin
    _a = assume elem(p,t)
    _a1 = and_intro _pk, _a
    _a2 = and_intro _ps, _a1
    _a3 = exists_intro _a2, p
    _a4 = iff_elim_r _pst, _a3
    _la = let (eq(i,n) & eq(y,v))
    _a5 = or_intro_l _a4, _la
    _ia = implies_intro _a5
    _b = assume kpair(n,v,p)
    _b1 = forall_elim _pi, i
    _b2 = forall_elim _b1, y
    _b3 = forall_elim _b2, n
    _b4 = forall_elim _b3, v
    _b5 = forall_elim _b4, p
    _b6 = implies_elim _b5, _pk
    _b7 = implies_elim _b6, _b
    _lb = let pmem(i,y,t)
    _b8 = or_intro_r _lb, _b7
    _ib = implies_intro _b8
    _res = or_elim _o, _ia, _ib
    _cp = exists_intro _res
    _fwd = implies_intro _cp
    _g = assume (pmem(i,y,t) | (eq(i,n) & eq(y,v)))
    _c = assume pmem(i,y,t)
    _c1 = iff_elim_l _pst, _c
    _eq = exists_elim _c1, q
    _qs = and_elim_l _eq
    _qr = and_elim_r _eq
    _qk = and_elim_l _qr
    _qt = and_elim_r _qr
    _lq = let kpair(n,v,q)
    _qo = or_intro_l _qt, _lq
    _sq0 = forall_elim _sm, q
    _sq = implies_elim _sq0, _qs
    _qs2 = iff_elim_r _sq, _qo
    _c2 = and_intro _qk, _qs2
    _c3 = and_intro _qs, _c2
    _c4 = exists_intro _c3, q
    _c5 = iff_elim_r _pss, _c4
    _cq = exists_intro _c5
    _ic = implies_intro _cq
    _d = assume (eq(i,n) & eq(y,v))
    _din = and_elim_l _d
    _dyv = and_elim_r _d
    _x1 = forall_elim _pe, i
    _x2 = forall_elim _x1, y
    _x3 = implies_elim _x2, _si
    _x4 = implies_elim _x3, _sy
    _er = exists_elim _x4, r
    _rs = and_elim_l _er
    _rk = and_elim_r _er
    _k1 = forall_elim _ac, i
    _k2 = forall_elim _k1, y
    _k3 = forall_elim _k2, n
    _k4 = forall_elim _k3, v
    _k5 = forall_elim _k4, r
    _k6 = implies_elim _k5, _rk
    _k7 = implies_elim _k6, _din
    _nk = implies_elim _k7, _dyv
    _lt = let elem(r,t)
    _ro = or_intro_r _lt, _nk
    _sr0 = forall_elim _sm, r
    _sr = implies_elim _sr0, _rs
    _rin = iff_elim_r _sr, _ro
    _r2 = and_intro _rk, _rin
    _r3 = and_intro _rs, _r2
    _r4 = exists_intro _r3, r
    _r5 = iff_elim_r _pss, _r4
    _cr = exists_intro _r5
    _id2 = implies_intro _cr
    _bwres = or_elim _g, _ic, _id2
    _bwd = implies_intro _bwres
    _iff = iff_intro _fwd, _bwd
    _j1 = implies_intro _iff
    _gy = forall_intro _j1
    _j2 = implies_intro _gy
    _gi = forall_intro _j2
    _j3 = implies_intro _gi
    _gs = forall_intro _j3
    _gv = forall_intro _gs
    _gn = forall_intro _gv
    _gt = forall_intro _gn
    qed _gt

proof tuple_zero:
    _td = use tuple_def
    _iz = use index_zero
    _pd = use pmem_def
    fix e
    _h = assume forall u. (set(u) -> (~ elem(u,e)))
    _i0 = forall_elim _iz, e
    _ix = implies_elim _i0, _h
    fix x
    _sx = assume set(x)
    _xe = assume elem(x,e)
    _hx0 = forall_elim _h, x
    _hx = implies_elim _hx0, _sx
    _b1 = not_elim _hx, _xe
    _l1 = let exists i. (set(i) & (elem(i,e) & (exists y. (set(y) & kpair(i,y,x)))))
    _r1 = bottom_elim _b1, _l1
    _k1 = implies_intro _r1
    _k2 = implies_intro _k1
    _rel = forall_intro _k2
    fix k
    _sk = assume set(k)
    _ke = assume elem(k,e)
    _hk0 = forall_elim _h, k
    _hk = implies_elim _hk0, _sk
    _b2 = not_elim _hk, _ke
    _l2 = let exists y. (set(y) & pmem(k,y,e))
    _r2 = bottom_elim _b2, _l2
    _k3 = implies_intro _r2
    _k4 = implies_intro _k3
    _tot = forall_intro _k4
    fix j
    _sj = assume set(j)
    fix y2
    _sy2 = assume set(y2)
    fix z2
    _sz2 = assume set(z2)
    _hp = assume pmem(j,y2,e)
    _hq = assume pmem(j,z2,e)
    _p0 = forall_elim _pd, j
    _p1 = forall_elim _p0, y2
    _p2 = forall_elim _p1, e
    _pe = iff_elim_l _p2, _hp
    _ep = exists_elim _pe, p
    _ps = and_elim_l _ep
    _pr = and_elim_r _ep
    _pin = and_elim_r _pr
    _hp0 = forall_elim _h, p
    _hpp = implies_elim _hp0, _ps
    _b3 = not_elim _hpp, _pin
    _l3 = let eq(y2,z2)
    _r3 = bottom_elim _b3, _l3
    _cp = exists_intro _r3
    _m1 = implies_intro _cp
    _m2 = implies_intro _m1
    _m3 = implies_intro _m2
    _gz = forall_intro _m3
    _m4 = implies_intro _gz
    _gy = forall_intro _m4
    _m5 = implies_intro _gy
    _sv = forall_intro _m5
    _c1 = and_intro _tot, _sv
    _c2 = and_intro _rel, _c1
    _c3 = and_intro _ix, _c2
    _d0 = forall_elim _td, e
    _d1 = forall_elim _d0, e
    _te = iff_elim_r _d1, _c3
    _ih = implies_intro _te
    _ge = forall_intro _ih
    qed _ge

proof snoc_new:
    _sp = use snoc_pmem
    _er = use eq_refl
    fix t
    fix n
    fix v
    fix s
    _hs = assume snoc(t,n,v,s)
    _sn = assume set(n)
    _sv = assume set(v)
    _a0 = forall_elim _sp, t
    _a1 = forall_elim _a0, n
    _a2 = forall_elim _a1, v
    _a3 = forall_elim _a2, s
    _a4 = implies_elim _a3, _hs
    _a5 = forall_elim _a4, n
    _a6 = implies_elim _a5, _sn
    _a7 = forall_elim _a6, v
    _a8 = implies_elim _a7, _sv
    _rn = forall_elim _er, n
    _rv = forall_elim _er, v
    _c = and_intro _rn, _rv
    _lt = let pmem(n,v,t)
    _o = or_intro_r _lt, _c
    _r = iff_elim_r _a8, _o
    _i1 = implies_intro _r
    _i2 = implies_intro _i1
    _i3 = implies_intro _i2
    _g1 = forall_intro _i3
    _g2 = forall_intro _g1
    _g3 = forall_intro _g2
    _g4 = forall_intro _g3
    qed _g4

proof snoc_old:
    _sp = use snoc_pmem
    _ef = use elem_first_subst
    fix t
    fix n
    fix v
    fix s
    _hs = assume snoc(t,n,v,s)
    _nn = assume ~ elem(n,n)
    fix i
    _si = assume set(i)
    _in = assume elem(i,n)
    fix y
    _sy = assume set(y)
    _a0 = forall_elim _sp, t
    _a1 = forall_elim _a0, n
    _a2 = forall_elim _a1, v
    _a3 = forall_elim _a2, s
    _a4 = implies_elim _a3, _hs
    _a5 = forall_elim _a4, i
    _a6 = implies_elim _a5, _si
    _a7 = forall_elim _a6, y
    _pp = implies_elim _a7, _sy
    _h = assume pmem(i,y,s)
    _o = iff_elim_l _pp, _h
    _c1 = assume pmem(i,y,t)
    _k1 = implies_intro _c1
    _c2 = assume (eq(i,n) & eq(y,v))
    _ein = and_elim_l _c2
    _f1 = forall_elim _ef, i
    _f2 = forall_elim _f1, n
    _f3 = forall_elim _f2, n
    _f4 = implies_elim _f3, _ein
    _nin = implies_elim _f4, _in
    _bot = not_elim _nn, _nin
    _lt = let pmem(i,y,t)
    _pt = bottom_elim _bot, _lt
    _k2 = implies_intro _pt
    _res = or_elim _o, _k1, _k2
    _fwd = implies_intro _res
    _g = assume pmem(i,y,t)
    _le = let (eq(i,n) & eq(y,v))
    _go = or_intro_l _g, _le
    _gs = iff_elim_r _pp, _go
    _bwd = implies_intro _gs
    _iff = iff_intro _fwd, _bwd
    _j1 = implies_intro _iff
    _gy = forall_intro _j1
    _j2 = implies_intro _gy
    _j3 = implies_intro _j2
    _gi = forall_intro _j3
    _j4 = implies_intro _gi
    _j5 = implies_intro _j4
    _g1 = forall_intro _j5
    _g2 = forall_intro _g1
    _g3 = forall_intro _g2
    _g4 = forall_intro _g3
    qed _g4

proof tuple_snoc:
    _td = use tuple_def
