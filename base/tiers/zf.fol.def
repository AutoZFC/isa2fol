# base/tiers/zf -- Isabelle/ZF's primitive constants in class form: the predicates reify names them by.
#
# ZF_Base AXIOMATISES zero, Pow, Union, PrimReplace and Inf -- there is no Isabelle definition to translate
# or to name -- and each is one of NBG's own notions, a relation defined in base/tiers/primitives (Inf, the
# least inductive set, in base/tiers/inf). So their class predicates are defined HERE, from those relations, in the shape reify gives a
# constant Isabelle defines (DESIGN decision 5): a set constant `c(v) <-> body(v)`; a function constant
# `c(S) <-> forall t r. <t,r> : S <-> exists A. <A> = t & body(A,r)`, the tuple and its guards as the
# pipeline writes them. Reify neither defines nor refuses a constant this tier defines: its list is pinned
# against this file by a test.
#
# PrimReplace's P IS ISABELLE'S PREDICATE [i,i] => o, A CLASS OF 2-TUPLES (R7) -- not the relation of
# Kuratowski pairs that PrimReplace(A,F,r) takes. Its body is replacement's matrix over the tuple.
#
# PrimReplace IS TOTAL, AS ISABELLE'S IS: where P is not functional on A, Isabelle's value is unspecified
# and the image may be no set, so the class takes the empty set there. Without that case the class has no
# value at such A, is no function, and `PrimReplace(A,P) = PrimReplace(A,P)` is false.
#
# The set constants' EX and UNIQ, the first links of their chain (decision 5), from base's own.
#
# class_subst, IFOL's axiom subst with its predicate a CLASS variable, bare (FOUNDATION §2 S4): membership's
# congruence, from cong_snoc_v -- a's 1-tuple is b's. As the pipeline renders it at i, OFCLASS dropped. Not named
# IFOL.subst: that is Isabelle's fact of the axiom, a claim of the unit.
#
# ISABELLE'S ZF AXIOMS IN NBG'S WORDS (DESIGN "Step 8"): ZF_Base.extension_NBG, Union_iff_NBG, Pow_iff_NBG,
# replacement_NBG, foundation_NBG, infinity_NBG -- each axiom with a primitive read by its relation (Union(C,u) for
# u = Union(C)) and a predicate Isabelle defines read by its definition, as the translator's lemma ZF_Base.a_AXIOM
# reads the axiom back into Isabelle's form. Their text is the translator's words, checked by the kernel. replacement's
# premise is its slot lambda's class, which the class prover proves (CLASS_<lambda>); infinity keeps NBG's successor,
# Isabelle's succ read by upair.succ_iff. cong_Union_l and cong_Pow_l carry a tuple's entry into a primitive's @def body.
#
# replacement_NBG IS THE TRANSLATOR'S WORDS SINCE S1'S NAMING WENT UNIVERSAL (DESIGN "Linear proof size", 7): its premise
# the class prover's CLASS of the slot lambda, its tuples universal. It is proved from replacement_ex, the statement it
# had before (tuples existential), by cong_* at each level -- a walk generated mechanically from the two statements --
# the tuple's two forms related at the leaves by tup2_ue (<x,y> = t) and pmem2_ue (P(x,y)), both from the tuples tier.
#
# Depends on base/axioms, pairs, witness, logic, cong, s2s3, primitives, tuples, classes, metafun, inf. Admits nothing: five definitional
# introductions, content zero.

@def(ZF_Base.zero) axiom ZF_Base.zero_def: forall v. (ZF_Base.zero(v) <-> zero(v))
@def(ZF_Base.Inf) axiom ZF_Base.Inf_def: forall v. (ZF_Base.Inf(v) <-> Inf(v))
@def(ZF_Base.Pow) axiom ZF_Base.Pow_def: forall S. (ZF_Base.Pow(S) <-> (forall t. (set(t) -> (forall r. (set(r) -> (pmem(t,r,S) <-> (exists A. (set(A) & ((forall e. (set(e) -> (zero(e) -> snoc(e,e,A,t)))) & Pow(A,r))))))))))
@def(ZF_Base.Union) axiom ZF_Base.Union_def: forall S. (ZF_Base.Union(S) <-> (forall t. (set(t) -> (forall r. (set(r) -> (pmem(t,r,S) <-> (exists A. (set(A) & ((forall e. (set(e) -> (zero(e) -> snoc(e,e,A,t)))) & Union(A,r))))))))))
@def(ZF_Base.PrimReplace) axiom ZF_Base.PrimReplace_def: forall S. forall P. (ZF_Base.PrimReplace(S,P) <-> (forall t. (set(t) -> (forall r. (set(r) -> (pmem(t,r,S) <-> (exists A. (set(A) & ((forall e. (set(e) -> (zero(e) -> snoc(e,e,A,t)))) & (((forall x. (set(x) -> (elem(x,A) -> (forall y. (set(y) -> (forall z. (set(z) -> ((exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,x,s) & snoc(s,i,y,p)))))))))) & elem(p,P)))) -> ((exists q. (set(q) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,x,s) & snoc(s,i,z,q)))))))))) & elem(q,P)))) -> eq(y,z)))))))))) & (forall v. (set(v) -> (elem(v,r) <-> (exists u. (set(u) & (elem(u,A) & (exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,u,s) & snoc(s,i,v,p)))))))))) & elem(p,P))))))))))) | ((~ (forall x. (set(x) -> (elem(x,A) -> (forall y. (set(y) -> (forall z. (set(z) -> ((exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,x,s) & snoc(s,i,y,p)))))))))) & elem(p,P)))) -> ((exists q. (set(q) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,x,s) & snoc(s,i,z,q)))))))))) & elem(q,P)))) -> eq(y,z))))))))))) & zero(r))))))))))))

claim ZF_Base.zero_EX: exists v. (set(v) & ZF_Base.zero(v))
claim ZF_Base.Inf_EX: exists v. (set(v) & ZF_Base.Inf(v))
claim ZF_Base.zero_UNIQ: forall v. (set(v) -> (forall w. (set(w) -> (ZF_Base.zero(v) -> (ZF_Base.zero(w) -> eq(v,w))))))
claim ZF_Base.Inf_UNIQ: forall v. (set(v) -> (forall w. (set(w) -> (ZF_Base.Inf(v) -> (ZF_Base.Inf(w) -> eq(v,w))))))
claim class_subst: forall a. (set(a) -> (forall b. (set(b) -> (forall P. (eq(a,b) -> ((forall t. (set(t) -> ((forall e. (set(e) -> (zero(e) -> snoc(e,e,a,t)))) -> elem(t,P)))) -> (forall t. (set(t) -> ((forall e. (set(e) -> (zero(e) -> snoc(e,e,b,t)))) -> elem(t,P))))))))))

# PrimReplace's value: the image of A under P where P is functional on A, else 0 — Replacement (PrimReplace_EX) at
# the class of Kuratowski pairs {<u,v> : u in A & <u,v> in P}, built by lam_class, cls_place2, cls_conv, g1_inter2.
claim ZF_Base.PrimReplace_value: forall P. (forall A. (set(A) -> (exists r. (set(r) & (((forall x. (set(x) -> (elem(x,A) -> (forall y. (set(y) -> (forall z. (set(z) -> ((exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,x,s) & snoc(s,i,y,p)))))))))) & elem(p,P)))) -> ((exists q. (set(q) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,x,s) & snoc(s,i,z,q)))))))))) & elem(q,P)))) -> eq(y,z)))))))))) & (forall v. (set(v) -> (elem(v,r) <-> (exists u. (set(u) & (elem(u,A) & (exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,u,s) & snoc(s,i,v,p)))))))))) & elem(p,P))))))))))) | ((~ (forall x. (set(x) -> (elem(x,A) -> (forall y. (set(y) -> (forall z. (set(z) -> ((exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,x,s) & snoc(s,i,y,p)))))))))) & elem(p,P)))) -> ((exists q. (set(q) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,x,s) & snoc(s,i,z,q)))))))))) & elem(q,P)))) -> eq(y,z))))))))))) & zero(r)))))))

# Congruence of the union and power relations in their set argument, in the form cong_elem_l has: a primitive's class
# read at its tuple carries the tuple's entry into the @def's body by it.
claim union_moves: forall a. forall b. forall r. (eq(a,b) -> (Union(a,r) -> Union(b,r)))
claim cong_Union_l: forall a. forall b. forall r. (eq(a,b) -> (Union(a,r) <-> Union(b,r)))
claim pow_moves: forall a. forall b. forall r. (eq(a,b) -> (Pow(a,r) -> Pow(b,r)))
claim cong_Pow_l: forall a. forall b. forall r. (eq(a,b) -> (Pow(a,r) <-> Pow(b,r)))

claim tup2_uniq: forall x. forall y. forall s. forall p. ((exists e. (set(e) & (zero(e) & (exists n. (set(n) & (nsucc(e, n) & (exists h. (set(h) & (snoc(e, e, x, h) & snoc(h, n, y, s)))))))))) -> ((exists e. (set(e) & (zero(e) & (exists n. (set(n) & (nsucc(e, n) & (exists h. (set(h) & (snoc(e, e, x, h) & snoc(h, n, y, p)))))))))) -> eq(s,p)))
claim slot_p_q: forall P. forall Q. ((forall t. (set(t) -> (elem(t, Q) <-> (exists x. (set(x) & (exists y. (set(y) & ((exists e. (set(e) & (zero(e) & (exists n. (set(n) & (nsucc(e, n) & (exists h. (set(h) & (snoc(e, e, x, h) & snoc(h, n, y, t)))))))))) & (exists s. (set(s) & ((exists e. (set(e) & (zero(e) & (exists n. (set(n) & (nsucc(e, n) & (exists h. (set(h) & (snoc(e, e, x, h) & snoc(h, n, y, s)))))))))) & elem(s, P)))))))))))) -> (forall x. (set(x) -> (forall y. (set(y) -> ((exists s. (set(s) & ((exists e. (set(e) & (zero(e) & (exists n. (set(n) & (nsucc(e, n) & (exists h. (set(h) & (snoc(e, e, x, h) & snoc(h, n, y, s)))))))))) & elem(s, P)))) -> (exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists n. (set(n) & (nsucc(e, n) & (exists h. (set(h) & (snoc(e, e, x, h) & snoc(h, n, y, p)))))))))) & elem(p, Q))))))))))
claim slot_q_p: forall P. forall Q. ((forall t. (set(t) -> (elem(t, Q) <-> (exists x. (set(x) & (exists y. (set(y) & ((exists e. (set(e) & (zero(e) & (exists n. (set(n) & (nsucc(e, n) & (exists h. (set(h) & (snoc(e, e, x, h) & snoc(h, n, y, t)))))))))) & (exists s. (set(s) & ((exists e. (set(e) & (zero(e) & (exists n. (set(n) & (nsucc(e, n) & (exists h. (set(h) & (snoc(e, e, x, h) & snoc(h, n, y, s)))))))))) & elem(s, P)))))))))))) -> (forall x. (set(x) -> (forall y. (set(y) -> ((exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists n. (set(n) & (nsucc(e, n) & (exists h. (set(h) & (snoc(e, e, x, h) & snoc(h, n, y, p)))))))))) & elem(p, Q)))) -> (exists s. (set(s) & ((exists e. (set(e) & (zero(e) & (exists n. (set(n) & (nsucc(e, n) & (exists h. (set(h) & (snoc(e, e, x, h) & snoc(h, n, y, s)))))))))) & elem(s, P))))))))))
claim ZF_Base.extension_NBG: forall A. (set(A) -> (forall B. (set(B) -> ((eq(A,B) -> ((forall x. (set(x) -> (elem(x,A) -> elem(x,B)))) & (forall x. (set(x) -> (elem(x,B) -> elem(x,A)))))) & (((forall x. (set(x) -> (elem(x,A) -> elem(x,B)))) & (forall x. (set(x) -> (elem(x,B) -> elem(x,A))))) -> eq(A,B))))))
claim ZF_Base.Union_iff_NBG: forall A. (set(A) -> (forall C. (set(C) -> (((exists u. (set(u) & (Union(C,u) & elem(A,u)))) -> (exists B. (set(B) & (elem(B,C) & elem(A,B))))) & ((exists B. (set(B) & (elem(B,C) & elem(A,B)))) -> (exists u. (set(u) & (Union(C,u) & elem(A,u)))))))))
claim ZF_Base.Pow_iff_NBG: forall A. (set(A) -> (forall B. (set(B) -> (((exists u. (set(u) & (Pow(B,u) & elem(A,u)))) -> (forall x. (set(x) -> (elem(x,A) -> elem(x,B))))) & ((forall x. (set(x) -> (elem(x,A) -> elem(x,B)))) -> (exists u. (set(u) & (Pow(B,u) & elem(A,u)))))))))
claim replacement_ex: ((forall P. (exists Q. (forall t. (set(t) -> (elem(t, Q) <-> (exists x. (set(x) & (exists y. (set(y) & ((exists e. (set(e) & (zero(e) & (exists n. (set(n) & (nsucc(e, n) & (exists h. (set(h) & (snoc(e, e, x, h) & snoc(h, n, y, t)))))))))) & (exists s. (set(s) & ((exists e. (set(e) & (zero(e) & (exists n. (set(n) & (nsucc(e, n) & (exists h. (set(h) & (snoc(e, e, x, h) & snoc(h, n, y, s)))))))))) & elem(s, P)))))))))))))) -> (forall A. (set(A) -> (forall P. (forall b. (set(b) -> ((forall x. (set(x) -> (elem(x, A) -> (forall y. (set(y) -> (forall z. (set(z) -> (((exists s. (set(s) & ((exists e. (set(e) & (zero(e) & (exists n. (set(n) & (nsucc(e, n) & (exists h. (set(h) & (snoc(e, e, x, h) & snoc(h, n, y, s)))))))))) & elem(s, P)))) & (exists s. (set(s) & ((exists e. (set(e) & (zero(e) & (exists n. (set(n) & (nsucc(e, n) & (exists h. (set(h) & (snoc(e, e, x, h) & snoc(h, n, z, s)))))))))) & elem(s, P))))) -> eq(y, z))))))))) -> (((exists Q. ((forall t. (set(t) -> (elem(t, Q) <-> (exists x. (set(x) & (exists y. (set(y) & ((exists e. (set(e) & (zero(e) & (exists n. (set(n) & (nsucc(e, n) & (exists h. (set(h) & (snoc(e, e, x, h) & snoc(h, n, y, t)))))))))) & (exists s. (set(s) & ((exists e. (set(e) & (zero(e) & (exists n. (set(n) & (nsucc(e, n) & (exists h. (set(h) & (snoc(e, e, x, h) & snoc(h, n, y, s)))))))))) & elem(s, P)))))))))))) & (exists u. (set(u) & (((((forall x. (set(x) -> (elem(x, A) -> (forall y. (set(y) -> (forall z. (set(z) -> ((exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists n. (set(n) & (nsucc(e, n) & (exists h. (set(h) & (snoc(e, e, x, h) & snoc(h, n, y, p)))))))))) & elem(p, Q)))) -> ((exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists n. (set(n) & (nsucc(e, n) & (exists h. (set(h) & (snoc(e, e, x, h) & snoc(h, n, z, p)))))))))) & elem(p, Q)))) -> eq(y, z)))))))))) & (forall v. (set(v) -> (elem(v, u) <-> (exists x. (set(x) & (elem(x, A) & (exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists n. (set(n) & (nsucc(e, n) & (exists h. (set(h) & (snoc(e, e, x, h) & snoc(h, n, v, p)))))))))) & elem(p, Q))))))))))) | ((~ (forall x. (set(x) -> (elem(x, A) -> (forall y. (set(y) -> (forall z. (set(z) -> ((exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists n. (set(n) & (nsucc(e, n) & (exists h. (set(h) & (snoc(e, e, x, h) & snoc(h, n, y, p)))))))))) & elem(p, Q)))) -> ((exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists n. (set(n) & (nsucc(e, n) & (exists h. (set(h) & (snoc(e, e, x, h) & snoc(h, n, z, p)))))))))) & elem(p, Q)))) -> eq(y, z))))))))))) & zero(u)))) & elem(b, u)))))) -> (exists x. (set(x) & (elem(x, A) & (exists s. (set(s) & ((exists e. (set(e) & (zero(e) & (exists n. (set(n) & (nsucc(e, n) & (exists h. (set(h) & (snoc(e, e, x, h) & snoc(h, n, b, s)))))))))) & elem(s, P)))))))) & ((exists x. (set(x) & (elem(x, A) & (exists s. (set(s) & ((exists e. (set(e) & (zero(e) & (exists n. (set(n) & (nsucc(e, n) & (exists h. (set(h) & (snoc(e, e, x, h) & snoc(h, n, b, s)))))))))) & elem(s, P))))))) -> (exists Q. ((forall t. (set(t) -> (elem(t, Q) <-> (exists x. (set(x) & (exists y. (set(y) & ((exists e. (set(e) & (zero(e) & (exists n. (set(n) & (nsucc(e, n) & (exists h. (set(h) & (snoc(e, e, x, h) & snoc(h, n, y, t)))))))))) & (exists s. (set(s) & ((exists e. (set(e) & (zero(e) & (exists n. (set(n) & (nsucc(e, n) & (exists h. (set(h) & (snoc(e, e, x, h) & snoc(h, n, y, s)))))))))) & elem(s, P)))))))))))) & (exists u. (set(u) & (((((forall x. (set(x) -> (elem(x, A) -> (forall y. (set(y) -> (forall z. (set(z) -> ((exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists n. (set(n) & (nsucc(e, n) & (exists h. (set(h) & (snoc(e, e, x, h) & snoc(h, n, y, p)))))))))) & elem(p, Q)))) -> ((exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists n. (set(n) & (nsucc(e, n) & (exists h. (set(h) & (snoc(e, e, x, h) & snoc(h, n, z, p)))))))))) & elem(p, Q)))) -> eq(y, z)))))))))) & (forall v. (set(v) -> (elem(v, u) <-> (exists x. (set(x) & (elem(x, A) & (exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists n. (set(n) & (nsucc(e, n) & (exists h. (set(h) & (snoc(e, e, x, h) & snoc(h, n, v, p)))))))))) & elem(p, Q))))))))))) | ((~ (forall x. (set(x) -> (elem(x, A) -> (forall y. (set(y) -> (forall z. (set(z) -> ((exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists n. (set(n) & (nsucc(e, n) & (exists h. (set(h) & (snoc(e, e, x, h) & snoc(h, n, y, p)))))))))) & elem(p, Q)))) -> ((exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists n. (set(n) & (nsucc(e, n) & (exists h. (set(h) & (snoc(e, e, x, h) & snoc(h, n, z, p)))))))))) & elem(p, Q)))) -> eq(y, z))))))))))) & zero(u)))) & elem(b, u)))))))))))))))
claim tup2_ue: forall x. (set(x) -> (forall y. (forall t. ((exists e. (set(e) & (zero(e) & (exists n. (set(n) & (nsucc(e, n) & (exists h. (set(h) & (snoc(e, e, x, h) & snoc(h, n, y, t)))))))))) <-> (forall e. (set(e) -> (zero(e) -> (forall n. (set(n) -> (nsucc(e, n) -> (forall h. (set(h) -> (snoc(e, e, x, h) -> snoc(h, n, y, t))))))))))))))
