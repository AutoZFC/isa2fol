    fix P
    fix A
    _sA = assume set(A)
    _lf = let (forall x. (set(x) -> (elem(x,A) -> (forall y. (set(y) -> (forall z. (set(z) -> ((exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,x,s) & snoc(s,i,y,p)))))))))) & elem(p,P)))) -> ((exists q. (set(q) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,x,s) & snoc(s,i,z,q)))))))))) & elem(q,P)))) -> eq(y,z))))))))))
    _em = excluded_middle _lf
    _hF = assume (forall x. (set(x) -> (elem(x,A) -> (forall y. (set(y) -> (forall z. (set(z) -> ((exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,x,s) & snoc(s,i,y,p)))))))))) & elem(p,P)))) -> ((exists q. (set(q) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,x,s) & snoc(s,i,z,q)))))))))) & elem(q,P)))) -> eq(y,z))))))))))
    _ez = exists_elim _zx, e0
    _se0 = and_elim_l _ez
    _ze0 = and_elim_r _ez
    _n1 = forall_elim _nx, e0
    _n2 = implies_elim _n1, _se0
