    _fk = and_intro _fj, _fa
    _fl = and_intro _f7, _fk
    _fm = exists_intro _fl, a2
    _fn = exists_intro _fm
    _fo = exists_intro _fn
    _fwd = implies_intro _fo
    _b0 = assume (exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,u,s) & snoc(s,i,v,p)))))))))) & elem(p,P))))
    _b1 = exists_elim _b0, p0
