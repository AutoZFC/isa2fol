    _bu4 = or_elim _mu2, _dcase1, _dcase2
    _m1 = and_intro _mu2, _bu4
    _m2 = and_intro _su2, _m1
    _m3 = exists_intro _m2, u2
    _m4 = exists_intro _m3
    _m5 = and_intro _eQ2, _m4
    _m6 = exists_intro _m5, Q2
    _m7 = exists_intro _m6
    _g = implies_intro _m7
    _both = and_intro _f, _g
    _o1 = implies_intro _both
    _o2 = implies_intro _o1
    _o3 = forall_intro _o2
    _o4 = forall_intro _o3
    _o5 = implies_intro _o4
    _o6 = forall_intro _o5
    _o7 = implies_intro _o6
    qed _o7

proof ZF_Base.foundation_NBG:
    _rg = use regularity
    _zx = use ZF_Base.zero_EX
    _zd = use ZF_Base.zero_def
    _z0 = use zero_def
    _e = use extensionality
    fix A
    _sA = assume set(A)
    _m = let exists u. (set(u) & elem(u,A))
    _em = excluded_middle _m
    _h1 = assume exists u. (set(u) & elem(u,A))
    _r1 = forall_elim _rg, A
    _r2 = implies_elim _r1, _h1
    _eu = exists_elim _r2, x
    _sx = and_elim_l _eu
    _rx = and_elim_r _eu
    _xa = and_elim_l _rx
    _dis = and_elim_r _rx
    fix y
    _sy = assume set(y)
    _yx = assume elem(y,x)
    _ya = assume elem(y,A)
    _d1 = forall_elim _dis, y
    _d2 = implies_elim _d1, _sy
    _d3 = implies_elim _d2, _yx
    _bot = not_elim _d3, _ya
    _i1 = implies_intro _bot
    _i2 = implies_intro _i1
    _i3 = implies_intro _i2
    _min = forall_intro _i3
    _c1 = and_intro _xa, _min
    _c2 = and_intro _sx, _c1
    _w = exists_intro _c2, x
    _w2 = exists_intro _w
    _left = let exists v. (set(v) & (ZF_Base.zero(v) & eq(A,v)))
    _or1 = or_intro_r _left, _w2
    _case1 = implies_intro _or1
    _h2 = assume ~ (exists u. (set(u) & elem(u,A)))
    _z1 = exists_elim _zx, v
    _sv = and_elim_l _z1
    _zv = and_elim_r _z1
    _zd1 = forall_elim _zd, v
    _zv2 = iff_elim_l _zd1, _zv
    _z01 = forall_elim _z0, v
    _ev = iff_elim_l _z01, _zv2
    fix u
    _su = assume set(u)
    _ua = assume elem(u,A)
    _cu = and_intro _su, _ua
    _xu = exists_intro _cu, u
    _b1 = not_elim _h2, _xu
    _uvf = let elem(u,v)
    _uv = bottom_elim _b1, _uvf
    _k1 = implies_intro _uv
    _uv2 = assume elem(u,v)
    _n1 = forall_elim _ev, u
    _n2 = implies_elim _n1, _su
    _b2 = not_elim _n2, _uv2
    _uaf = let elem(u,A)
    _ua2 = bottom_elim _b2, _uaf
    _k2 = implies_intro _ua2
    _kk = iff_intro _k1, _k2
    _k3 = implies_intro _kk
    _allu = forall_intro _k3
    _e1 = forall_elim _e, A
    _e2 = forall_elim _e1, v
    _eqAv = iff_elim_r _e2, _allu
    _c3 = and_intro _zv, _eqAv
    _c4 = and_intro _sv, _c3
    _l1 = exists_intro _c4, v
    _l2 = exists_intro _l1
    _right = let exists x. (set(x) & (elem(x,A) & (forall y. (set(y) -> (elem(y,x) -> (elem(y,A) -> false))))))
    _or2 = or_intro_l _l2, _right
    _case2 = implies_intro _or2
    _res = or_elim _em, _case1, _case2
    _o1 = implies_intro _res
    _o2 = forall_intro _o1
    qed _o2

proof ZF_Base.infinity_NBG:
    _zx = use ZF_Base.zero_EX
    _ix = use ZF_Base.Inf_EX
    _zd = use ZF_Base.zero_def
    _z0 = use zero_def
    _idf = use ZF_Base.Inf_def
    _inf = use Inf_def
    _ind = use ind_def
    _ee = use empty_eq
    _efs = use elem_first_subst
    _a1 = exists_elim _zx, v
    _sv = and_elim_l _a1
    _zv = and_elim_r _a1
    _a2 = exists_elim _ix, w
    _sw = and_elim_l _a2
    _iw = and_elim_r _a2
    _b1 = forall_elim _idf, w
    _b2 = iff_elim_l _b1, _iw
    _b3 = forall_elim _inf, w
    _b4 = iff_elim_l _b3, _b2
    _b5 = and_elim_l _b4
    _b6 = forall_elim _ind, w
    _b7 = iff_elim_l _b6, _b5
    _b8 = and_elim_l _b7
    _c1 = exists_elim _b8, e
    _ce = and_elim_r _c1
    _ew = and_elim_l _ce
    _emp = and_elim_r _ce
    _d1 = forall_elim _zd, v
    _d2 = iff_elim_l _d1, _zv
    _d3 = forall_elim _z0, v
    _d4 = iff_elim_l _d3, _d2
    _e1 = forall_elim _ee, e
    _e2 = forall_elim _e1, v
    _e3 = implies_elim _e2, _emp
    _ev = implies_elim _e3, _d4
    _f1 = forall_elim _efs, e
    _f2 = forall_elim _f1, v
    _f3 = forall_elim _f2, w
    _f4 = implies_elim _f3, _ev
    _vw = implies_elim _f4, _ew
    _g1 = and_intro _iw, _vw
    _g2 = and_intro _sw, _g1
    _g3 = exists_intro _g2, w
    _g4 = and_intro _zv, _g3
    _g5 = and_intro _sv, _g4
    _g6 = exists_intro _g5, v
    _g7 = exists_intro _g6
    _g8 = exists_intro _g7
    _g9 = exists_intro _g8
    fix y
    _sy = assume set(y)
    _hy = assume exists w. (set(w) & (ZF_Base.Inf(w) & elem(y,w)))
    _h1 = exists_elim _hy, w2
    _sw2 = and_elim_l _h1
    _h2 = and_elim_r _h1
    _iw2 = and_elim_l _h2
    _yw2 = and_elim_r _h2
    _k1 = forall_elim _idf, w2
    _k2 = iff_elim_l _k1, _iw2
    _k3 = forall_elim _inf, w2
    _k4 = iff_elim_l _k3, _k2
    _k5 = and_elim_l _k4
    _k6 = forall_elim _ind, w2
    _k7 = iff_elim_l _k6, _k5
    _k8 = and_elim_r _k7
    _k9 = forall_elim _k8, y
    _k10 = implies_elim _k9, _sy
    _k11 = implies_elim _k10, _yw2
    _l1 = exists_elim _k11, s
    _ss = and_elim_l _l1
    _l2 = and_elim_r _l1
    _swi = and_elim_l _l2
    _mem = and_elim_r _l2
    fix z
    _sz = assume set(z)
    _m1 = forall_elim _mem, z
    _m2 = implies_elim _m1, _sz
    _p = assume elem(z,s)
    _q = iff_elim_l _m2, _p
    _a = assume elem(z,y)
    _la = let eq(z,y)
    _o1 = or_intro_r _la, _a
    _ia = implies_intro _o1
    _b = assume eq(z,y)
    _lb = let elem(z,y)
    _o2 = or_intro_l _b, _lb
    _ib = implies_intro _o2
    _sw1 = or_elim _q, _ia, _ib
    _i1 = implies_intro _sw1
    _p2 = assume eq(z,y) | elem(z,y)
    _a2 = assume eq(z,y)
    _la2 = let elem(z,y)
    _o3 = or_intro_r _la2, _a2
    _ia2 = implies_intro _o3
    _b2 = assume elem(z,y)
    _lb2 = let eq(z,y)
    _o4 = or_intro_l _b2, _lb2
    _ib2 = implies_intro _o4
    _q2 = or_elim _p2, _ia2, _ib2
    _zs = iff_elim_r _m2, _q2
    _i2 = implies_intro _zs
    _bi = iff_intro _i1, _i2
    _bz = implies_intro _bi
    _all = forall_intro _bz
    _n1 = and_intro _iw2, _swi
    _n2 = and_intro _sw2, _n1
    _n3 = exists_intro _n2, w2
    _n4 = and_intro _all, _n3
    _n5 = and_intro _ss, _n4
    _n6 = exists_intro _n5, s
    _n7 = exists_intro _n6
    _n8 = exists_intro _n7
    _n9 = implies_intro _n8
    _n10 = implies_intro _n9
    _n11 = forall_intro _n10
    _r = and_intro _g9, _n11
    qed _r
