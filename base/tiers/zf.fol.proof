proof ZF_Base.zero_EX:
    _cd = use ZF_Base.zero_def
    _ex = use zero_EX
    _w = exists_elim _ex, v
    _sv = and_elim_l _w
    _rv = and_elim_r _w
    _d = forall_elim _cd, v
    _cv = iff_elim_r _d, _rv
    _both = and_intro _sv, _cv
    _out = exists_intro _both
    qed _out

proof ZF_Base.Inf_EX:
    _cd = use ZF_Base.Inf_def
    _ex = use Inf_EX
    _w = exists_elim _ex, v
    _sv = and_elim_l _w
    _rv = and_elim_r _w
    _d = forall_elim _cd, v
    _cv = iff_elim_r _d, _rv
    _both = and_intro _sv, _cv
    _out = exists_intro _both
    qed _out

proof ZF_Base.zero_UNIQ:
    _cd = use ZF_Base.zero_def
    _un = use zero_UNIQ
    fix v
    _sv = assume set(v)
    fix w
    _sw = assume set(w)
    _hv = assume ZF_Base.zero(v)
    _hw = assume ZF_Base.zero(w)
    _dv = forall_elim _cd, v
    _cv = iff_elim_l _dv, _hv
    _dw = forall_elim _cd, w
    _cw = iff_elim_l _dw, _hw
    _u1 = forall_elim _un, v
    _u2 = implies_elim _u1, _sv
    _u3 = forall_elim _u2, w
    _u4 = implies_elim _u3, _sw
    _u5 = implies_elim _u4, _cv
    _eq = implies_elim _u5, _cw
    _o1 = implies_intro _eq
    _o2 = implies_intro _o1
    _o3 = implies_intro _o2
    _g1 = forall_intro _o3
    _o4 = implies_intro _g1
    _g2 = forall_intro _o4
    qed _g2

proof ZF_Base.Inf_UNIQ:
    _cd = use ZF_Base.Inf_def
    _un = use Inf_UNIQ
    fix v
    _sv = assume set(v)
    fix w
    _sw = assume set(w)
    _hv = assume ZF_Base.Inf(v)
    _hw = assume ZF_Base.Inf(w)
    _dv = forall_elim _cd, v
    _cv = iff_elim_l _dv, _hv
    _dw = forall_elim _cd, w
    _cw = iff_elim_l _dw, _hw
    _u1 = forall_elim _un, v
    _u2 = implies_elim _u1, _sv
    _u3 = forall_elim _u2, w
    _u4 = implies_elim _u3, _sw
    _u5 = implies_elim _u4, _cv
    _eq = implies_elim _u5, _cw
    _o1 = implies_intro _eq
    _o2 = implies_intro _o1
    _o3 = implies_intro _o2
    _g1 = forall_intro _o3
    _o4 = implies_intro _g1
    _g2 = forall_intro _o4
    qed _g2

proof class_subst:
    _cs = use cong_snoc_v
    fix a
    _sa = assume set(a)
    fix b
    _sb = assume set(b)
    fix P
    _h = assume eq(a,b)
    _pa = assume (forall t. (set(t) -> ((forall e. (set(e) -> (zero(e) -> snoc(e,e,a,t)))) -> elem(t,P))))
    fix t
    _st = assume set(t)
    _tb = assume (forall e. (set(e) -> (zero(e) -> snoc(e,e,b,t))))
    fix e
    _se = assume set(e)
    _ze = assume zero(e)
    _b1 = forall_elim _tb, e
    _b2 = implies_elim _b1, _se
    _b3 = implies_elim _b2, _ze
    _c1 = forall_elim _cs, e
    _c2 = forall_elim _c1, e
    _c3 = forall_elim _c2, a
    _c4 = forall_elim _c3, b
    _c5 = forall_elim _c4, t
    _c6 = implies_elim _c5, _h
    _sna = iff_elim_r _c6, _b3
    _i1 = implies_intro _sna
    _i2 = implies_intro _i1
    _ta = forall_intro _i2
    _p1 = forall_elim _pa, t
    _p2 = implies_elim _p1, _st
    _p3 = implies_elim _p2, _ta
    _i3 = implies_intro _p3
    _i4 = implies_intro _i3
    _g0 = forall_intro _i4
    _i5 = implies_intro _g0
    _i6 = implies_intro _i5
    _g1 = forall_intro _i6
    _i7 = implies_intro _g1
    _g2 = forall_intro _i7
    _i8 = implies_intro _g2
    _g3 = forall_intro _i8
    qed _g3

