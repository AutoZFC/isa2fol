    _k2 = implies_elim _k1, _se0
    _k3 = forall_elim _k2, n1
    _k4 = implies_elim _k3, _sn1
    _k5 = forall_elim _k4, P
    _k6 = forall_elim _k5, e0
    _k7 = implies_elim _k6, _se0
