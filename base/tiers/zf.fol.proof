    _IMG = forall_intro _ix
    _fi2 = and_intro _hF, _IMG
    _lr = let ((~ (forall x. (set(x) -> (elem(x,A) -> (forall y. (set(y) -> (forall z. (set(z) -> ((exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,x,s) & snoc(s,i,y,p)))))))))) & elem(p,P)))) -> ((exists q. (set(q) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,x,s) & snoc(s,i,z,q)))))))))) & elem(q,P)))) -> eq(y,z))))))))))) & zero(r))
