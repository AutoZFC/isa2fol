    _sv = assume set(v)
    _ga1 = forall_elim _eG, u
    _ga2 = implies_elim _ga1, _su
    _ga3 = forall_elim _ga2, v
    _ga4 = implies_elim _ga3, _sv
    _ya1 = forall_elim _eY, u
    _ya2 = implies_elim _ya1, _su
    _ya3 = forall_elim _ya2, v
    _ya4 = implies_elim _ya3, _sv
    _xa1 = forall_elim _eX, v
    _xa2 = implies_elim _xa1, _sv
    _xa3 = forall_elim _xa2, u
    _xa4 = implies_elim _xa3, _su
    _ka1 = forall_elim _eK, u
    _ka2 = implies_elim _ka1, _su
    _ka3 = forall_elim _ka2, v
    _ka4 = implies_elim _ka3, _sv
    _yb = schema_inst iff_trans { A: pmem(u,v,Y), B: pmem(v,u,X), C: elem(u,A) }
    _yc = implies_elim _yb, _ya4
