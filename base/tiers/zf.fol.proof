    _c4 = implies_elim _c3, _se0
    _c5 = implies_elim _c4, _b9
    _c6 = implies_elim _c5, _ze0
    _c7 = forall_elim _er, u
    _d1 = forall_elim _sc, e1
    _d2 = forall_elim _d1, e0
    _d3 = forall_elim _d2, e1
    _d4 = forall_elim _d3, e0
    _d5 = forall_elim _d4, u
    _d6 = forall_elim _d5, u
    _d7 = forall_elim _d6, s1
    _d8 = implies_elim _d7, _c6
    _d9 = implies_elim _d8, _c6
    _da = implies_elim _d9, _c7
    _db = implies_elim _da, _bj
    _e1 = forall_elim _nc, e1
    _e2 = forall_elim _e1, e0
    _e3 = forall_elim _e2, i1
    _e4 = implies_elim _e3, _c6
    _e5 = implies_elim _e4, _be
    _e6 = forall_elim _nu, e0
    _e7 = forall_elim _e6, i1
    _e8 = forall_elim _e7, n1
    _e9 = implies_elim _e8, _e5
    _ea = implies_elim _e9, _nn1
    _eb = forall_elim _er, s1
    _ec = forall_elim _er, v
    _h1 = forall_elim _sc, s1
    _h2 = forall_elim _h1, s1
    _h3 = forall_elim _h2, i1
    _h4 = forall_elim _h3, n1
    _h5 = forall_elim _h4, v
    _h6 = forall_elim _h5, v
    _h7 = forall_elim _h6, p0
    _h8 = implies_elim _h7, _eb
    _h9 = implies_elim _h8, _ea
    _ha = implies_elim _h9, _ec
    _hb = implies_elim _ha, _bk
    _hc = and_intro _hb, _b5
    _hd = and_intro _b2, _hc
    _he = exists_intro _hd, p0
    _hf = and_intro _db, _he
    _hg = and_intro _bh, _hf
    _hh = exists_intro _hg, s1
    _hi = exists_intro _hh
    _hj = exists_intro _hi
    _hk = exists_intro _hj
    _hl = exists_intro _hk
    _bwd = implies_intro _hl
    _kt = iff_intro _fwd, _bwd
    _kb = schema_inst iff_trans { A: pmem(u,v,K), B: (exists a1. (set(a1) & (snoc(e0,e0,u,a1) & (exists a2. (set(a2) & (snoc(a1,n1,v,a2) & elem(a2,P))))))), C: (exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,u,s) & snoc(s,i,v,p)))))))))) & elem(p,P)))) }
    _kc = implies_elim _kb, _ka4
    _kd = implies_elim _kc, _kt
    _ca = schema_inst cong_and { A: pmem(u,v,Y), A2: elem(u,A), B: pmem(u,v,K), B2: (exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,u,s) & snoc(s,i,v,p)))))))))) & elem(p,P)))) }
    _cb = implies_elim _ca, _yd
    _cc = implies_elim _cb, _kd
    _cd = schema_inst iff_trans { A: pmem(u,v,G), B: (pmem(u,v,Y) & pmem(u,v,K)), C: (elem(u,A) & (exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,u,s) & snoc(s,i,v,p)))))))))) & elem(p,P))))) }
    _ce = implies_elim _cd, _ga4
    _cf = implies_elim _ce, _cc
    _cg = implies_intro _cf
    _ch = forall_intro _cg
    _ci = implies_intro _ch
    _GK = forall_intro _ci
    fix u
    _su2 = assume set(u)
    fix v
    _sv2 = assume set(v)
    fix w
    _sw2 = assume set(w)
    _hv = assume pmem(u,v,G)
    _hw = assume pmem(u,w,G)
    _m1 = forall_elim _GK, u
    _m2 = implies_elim _m1, _su2
    _m3 = forall_elim _m2, v
    _m4 = implies_elim _m3, _sv2
    _m5 = iff_elim_l _m4, _hv
    _m6 = and_elim_l _m5
    _m7 = and_elim_r _m5
    _m8 = forall_elim _m2, w
    _m9 = implies_elim _m8, _sw2
    _ma = iff_elim_l _m9, _hw
    _mb = and_elim_r _ma
    _mc = forall_elim _hF, u
    _md = implies_elim _mc, _su2
    _me = implies_elim _md, _m6
    _mf = forall_elim _me, v
    _mg = implies_elim _mf, _sv2
    _mh = forall_elim _mg, w
    _mi = implies_elim _mh, _sw2
    _mj = implies_elim _mi, _m7
    _mk = implies_elim _mj, _mb
    _ml = implies_intro _mk
    _mm = implies_intro _ml
    _mn = implies_intro _mm
    _mo = forall_intro _mn
    _mp = implies_intro _mo
    _mq = forall_intro _mp
    _mr = implies_intro _mq
    _fun = forall_intro _mr
    _p1 = forall_elim _pe, G
    _p2 = implies_elim _p1, _fun
    _p3 = forall_elim _p2, A
    _p4 = implies_elim _p3, _sA
    _er0 = exists_elim _p4, r
    _sr = and_elim_l _er0
    _pr = and_elim_r _er0
    _q1 = forall_elim _pd, A
    _q2 = forall_elim _q1, G
    _q3 = forall_elim _q2, r
    _im = iff_elim_l _q3, _pr
    fix v
    _sv3 = assume set(v)
    _iv1 = forall_elim _im, v
    _iv = implies_elim _iv1, _sv3
    fix u
    _su3 = assume set(u)
    _j1 = forall_elim _GK, u
    _j2 = implies_elim _j1, _su3
    _j3 = forall_elim _j2, v
    _j4 = implies_elim _j3, _sv3
    _j5 = assume (elem(u,A) & pmem(u,v,G))
    _j6 = and_elim_l _j5
    _j7 = and_elim_r _j5
    _j8 = iff_elim_l _j4, _j7
    _j9 = and_elim_r _j8
    _ja = and_intro _j6, _j9
    _jf = implies_intro _ja
    _jb = assume (elem(u,A) & (exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,u,s) & snoc(s,i,v,p)))))))))) & elem(p,P)))))
    _jc = and_elim_l _jb
    _jd = iff_elim_r _j4, _jb
    _je = and_intro _jc, _jd
    _jg = implies_intro _je
    _jh = iff_intro _jf, _jg
    _ji = implies_intro _jh
    _ce2 = forall_intro _ji
    _cx = schema_inst cong_exists { P: \u. (elem(u,A) & pmem(u,v,G)), Q: \u. (elem(u,A) & (exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,u,s) & snoc(s,i,v,p)))))))))) & elem(p,P))))) }
    _cy = implies_elim _cx, _ce2
    _it = schema_inst iff_trans { A: elem(v,r), B: (exists u. (set(u) & (elem(u,A) & pmem(u,v,G)))), C: (exists u. (set(u) & (elem(u,A) & (exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,u,s) & snoc(s,i,v,p)))))))))) & elem(p,P))))))) }
    _iu = implies_elim _it, _iv
    _iw = implies_elim _iu, _cy
    _ix = implies_intro _iw
    _IMG = forall_intro _ix
    _fi2 = and_intro _hF, _IMG
    _lr = let ((~ (forall x. (set(x) -> (elem(x,A) -> (forall y. (set(y) -> (forall z. (set(z) -> ((exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,x,s) & snoc(s,i,y,p)))))))))) & elem(p,P)))) -> ((exists q. (set(q) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,x,s) & snoc(s,i,z,q)))))))))) & elem(q,P)))) -> eq(y,z))))))))))) & zero(r))
    _mx = or_intro_l _fi2, _lr
    _sm = and_intro _sr, _mx
    _ex = exists_intro _sm, r
    _z0 = exists_intro _ex
    _z1 = exists_intro _z0
    _z2 = exists_intro _z1
    _z3 = exists_intro _z2
    _z4 = exists_intro _z3
    _z5 = exists_intro _z4
    _z6 = exists_intro _z5
    _caseF = implies_intro _z6
    _hN = assume (~ (forall x. (set(x) -> (elem(x,A) -> (forall y. (set(y) -> (forall z. (set(z) -> ((exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,x,s) & snoc(s,i,y,p)))))))))) & elem(p,P)))) -> ((exists q. (set(q) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,x,s) & snoc(s,i,z,q)))))))))) & elem(q,P)))) -> eq(y,z)))))))))))
    _ez2 = exists_elim _zx, r0
    _sr0 = and_elim_l _ez2
    _zr0 = and_elim_r _ez2
    _nz = and_intro _hN, _zr0
    _ll = let ((forall x. (set(x) -> (elem(x,A) -> (forall y. (set(y) -> (forall z. (set(z) -> ((exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,x,s) & snoc(s,i,y,p)))))))))) & elem(p,P)))) -> ((exists q. (set(q) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,x,s) & snoc(s,i,z,q)))))))))) & elem(q,P)))) -> eq(y,z)))))))))) & (forall v. (set(v) -> (elem(v,r0) <-> (exists u. (set(u) & (elem(u,A) & (exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,u,s) & snoc(s,i,v,p)))))))))) & elem(p,P)))))))))))
    _mx2 = or_intro_r _ll, _nz
    _sm2 = and_intro _sr0, _mx2
    _ex2 = exists_intro _sm2, r0
    _cl2 = exists_intro _ex2
    _caseN = implies_intro _cl2
    _res = or_elim _em, _caseF, _caseN
    _w1 = implies_intro _res
    _w2 = forall_intro _w1
    _w3 = forall_intro _w2
    qed _w3

proof union_moves:
    _ud = use Union_def
    _es = use elem_second
    _sym = use eq_symm
    fix a
    fix b
    fix r
    _h = assume eq(a,b)
    _ha = assume Union(a,r)
    _d1 = forall_elim _ud, a
    _d2 = forall_elim _d1, r
    _da = iff_elim_l _d2, _ha
    _sy1 = forall_elim _sym, a
    _sy2 = forall_elim _sy1, b
    _hba = implies_elim _sy2, _h
    fix x
    _sx = assume set(x)
    _dx0 = forall_elim _da, x
    _dx = implies_elim _dx0, _sx
    _p = assume elem(x,r)
    _q = iff_elim_l _dx, _p
    _ey = exists_elim _q, y
    _sy = and_elim_l _ey
    _ry = and_elim_r _ey
    _ya = and_elim_l _ry
    _xy = and_elim_r _ry
    _m1 = forall_elim _es, a
    _m2 = forall_elim _m1, b
    _m3 = forall_elim _m2, y
    _m4 = implies_elim _m3, _h
    _yb = implies_elim _m4, _ya
    _c1 = and_intro _yb, _xy
    _c2 = and_intro _sy, _c1
    _w = exists_intro _c2, y
    _w2 = exists_intro _w
    _f = implies_intro _w2
    _p2 = assume exists y. (set(y) & (elem(y,b) & elem(x,y)))
    _ey2 = exists_elim _p2, y2
    _sy2b = and_elim_l _ey2
    _ry2 = and_elim_r _ey2
    _yb2 = and_elim_l _ry2
    _xy2 = and_elim_r _ry2
    _n1 = forall_elim _es, b
    _n2 = forall_elim _n1, a
    _n3 = forall_elim _n2, y2
    _n4 = implies_elim _n3, _hba
    _ya2 = implies_elim _n4, _yb2
    _c3 = and_intro _ya2, _xy2
    _c4 = and_intro _sy2b, _c3
    _w3 = exists_intro _c4, y2
    _w4 = exists_intro _w3
    _xr = iff_elim_r _dx, _w4
    _g = implies_intro _xr
    _bi = iff_intro _f, _g
    _bix = implies_intro _bi
    _all = forall_intro _bix
    _d3 = forall_elim _ud, b
    _d4 = forall_elim _d3, r
    _ub = iff_elim_r _d4, _all
    _i1 = implies_intro _ub
    _i2 = implies_intro _i1
    _q3 = forall_intro _i2
    _q4 = forall_intro _q3
    _q5 = forall_intro _q4
    qed _q5

proof cong_Union_l:
    _mv = use union_moves
    _sym = use eq_symm
    fix a
    fix b
    fix r
    _h = assume eq(a,b)
    _m1 = forall_elim _mv, a
    _m2 = forall_elim _m1, b
    _m3 = forall_elim _m2, r
    _f = implies_elim _m3, _h
    _s1 = forall_elim _sym, a
    _s2 = forall_elim _s1, b
    _hba = implies_elim _s2, _h
    _n1 = forall_elim _mv, b
    _n2 = forall_elim _n1, a
    _n3 = forall_elim _n2, r
    _g = implies_elim _n3, _hba
    _bi = iff_intro _f, _g
    _i = implies_intro _bi
    _q1 = forall_intro _i
    _q2 = forall_intro _q1
    _q3 = forall_intro _q2
    qed _q3

proof pow_moves:
    _pd = use Pow_def
    _es = use elem_second
    _sym = use eq_symm
    fix a
    fix b
    fix r
    _h = assume eq(a,b)
    _ha = assume Pow(a,r)
    _d1 = forall_elim _pd, a
    _d2 = forall_elim _d1, r
    _da = iff_elim_l _d2, _ha
    _sy1 = forall_elim _sym, a
    _sy2 = forall_elim _sy1, b
    _hba = implies_elim _sy2, _h
    fix u
    _su = assume set(u)
    _du0 = forall_elim _da, u
    _du = implies_elim _du0, _su
    _p = assume elem(u,r)
    _q = iff_elim_l _du, _p
    fix v
    _sv = assume set(v)
    _vu = assume elem(v,u)
    _q1 = forall_elim _q, v
    _q2 = implies_elim _q1, _sv
    _va = implies_elim _q2, _vu
    _m1 = forall_elim _es, a
    _m2 = forall_elim _m1, b
    _m3 = forall_elim _m2, v
    _m4 = implies_elim _m3, _h
    _vb = implies_elim _m4, _va
    _i1 = implies_intro _vb
    _i2 = implies_intro _i1
    _all = forall_intro _i2
    _f = implies_intro _all
    _p2 = assume forall v. (set(v) -> (elem(v,u) -> elem(v,b)))
    fix w
    _sw = assume set(w)
    _wu = assume elem(w,u)
    _r1 = forall_elim _p2, w
    _r2 = implies_elim _r1, _sw
    _wb = implies_elim _r2, _wu
    _n1 = forall_elim _es, b
    _n2 = forall_elim _n1, a
    _n3 = forall_elim _n2, w
    _n4 = implies_elim _n3, _hba
    _wa = implies_elim _n4, _wb
    _j1 = implies_intro _wa
    _j2 = implies_intro _j1
    _all2 = forall_intro _j2
    _ur = iff_elim_r _du, _all2
    _g = implies_intro _ur
    _bi = iff_intro _f, _g
    _bu = implies_intro _bi
    _allu = forall_intro _bu
    _d3 = forall_elim _pd, b
    _d4 = forall_elim _d3, r
    _pb = iff_elim_r _d4, _allu
    _k1 = implies_intro _pb
    _k2 = implies_intro _k1
    _q3 = forall_intro _k2
    _q4 = forall_intro _q3
    _q5 = forall_intro _q4
    qed _q5

proof cong_Pow_l:
    _mv = use pow_moves
    _sym = use eq_symm
    fix a
    fix b
    fix r
    _h = assume eq(a,b)
    _m1 = forall_elim _mv, a
    _m2 = forall_elim _m1, b
    _m3 = forall_elim _m2, r
    _f = implies_elim _m3, _h
    _s1 = forall_elim _sym, a
    _s2 = forall_elim _s1, b
    _hba = implies_elim _s2, _h
    _n1 = forall_elim _mv, b
    _n2 = forall_elim _n1, a
    _n3 = forall_elim _n2, r
    _g = implies_elim _n3, _hba
    _bi = iff_intro _f, _g
