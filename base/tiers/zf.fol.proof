    _d7 = forall_elim _d6, s1
    _d8 = implies_elim _d7, _c6
    _d9 = implies_elim _d8, _c6
    _da = implies_elim _d9, _c7
    _db = implies_elim _da, _bj
    _e1 = forall_elim _nc, e1
    _e2 = forall_elim _e1, e0
    _e3 = forall_elim _e2, i1
    _e4 = implies_elim _e3, _c6
    _e5 = implies_elim _e4, _be
    _e6 = forall_elim _nu, e0
    _e7 = forall_elim _e6, i1
    _e8 = forall_elim _e7, n1
    _e9 = implies_elim _e8, _e5
    _ea = implies_elim _e9, _nn1
    _eb = forall_elim _er, s1
    _ec = forall_elim _er, v
    _h1 = forall_elim _sc, s1
    _h2 = forall_elim _h1, s1
    _h3 = forall_elim _h2, i1
    _h4 = forall_elim _h3, n1
    _h5 = forall_elim _h4, v
    _h6 = forall_elim _h5, v
    _h7 = forall_elim _h6, p0
    _h8 = implies_elim _h7, _eb
    _h9 = implies_elim _h8, _ea
    _ha = implies_elim _h9, _ec
    _hb = implies_elim _ha, _bk
    _hc = and_intro _hb, _b5
    _hd = and_intro _b2, _hc
    _he = exists_intro _hd, p0
    _hf = and_intro _db, _he
    _hg = and_intro _bh, _hf
    _hh = exists_intro _hg, s1
    _hi = exists_intro _hh
    _hj = exists_intro _hi
    _hk = exists_intro _hj
    _hl = exists_intro _hk
    _bwd = implies_intro _hl
    _kt = iff_intro _fwd, _bwd
    _kb = schema_inst iff_trans { A: pmem(u,v,K), B: (exists a1. (set(a1) & (snoc(e0,e0,u,a1) & (exists a2. (set(a2) & (snoc(a1,n1,v,a2) & elem(a2,P))))))), C: (exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,u,s) & snoc(s,i,v,p)))))))))) & elem(p,P)))) }
    _kc = implies_elim _kb, _ka4
