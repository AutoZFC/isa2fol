    _ca = schema_inst cong_and { A: pmem(u,v,Y), A2: elem(u,A), B: pmem(u,v,K), B2: (exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,u,s) & snoc(s,i,v,p)))))))))) & elem(p,P)))) }
    _cb = implies_elim _ca, _yd
    _cc = implies_elim _cb, _kd
    _cd = schema_inst iff_trans { A: pmem(u,v,G), B: (pmem(u,v,Y) & pmem(u,v,K)), C: (elem(u,A) & (exists p. (set(p) & ((exists e. (set(e) & (zero(e) & (exists i. (set(i) & (nsucc(e,i) & (exists s. (set(s) & (snoc(e,e,u,s) & snoc(s,i,v,p)))))))))) & elem(p,P))))) }
    _ce = implies_elim _cd, _ga4
    _cf = implies_elim _ce, _cc
    _cg = implies_intro _cf
    _ch = forall_intro _cg
    _ci = implies_intro _ch
    _GK = forall_intro _ci
    fix u
    _su2 = assume set(u)
    fix v
    _sv2 = assume set(v)
    fix w
    _sw2 = assume set(w)
    _hv = assume pmem(u,v,G)
    _hw = assume pmem(u,w,G)
